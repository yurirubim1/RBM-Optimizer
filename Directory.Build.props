<Project>
  <!--
    RBM Optimizer - propriedades comuns a todos os projetos.
    A saída de build (bin/obj) fica FORA da pasta do OneDrive para evitar locks de sincronização.
    Para isolar builds paralelos, passe -p:ArtifactsPath=<outro_dir>.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(ArtifactsPath)' == ''">$(LOCALAPPDATA)\RbmOptimizer.Build\artifacts</ArtifactsPath>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <Version>0.2.0</Version>
    <Company>RBM Optimizer (uso privado)</Company>
    <Product>RBM Optimizer</Product>
    <Copyright>Uso privado</Copyright>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en;pt-BR</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591;WPF0001;SYSLIB0057</NoWarn>
  </PropertyGroup>
</Project>
