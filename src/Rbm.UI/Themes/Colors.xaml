<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta RBM: grafite profundo + azul elétrico, ciano e violeta -->
    <Color x:Key="C.Bg">#FF0A0C11</Color>
    <Color x:Key="C.Sidebar">#FF0D1017</Color>
    <Color x:Key="C.Surface">#FF12161E</Color>
    <Color x:Key="C.Surface2">#FF181D27</Color>
    <Color x:Key="C.Surface3">#FF1F2532</Color>
    <Color x:Key="C.Border">#FF242B39</Color>
    <Color x:Key="C.BorderStrong">#FF323B4D</Color>
    <Color x:Key="C.Text">#FFE8ECF4</Color>
    <Color x:Key="C.TextMuted">#FF8C96AA</Color>
    <Color x:Key="C.TextFaint">#FF5D667A</Color>
    <Color x:Key="C.Accent">#FF2F7BFF</Color>
    <Color x:Key="C.AccentHover">#FF4A8DFF</Color>
    <Color x:Key="C.Cyan">#FF22D3EE</Color>
    <Color x:Key="C.Violet">#FF8B5CF6</Color>
    <Color x:Key="C.Success">#FF22C55E</Color>
    <Color x:Key="C.Warning">#FFF59E0B</Color>
    <Color x:Key="C.Danger">#FFEF4444</Color>
    <Color x:Key="C.Info">#FF38BDF8</Color>

    <SolidColorBrush x:Key="B.Bg" Color="{StaticResource C.Bg}" />
    <SolidColorBrush x:Key="B.Sidebar" Color="{StaticResource C.Sidebar}" />
    <SolidColorBrush x:Key="B.Surface" Color="{StaticResource C.Surface}" />
    <SolidColorBrush x:Key="B.Surface2" Color="{StaticResource C.Surface2}" />
    <SolidColorBrush x:Key="B.Surface3" Color="{StaticResource C.Surface3}" />
    <SolidColorBrush x:Key="B.Border" Color="{StaticResource C.Border}" />
    <SolidColorBrush x:Key="B.BorderStrong" Color="{StaticResource C.BorderStrong}" />
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="B.TextMuted" Color="{StaticResource C.TextMuted}" />
    <SolidColorBrush x:Key="B.TextFaint" Color="{StaticResource C.TextFaint}" />
    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="B.AccentHover" Color="{StaticResource C.AccentHover}" />
    <SolidColorBrush x:Key="B.AccentSoft" Color="#262F7BFF" />
    <SolidColorBrush x:Key="B.Cyan" Color="{StaticResource C.Cyan}" />
    <SolidColorBrush x:Key="B.Violet" Color="{StaticResource C.Violet}" />
    <SolidColorBrush x:Key="B.Success" Color="{StaticResource C.Success}" />
    <SolidColorBrush x:Key="B.SuccessSoft" Color="#2622C55E" />
    <SolidColorBrush x:Key="B.Warning" Color="{StaticResource C.Warning}" />
    <SolidColorBrush x:Key="B.WarningSoft" Color="#26F59E0B" />
    <SolidColorBrush x:Key="B.Danger" Color="{StaticResource C.Danger}" />
    <SolidColorBrush x:Key="B.DangerSoft" Color="#26EF4444" />
    <SolidColorBrush x:Key="B.Info" Color="{StaticResource C.Info}" />
    <SolidColorBrush x:Key="B.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="B.Pressed" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="B.Overlay" Color="#B3000000" />

    <LinearGradientBrush x:Key="B.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource C.Accent}" Offset="0" />
        <GradientStop Color="{StaticResource C.Violet}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.CyanGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource C.Cyan}" Offset="0" />
        <GradientStop Color="{StaticResource C.Accent}" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="F.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="F.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <CornerRadius x:Key="R.Card">10</CornerRadius>
    <CornerRadius x:Key="R.Control">6</CornerRadius>
</ResourceDictionary>
