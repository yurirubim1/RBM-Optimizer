<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= Tipografia ================= -->
    <Style x:Key="T.Base" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="T.H1" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="T.H2" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="T.H3" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="T.Muted" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
    </Style>
    <Style x:Key="T.Caption" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="T.Overline" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="Foreground" Value="{StaticResource B.TextFaint}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="T.Metric" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="T.Wrap" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="LineHeight" Value="19" />
    </Style>
    <Style x:Key="T.WrapMuted" TargetType="TextBlock" BasedOn="{StaticResource T.Wrap}">
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
    </Style>
    <Style x:Key="T.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ================= Cards ================= -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource R.Card}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,12,12" />
    </Style>
    <Style x:Key="CardInner" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Surface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="{StaticResource B.Surface3}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ================= Botões ================= -->
    <Style x:Key="Btn.Base" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Background" Value="{StaticResource B.Surface3}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource R.Control}" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Border x:Name="hover" Background="{StaticResource B.Hover}" CornerRadius="5" Opacity="0" Margin="-14,-7" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="hover" Property="Background" Value="{StaticResource B.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Btn.Base}" />
    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource B.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource B.DangerSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Danger}" />
        <Setter Property="Foreground" Value="#FFFCA5A5" />
    </Style>
    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
    </Style>
    <Style x:Key="Btn.Icon" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontFamily" Value="{StaticResource F.Icons}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Navegação lateral (RadioButton) -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="GroupName" Value="nav" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Height="36" Margin="8,1">
                        <Border x:Name="bg" CornerRadius="7" Background="Transparent" />
                        <Border x:Name="bar" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource B.AccentGradient}" Opacity="0" Margin="0,0,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="14,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="icon" Text="{Binding Icon}" Style="{StaticResource T.Icon}" FontSize="15" Foreground="{TemplateBinding Foreground}" Width="20" />
                            <TextBlock x:Name="label" Text="{Binding Title}" Margin="12,0,0,0" FontSize="13" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" FontFamily="{StaticResource F.Ui}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource B.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource B.AccentSoft}" />
                            <Setter TargetName="bar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                            <Setter TargetName="icon" Property="Foreground" Value="{StaticResource B.Cyan}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Switch (ToggleButton/CheckBox) -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="40" Height="22">
                            <Border x:Name="track" CornerRadius="11" Background="{StaticResource B.Surface3}" BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1" />
                            <Ellipse x:Name="knob" Width="14" Height="14" Fill="{StaticResource B.TextMuted}" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="tx" X="0" /></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="knob" Property="Fill" Value="White" />
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.14" /></Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14" /></Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource B.BorderStrong}" Background="{StaticResource B.Surface3}">
                            <TextBlock x:Name="check" Text="&#xE73E;" Style="{StaticResource T.Icon}" FontSize="11" Foreground="White" HorizontalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{StaticResource B.Accent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= TextBox ================= -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Background" Value="{StaticResource B.Surface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource B.Cyan}" />
        <Setter Property="SelectionBrush" Value="{StaticResource B.Accent}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource R.Control}">
                        <Grid>
                            <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource B.TextFaint}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value=""><Setter TargetName="ph" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= ComboBox ================= -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{StaticResource B.Surface2}" BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1" CornerRadius="{StaticResource R.Control}">
                        <TextBlock Text="&#xE70D;" Style="{StaticResource T.Icon}" FontSize="10" Foreground="{StaticResource B.TextMuted}" HorizontalAlignment="Right" Margin="0,0,10,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="12,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False" TextElement.Foreground="{StaticResource B.Text}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource B.Surface2}" BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="4">
                                <ScrollViewer><ItemsPresenter /></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Padding="{TemplateBinding Padding}" CornerRadius="5" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource B.Hover}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource B.AccentSoft}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= ScrollBar fina ================= -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="3" Background="{StaticResource B.BorderStrong}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="{StaticResource B.TextFaint}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1">
                        <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="1">
                                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= ProgressBar ================= -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource B.CyanGradient}" />
        <Setter Property="Background" Value="{StaticResource B.Surface3}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" CornerRadius="3" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
                        <Border x:Name="indet" CornerRadius="3" Background="{TemplateBinding Foreground}" Width="60" HorizontalAlignment="Left" Visibility="Collapsed">
                            <Border.RenderTransform><TranslateTransform x:Name="it" /></Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="indet" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetName="it" Storyboard.TargetProperty="X" From="-60" To="600" Duration="0:0:1.4" /></Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= ToolTip ================= -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource B.Surface3}" BorderBrush="{StaticResource B.BorderStrong}" BorderThickness="1" CornerRadius="6" Padding="10,7">
                        <ContentPresenter TextElement.Foreground="{StaticResource B.Text}" TextElement.FontSize="12">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Slider ================= -->
    <Style TargetType="Slider">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="22">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource B.Surface3}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0" /></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" /></Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb><Thumb.Template><ControlTemplate><Ellipse Width="16" Height="16" Fill="{StaticResource B.Accent}" Stroke="White" StrokeThickness="2" /></ControlTemplate></Thumb.Template></Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= DataGrid ================= -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="#08FFFFFF" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="RowHeight" Value="32" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource B.Hover}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource B.AccentSoft}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= Expander ================= -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="hdr" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="chev" Text="&#xE76C;" Style="{StaticResource T.Icon}" FontSize="10" Foreground="{StaticResource B.TextMuted}" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform><RotateTransform x:Name="rot" /></TextBlock.RenderTransform>
                                            </TextBlock>
                                            <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" TextElement.Foreground="{StaticResource B.TextMuted}" TextElement.FontSize="12.5" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="chev" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="content" Visibility="Collapsed" Margin="18,6,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True"><Setter TargetName="content" Property="Visibility" Value="Visible" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Tabs (segmentado) ================= -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" CornerRadius="6" Padding="12,6" Background="Transparent">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource B.Text}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Surface3}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" CornerRadius="9" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Componentes de UX compartilhados ================= -->
    <!-- Texto de apoio maior, para explicações em linguagem simples -->
    <Style x:Key="T.Lead" TargetType="TextBlock" BasedOn="{StaticResource T.Wrap}">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
        <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style x:Key="T.Section" TargetType="TextBlock" BasedOn="{StaticResource T.H2}">
        <Setter Property="Margin" Value="2,6,0,10" />
    </Style>

    <!-- Banner de resumo no topo de cada página: status em linguagem simples + ação principal -->
    <Style x:Key="Hero" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="22,18" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF162036" Offset="0" />
                    <GradientStop Color="#FF141826" Offset="0.55" />
                    <GradientStop Color="#FF1B1630" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Avisos coloridos (informação, atenção, problema, tudo certo) -->
    <Style x:Key="Callout" TargetType="Border">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Background" Value="{StaticResource B.AccentSoft}" />
        <Setter Property="BorderBrush" Value="#552F7BFF" />
    </Style>
    <Style x:Key="Callout.Warn" TargetType="Border" BasedOn="{StaticResource Callout}">
        <Setter Property="Background" Value="{StaticResource B.WarningSoft}" />
        <Setter Property="BorderBrush" Value="#66F59E0B" />
    </Style>
    <Style x:Key="Callout.Danger" TargetType="Border" BasedOn="{StaticResource Callout}">
        <Setter Property="Background" Value="{StaticResource B.DangerSoft}" />
        <Setter Property="BorderBrush" Value="#66EF4444" />
    </Style>
    <Style x:Key="Callout.Ok" TargetType="Border" BasedOn="{StaticResource Callout}">
        <Setter Property="Background" Value="{StaticResource B.SuccessSoft}" />
        <Setter Property="BorderBrush" Value="#6622C55E" />
    </Style>

    <!-- Chips de status -->
    <Style x:Key="Chip" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="CornerRadius" Value="11" />
    </Style>
    <Style x:Key="Chip.Ok" TargetType="Border" BasedOn="{StaticResource Chip}"><Setter Property="Background" Value="{StaticResource B.SuccessSoft}" /></Style>
    <Style x:Key="Chip.Warn" TargetType="Border" BasedOn="{StaticResource Chip}"><Setter Property="Background" Value="{StaticResource B.WarningSoft}" /></Style>
    <Style x:Key="Chip.Danger" TargetType="Border" BasedOn="{StaticResource Chip}"><Setter Property="Background" Value="{StaticResource B.DangerSoft}" /></Style>
    <Style x:Key="Chip.Info" TargetType="Border" BasedOn="{StaticResource Chip}"><Setter Property="Background" Value="{StaticResource B.AccentSoft}" /></Style>

    <!-- Estado vazio: ícone grande + texto + (opcional) botão -->
    <Style x:Key="EmptyIcon" TargetType="TextBlock" BasedOn="{StaticResource T.Icon}">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource B.TextFaint}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,10,0,10" />
    </Style>

    <!-- Área recolhível para detalhes técnicos (fechada por padrão) -->
    <Style x:Key="TechDetails" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="IsExpanded" Value="False" />
        <Setter Property="Header" Value="Detalhes técnicos" />
    </Style>

    <!-- Botão grande de ação rápida (ícone + título + descrição) -->
    <Style x:Key="Btn.Tile" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource B.Surface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
</ResourceDictionary>
