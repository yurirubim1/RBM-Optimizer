<UserControl x:Class="Rbm.UI.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:Rbm.UI.Pages.SystemPages">
    <UserControl.Resources>
        <Style x:Key="Btn.Small" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Check" TargetType="TextBlock" BasedOn="{StaticResource T.Icon}">
            <Setter Property="Text" Value="&#xE73E;" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource B.Success}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,3,10,0" />
        </Style>
        <!-- Chip de status do banner: cor conforme HeroTone (ok/warn/danger/info) -->
        <Style x:Key="ToneChip" TargetType="Border" BasedOn="{StaticResource Chip.Info}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HeroTone}" Value="ok"><Setter Property="Background" Value="{StaticResource B.SuccessSoft}" /></DataTrigger>
                <DataTrigger Binding="{Binding HeroTone}" Value="warn"><Setter Property="Background" Value="{StaticResource B.WarningSoft}" /></DataTrigger>
                <DataTrigger Binding="{Binding HeroTone}" Value="danger"><Setter Property="Background" Value="{StaticResource B.DangerSoft}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToneText" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource B.Info}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HeroTone}" Value="ok"><Setter Property="Foreground" Value="{StaticResource B.Success}" /></DataTrigger>
                <DataTrigger Binding="{Binding HeroTone}" Value="warn"><Setter Property="Foreground" Value="{StaticResource B.Warning}" /></DataTrigger>
                <DataTrigger Binding="{Binding HeroTone}" Value="danger"><Setter Property="Foreground" Value="{StaticResource B.Danger}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Uma categoria da limpeza -->
        <DataTemplate x:Key="CategoryRow" DataType="{x:Type sp:CleanupItem}">
            <Border Style="{StaticResource CardInner}" Margin="0,0,0,8" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,2,0,0"
                              ToolTip="Selecionar para limpeza" />
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <WrapPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.H3}" FontSize="13.5" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Chip}" Margin="0,0,6,0" Visibility="{Binding ShowRisk, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding RiskText}" FontSize="11" Foreground="{Binding Risk, Converter={StaticResource LevelBrush}}" />
                            </Border>
                            <Border Style="{StaticResource Chip.Warn}" Margin="0,0,6,0" Visibility="{Binding RequiresAdmin, Converter={StaticResource Vis}}"
                                    ToolTip="Executado pelo RBM Agent com permissão de administrador (o Windows pede confirmação no primeiro uso).">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA18;" Style="{StaticResource T.Icon}" FontSize="10" Foreground="{StaticResource B.Warning}" Margin="0,0,5,0" />
                                    <TextBlock Text="Pede administrador" FontSize="11" Foreground="{StaticResource B.Warning}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Chip.Danger}" Visibility="{Binding Irreversible, Converter={StaticResource Vis}}"
                                    ToolTip="Os itens não vão para a Lixeira: são apagados de vez.">
                                <TextBlock Text="Apaga de vez" FontSize="11" Foreground="{StaticResource B.Danger}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,0" />
                        <DockPanel Margin="0,5,0,0" ToolTip="O que acontece depois de limpar esta categoria">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource T.Icon}" FontSize="11" Foreground="{StaticResource B.TextFaint}" VerticalAlignment="Top" Margin="0,3,6,0" />
                            <TextBlock Text="{Binding SideEffects}" Style="{StaticResource T.WrapMuted}" FontSize="11.5" />
                        </DockPanel>
                        <TextBlock Text="{Binding Notes}" Style="{StaticResource T.Wrap}" FontSize="11.5" Foreground="{StaticResource B.TextFaint}" Margin="17,3,0,0"
                                   Visibility="{Binding Notes, Converter={StaticResource Vis}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource T.H2}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding FilesText}" Style="{StaticResource T.Caption}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource T.Caption}" HorizontalAlignment="Right" Margin="0,4,0,0"
                                   TextTrimming="None" TextWrapping="Wrap" TextAlignment="Right" Visibility="{Binding StatusText, Converter={StaticResource Vis}}" />
                        <ProgressBar IsIndeterminate="True" Width="110" HorizontalAlignment="Right" Margin="0,6,0,0"
                                     Visibility="{Binding IsWorking, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,16,20">
        <StackPanel>
            <!-- ===== Resumo (banner) ===== -->
            <Border Style="{StaticResource Hero}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource B.AccentSoft}" VerticalAlignment="Top">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource T.Icon}" FontSize="24" Foreground="{StaticResource B.Cyan}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,20,0">
                        <Border Style="{StaticResource ToneChip}">
                            <TextBlock Text="{Binding HeroChip}" Style="{StaticResource ToneText}" />
                        </Border>
                        <TextBlock Text="{Binding HeroTitle}" Style="{StaticResource T.H1}" FontSize="22" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None" />
                        <TextBlock Text="{Binding HeroText}" Style="{StaticResource T.Lead}" Margin="0,4,0,0" />
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Vis}}" MaxWidth="520" HorizontalAlignment="Left">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Small}" Content="Cancelar" Command="{Binding CancelCommand}" Margin="10,0,0,0" />
                                <TextBlock Text="{Binding RunningText}" Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ProgressBar IsIndeterminate="True" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="220">
                        <Button Style="{StaticResource Btn.Primary}" Command="{Binding CleanCommand}" Padding="18,10" FontSize="14"
                                ToolTip="Mostra um resumo do que será apagado e pede sua confirmação antes de começar.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource T.Icon}" FontSize="14" Foreground="White" Margin="0,0,10,0" />
                                <TextBlock Text="Limpar selecionados" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AnalyzeCommand}" Margin="0,8,0,0" Padding="14,8" ToolTip="Mede tamanho e quantidade de arquivos. Nada é apagado.">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE721;" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding AnalyzeLabel}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding SelectedText}" Style="{StaticResource T.Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Resultado da última limpeza -->
            <Border Style="{StaticResource Callout.Ok}" Margin="0,0,12,12" Visibility="{Binding LastResult, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource T.Icon}" FontSize="14" Foreground="{StaticResource B.Success}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding LastResult}" Style="{StaticResource T.Wrap}" />
                </DockPanel>
            </Border>

            <!-- ===== Seguro para limpar ===== -->
            <DockPanel Margin="0,4,12,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Ghost}" Padding="8,4" FontSize="12" Content="Marcar todos" Command="{Binding SelectAllCommand}" />
                    <Button Style="{StaticResource Btn.Ghost}" Padding="8,4" FontSize="12" Content="Desmarcar todos" Command="{Binding SelectNoneCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Seguro para limpar" Style="{StaticResource T.Section}" Margin="2,6,0,2" />
                    <TextBlock Text="Arquivos temporários que o Windows e os programas recriam sozinhos quando precisam." Style="{StaticResource T.Lead}" FontSize="12.5" Margin="2,0,0,10" />
                </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource Card}" Padding="12,12,12,4">
                <ItemsControl ItemsSource="{Binding SafeItems}" ItemTemplate="{StaticResource CategoryRow}" />
            </Border>

            <!-- ===== Revisar antes ===== -->
            <TextBlock Text="Revise antes de limpar" Style="{StaticResource T.Section}" Margin="2,10,0,2" />
            <TextBlock Style="{StaticResource T.Lead}" FontSize="12.5" Margin="2,0,12,10"
                       Text="Também podem ser limpos, mas têm efeitos que vale conhecer: jogos recompilam shaders na próxima abertura, a Lixeira é esvaziada de vez e alguns itens pedem permissão de administrador. Leia o efeito de cada um antes de marcar." />
            <Border Style="{StaticResource Card}" Padding="12,12,12,4">
                <ItemsControl ItemsSource="{Binding ReviewItems}" ItemTemplate="{StaticResource CategoryRow}" />
            </Border>

            <!-- ===== Garantias + histórico ===== -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Como a limpeza protege o seu PC" Style="{StaticResource T.H2}" Margin="0,0,0,10" />
                        <DockPanel Margin="0,0,0,6"><TextBlock Style="{StaticResource Check}" /><TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12.5" Text="Só toca em pastas conhecidas de temporários e caches — nada fora delas." /></DockPanel>
                        <DockPanel Margin="0,0,0,6"><TextBlock Style="{StaticResource Check}" /><TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12.5" Text="Arquivos em uso ficam onde estão; temporários recentes (menos de 24 h) também." /></DockPanel>
                        <DockPanel Margin="0,0,0,6"><TextBlock Style="{StaticResource Check}" /><TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12.5" Text="Atalhos de pasta (junções e links) nunca são seguidos nem apagados." /></DockPanel>
                        <DockPanel Margin="0,0,0,6"><TextBlock Style="{StaticResource Check}" /><TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12.5" Text="Você confirma antes de qualquer exclusão, e cada limpeza fica registrada." /></DockPanel>
                        <Expander Style="{StaticResource TechDetails}">
                            <Expander.Header><TextBlock Text="Detalhes técnicos" Foreground="{StaticResource B.TextMuted}" FontSize="12.5" /></Expander.Header>
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12" Text="• Lista fechada de pastas: nenhum caminho é digitado ou recebido de fora; a pasta-raiz de cada categoria nunca é apagada." />
                                <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,3,0,0" Text="• A análise é uma simulação (dry-run): mede tamanho e quantidade sem apagar nada." />
                                <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,3,0,0" Text="• Itens de administrador são executados pelo RBM Agent elevado (UAC). Sem o agente conectado, a análise desses itens é parcial." />
                                <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,3,0,0" Text="• Cada execução é gravada na auditoria local (ação cleanup.run)." />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Últimas limpezas" Style="{StaticResource T.H2}" />
                        <StackPanel Visibility="{Binding History.Count, Converter={StaticResource VisInv}}" Margin="0,6,0,4">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource EmptyIcon}" />
                            <TextBlock Text="Nenhuma limpeza registrada ainda" Style="{StaticResource T.H3}" HorizontalAlignment="Center" />
                            <TextBlock Text="Quando você limpar, o resultado aparece aqui." Style="{StaticResource T.Caption}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding History}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type sp:CleanupHistoryRow}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,5,0,0"
                                                 Fill="{Binding Success, Converter={StaticResource LevelBrush}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding When}" Style="{StaticResource T.Caption}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource T.Wrap}" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Não incluído ===== -->
            <Border Style="{StaticResource Callout}" Margin="0,0,12,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource T.Icon}" FontSize="14" Foreground="{StaticResource B.Info}" VerticalAlignment="Top" Margin="0,2,12,0" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Small}" VerticalAlignment="Center" Margin="12,0,0,0" Command="{Binding OpenStorageSettingsCommand}"
                            ToolTip="Abre Configurações → Sistema → Armazenamento (meio oficial do Windows).">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Abrir Armazenamento do Windows" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="Não incluído: cache de atualizações do Windows (Otimização de Entrega)" Style="{StaticResource T.H3}" TextWrapping="Wrap" TextTrimming="None" />
                        <TextBlock Text="{Binding DeliveryOptimizationNote}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
