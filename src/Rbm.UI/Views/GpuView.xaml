<UserControl x:Class="Rbm.UI.Views.GpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Rbm.UI.Controls"
             xmlns:hw="clr-namespace:Rbm.UI.Pages.Hardware">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RBMOptimizer;component/Pages/Hardware/HwResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,16,20">
        <StackPanel>
            <!-- Seletor de adaptador (apenas com mais de uma GPU física) -->
            <Border Style="{StaticResource Card}" Padding="14,10" Visibility="{Binding HasMultiple, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Placa exibida" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="Name" MinWidth="320" />
                    <TextBlock Text="Este PC tem mais de uma placa de vídeo. Adaptadores virtuais (ex.: telas remotas) não aparecem." Style="{StaticResource T.Muted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </Border>

            <!-- Estado vazio -->
            <Border Style="{StaticResource Card}" Padding="24" Visibility="{Binding HasAdapter, Converter={StaticResource VisInv}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE7F4;" Style="{StaticResource EmptyIcon}" />
                    <TextBlock Text="{Binding AdapterTitle}" Style="{StaticResource T.H2}" HorizontalAlignment="Center" />
                    <TextBlock Text="Quando o inventário do PC terminar de ser coletado, a placa de vídeo aparece aqui. Se o problema continuar, confira o driver de vídeo na página Drivers."
                               Style="{StaticResource T.Lead}" TextAlignment="Center" MaxWidth="560" Margin="0,6,0,12" />
                    <Button Content="Abrir Drivers" Style="{StaticResource Btn.Base}" HorizontalAlignment="Center" Command="{x:Static hw:HwNav.Go}" CommandParameter="drivers" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasAdapter, Converter={StaticResource Vis}}">
                <!-- ===== Resumo ===== -->
                <Border Style="{StaticResource Hero}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Content="Jogos e FPS" Style="{StaticResource Hw.HeroPrimary}" Command="{x:Static hw:HwNav.Go}" CommandParameter="gaming"
                                    ToolTip="Medir FPS e travadas nos seus jogos." />
                            <Button Content="Driver de vídeo" Style="{StaticResource Hw.HeroButton}" Command="{x:Static hw:HwNav.Go}" CommandParameter="drivers"
                                    ToolTip="Versão e atualização dos drivers." />
                        </StackPanel>
                        <ContentControl Content="{Binding Hero}" Focusable="False" />
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Callout}" Margin="0,0,12,12" Visibility="{Binding SensorMissing, Converter={StaticResource Vis}}" ToolTip="{Binding SensorReasonText}">
                    <DockPanel>
                        <TextBlock Text="&#xE946;" Style="{StaticResource T.Icon}" Foreground="{StaticResource B.Info}" FontSize="15" VerticalAlignment="Top" Margin="0,2,10,0" />
                        <StackPanel>
                            <TextBlock Text="Sensores desta placa não estão disponíveis" Style="{StaticResource T.H3}" />
                            <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12.5" Margin="0,2,0,0"
                                       Text="Temperatura, consumo e ventoinha vêm do driver da placa. Alguns modelos (principalmente integrados) não informam esses valores; o RBM nunca os estima. Uso e memória de vídeo continuam funcionando." />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <UniformGrid Columns="4">
                    <ContentControl Content="{Binding UseFact}" Focusable="False" />
                    <ContentControl Content="{Binding VramFact}" Focusable="False" />
                    <ContentControl Content="{Binding TempFact}" Focusable="False" />
                    <ContentControl Content="{Binding PowerFact}" Focusable="False" />
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <!-- ===== Engines ===== -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="O que a placa está fazendo" Style="{StaticResource T.H2}" />
                            <TextBlock Text="Cada linha é um tipo de trabalho: 3D (jogos e interface), vídeo, cópia e computação." Style="{StaticResource T.Lead}" FontSize="12.5" />
                            <ItemsControl ItemsSource="{Binding EngineLegend}" Style="{StaticResource Hw.LegendList}" />
                            <c:LineChart Height="170" Series="{Binding EngineChart}" Maximum="100" Unit="%" />
                        </StackPanel>
                    </Border>
                    <!-- ===== VRAM ===== -->
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Memória de vídeo (VRAM)" Style="{StaticResource T.H2}" />
                            <TextBlock Text="{Binding VramText}" Style="{StaticResource T.H3}" FontSize="14" Margin="0,8,0,6" />
                            <ProgressBar Maximum="100" Value="{Binding VramPct, Mode=OneWay}" Foreground="{StaticResource B.AccentGradient}" ToolTip="VRAM dedicada em uso" />
                            <ItemsControl ItemsSource="{Binding VramLegend}" Style="{StaticResource Hw.LegendList}" Margin="0,10,0,4" />
                            <c:LineChart Height="100" Series="{Binding VramChart}" LabelFormat="0.#" Unit=" G" />
                            <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,8,0,0"
                                       Text="Quando a memória da placa enche, ela passa a usar a RAM do sistema (bem mais lenta). Sintoma típico: travadinhas ao mudar de área em jogos." />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== Uso por processo ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Programas usando a placa de vídeo" Style="{StaticResource T.H2}" />
                        <TextBlock Text="{Binding ProcStatus}" ToolTip="{Binding ProcTip}" Style="{StaticResource T.Muted}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                        <DataGrid ItemsSource="{Binding Procs}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Programa" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Uso da GPU" Binding="{Binding MaxText}" SortMemberPath="MaxPct" Width="110" />
                                <DataGridTextColumn Header="Soma das atividades" Binding="{Binding SumText}" SortMemberPath="SumPct" Width="150" />
                                <DataGridTextColumn Header="Principais atividades" Binding="{Binding Engines}" Width="1.3*" />
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="64" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <!-- ===== Sensores ===== -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Sensores" Style="{StaticResource T.H2}" />
                            <TextBlock Text="Leituras reais do driver da placa. Sem leitura, o painel avisa — nunca mostra um valor estimado." Style="{StaticResource T.Lead}" FontSize="12.5" Margin="0,0,0,10" />
                            <UniformGrid Columns="2">
                                <ContentControl Content="{Binding TempPanel}" Focusable="False" />
                                <ContentControl Content="{Binding ClockPanel}" Focusable="False" />
                                <ContentControl Content="{Binding PowerPanel}" Focusable="False" />
                                <ContentControl Content="{Binding FanPanel}" Focusable="False" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <!-- ===== Sobre a placa ===== -->
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Sobre esta placa" Style="{StaticResource T.H2}" />
                            <TextBlock Text="{Binding AdapterTitle}" Style="{StaticResource T.Muted}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,8" />
                            <ItemsControl ItemsSource="{Binding Identity}" ItemTemplate="{StaticResource Hw.InfoRowCompact}" />
                            <TextBlock Text="Passe o mouse sobre cada item para ver o que significa." Style="{StaticResource T.Caption}" FontSize="11.5" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <!-- ===== HAGS / Modo de Jogo ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Reler" Command="{Binding RefreshStatesCommand}" Style="{StaticResource Hw.SmallButton}" VerticalAlignment="Top" />
                            <TextBlock Text="Recursos de jogo do Windows" Style="{StaticResource T.H2}" />
                        </DockPanel>
                        <TextBlock Text="Somente leitura. Para mudar, use os botões abaixo (abrem as Configurações do Windows)." Style="{StaticResource T.Lead}" FontSize="12.5" />
                        <Border Style="{StaticResource CardInner}" Margin="0,10,0,8" ToolTip="{Binding HagsHint}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Abrir configurações" Command="{Binding OpenGraphicsSettingsCommand}" Style="{StaticResource Hw.SmallButton}" VerticalAlignment="Center"
                                        ToolTip="Configurações › Sistema › Tela › Gráficos (alterar exige reinicialização)." />
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource T.H3}" TextWrapping="Wrap" TextTrimming="None"><Run Text="Agendamento de GPU acelerado por hardware:" /> <Run Text="{Binding HagsText, Mode=OneWay}" Foreground="{StaticResource B.Cyan}" /></TextBlock>
                                    <TextBlock Text="A própria placa organiza o trabalho de vídeo. Pode reduzir um pouco a latência em alguns jogos; em outros, não muda nada." Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource CardInner}" ToolTip="{Binding GameModeHint}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Abrir configurações" Command="{Binding OpenGameModeSettingsCommand}" Style="{StaticResource Hw.SmallButton}" VerticalAlignment="Center"
                                        ToolTip="Configurações › Jogos › Modo de Jogo." />
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource T.H3}" TextWrapping="Wrap" TextTrimming="None"><Run Text="Modo de Jogo:" /> <Run Text="{Binding GameModeText, Mode=OneWay}" Foreground="{StaticResource B.Cyan}" /></TextBlock>
                                    <TextBlock Text="Dá prioridade ao jogo aberto e evita que o Windows Update instale ou reinicie durante a partida. Recomendado deixar ativado." Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,10,0,0"
                                   Text="Ajustes reversíveis (com evidência e risco) ficam na página Otimizações." />
                    </StackPanel>
                </Border>
                <!-- ===== Ferramentas oficiais ===== -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Programa oficial do fabricante" Style="{StaticResource T.H2}" />
                        <TextBlock Text="Overclock, undervolt e curva da ventoinha ficam no programa do fabricante — o RBM não altera clocks nem tensões." Style="{StaticResource T.Lead}" FontSize="12.5" Margin="0,0,0,10" />
                        <TextBlock Text="Nenhum programa conhecido para os fabricantes de placa detectados." Style="{StaticResource T.Muted}" Visibility="{Binding HasTools, Converter={StaticResource VisInv}}" />
                        <ItemsControl ItemsSource="{Binding Tools}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type hw:VendorToolItem}">
                                    <Border Style="{StaticResource CardInner}" Margin="0,0,0,8">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Abrir" Command="{Binding OpenCommand}" Style="{StaticResource Btn.Primary}" Padding="12,5" FontSize="12"
                                                        Visibility="{Binding Installed, Converter={StaticResource Vis}}" />
                                                <Button Content="Site oficial" Command="{Binding DownloadCommand}" Style="{StaticResource Hw.SmallButton}" Margin="8,0,0,0"
                                                        ToolTip="{Binding DownloadUrl}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Style="{StaticResource T.H3}"><Run Text="{Binding Name, Mode=OneWay}" /> <Run Text=" · " Foreground="{StaticResource B.TextFaint}" /><Run Text="{Binding Status, Mode=OneWay}" Foreground="{Binding Installed, Converter={StaticResource LevelBrush}}" /></TextBlock>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Detalhes técnicos ===== -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasAdapter, Converter={StaticResource Vis}}">
                <Expander Style="{StaticResource TechDetails}" Margin="0">
                    <StackPanel Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding TechRows}" ItemTemplate="{StaticResource Hw.InfoRow}" />
                        <TextBlock Text="Registro" Style="{StaticResource T.H3}" Margin="0,10,0,4" />
                        <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12"><Run Text="HAGS:" /> <Run Text="{Binding HagsHint, Mode=OneWay}" /></TextBlock>
                        <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,0"><Run Text="Modo de Jogo:" /> <Run Text="{Binding GameModeHint, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{Binding SensorReasonText}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
