<UserControl x:Class="Rbm.UI.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Rbm.UI.ViewModels"
             xmlns:ps="clr-namespace:Rbm.UI.Pages.SystemPages"
             xmlns:dr="clr-namespace:Rbm.Drivers;assembly=Rbm.Drivers"
             xmlns:core="clr-namespace:Rbm.Core.Diagnostics;assembly=Rbm.Core">
    <UserControl.Resources>
        <Style x:Key="Drv.Link" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="Foreground" Value="{StaticResource B.Cyan}" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,6,4" />
        </Style>
        <Style x:Key="Drv.Small" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Drv.SmallDanger" TargetType="Button" BasedOn="{StaticResource Btn.Danger}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Drv.Mono" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
            <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
        <Style x:Key="Drv.Log" TargetType="Border" BasedOn="{StaticResource CardInner}">
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <!-- TechDetails define o cabeçalho como um único TextBlock compartilhado (só pode ser usado uma vez por página): aqui o cabeçalho é texto. -->
        <Style x:Key="Tech" TargetType="Expander" BasedOn="{StaticResource TechDetails}">
            <Setter Property="Header" Value="Detalhes técnicos" />
            <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <!-- Chip cuja cor segue o nível (Tag = ok | warn | danger | info) -->
        <Style x:Key="LevelChip" TargetType="Border" BasedOn="{StaticResource Chip.Info}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="ok"><Setter Property="Background" Value="{StaticResource B.SuccessSoft}" /></Trigger>
                <Trigger Property="Tag" Value="warn"><Setter Property="Background" Value="{StaticResource B.WarningSoft}" /></Trigger>
                <Trigger Property="Tag" Value="danger"><Setter Property="Background" Value="{StaticResource B.DangerSoft}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LevelChipText" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource B.Info}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="ok"><Setter Property="Foreground" Value="{StaticResource B.Success}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="warn"><Setter Property="Foreground" Value="{StaticResource B.Warning}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="danger"><Setter Property="Foreground" Value="#FFFCA5A5" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Mantém o texto legível na linha selecionada mesmo sem foco na grade -->
        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource B.Text}" /></Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="Drv.Bullet">
            <DockPanel Margin="0,2">
                <TextBlock DockPanel.Dock="Left" Text="•" Style="{StaticResource T.Muted}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding}" Style="{StaticResource T.WrapMuted}" FontSize="12" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="Drv.LogLine">
            <TextBlock Text="{Binding}" Style="{StaticResource Drv.Mono}" Foreground="{StaticResource B.TextMuted}" Margin="0,1" />
        </DataTemplate>
        <DataTemplate x:Key="Drv.InfoRow" DataType="{x:Type vm:InfoRow}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource T.Muted}" FontSize="12" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Value}" Style="{StaticResource T.Wrap}" FontSize="12.5" />
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource T.WrapMuted}" FontSize="11" Visibility="{Binding Hint, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,16,20">
        <StackPanel>
            <!-- ===== Resumo ===== -->
            <Border Style="{StaticResource Hero}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.Primary}" Command="{Binding ExportBackupCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsExporting, Converter={StaticResource Not}}"
                                ToolTip="Copia os drivers dos fabricantes para uma pasta que você escolher. Não altera nada no sistema.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="White" Margin="0,0,8,0" />
                                <TextBlock Text="Fazer backup dos drivers" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowAllDevicesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Ver todos os dispositivos" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <Border Style="{StaticResource LevelChip}" Tag="{Binding HeroLevel}">
                            <TextBlock Text="{Binding HeroChipText}" Style="{StaticResource LevelChipText}" />
                        </Border>
                        <TextBlock Text="{Binding HeroTitle}" Style="{StaticResource T.H1}" FontSize="20" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None" />
                        <TextBlock Text="{Binding HeroText}" Style="{StaticResource T.Lead}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Abas ===== -->
            <DockPanel Margin="0,0,12,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" Margin="0,0,12,0">
                        <ProgressBar IsIndeterminate="True" Width="80" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding BusyText}" Style="{StaticResource T.Caption}" />
                    </StackPanel>
                    <Button Command="{Binding RefreshCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" Style="{StaticResource Drv.Small}" ToolTip="{Binding InventoryInfo}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Atualizar" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="drvTabs" IsChecked="{Binding TabSummary}" Content="Resumo" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="drvTabs" IsChecked="{Binding TabDevices}" Content="Todos os dispositivos" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="drvTabs" IsChecked="{Binding TabBackup}" Content="Backup e instalação" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="drvTabs" IsChecked="{Binding TabStore}" Content="Versões guardadas"
                                     ToolTip="Driver Store: cópias de drivers que o Windows mantém para reinstalar ou voltar versões" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="drvTabs" IsChecked="{Binding TabHistory}" Content="Histórico" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="drvTabs" IsChecked="{Binding TabNvidia}" Content="NVIDIA e DDU" />
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- ================= RESUMO ================= -->
            <StackPanel Visibility="{Binding TabSummary, Converter={StaticResource Vis}}">
                <UniformGrid Columns="4">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="CONECTADOS" Style="{StaticResource T.Overline}" />
                            <TextBlock Text="{Binding PresentCount}" Style="{StaticResource T.Metric}" Margin="0,4,0,0" />
                            <TextBlock Text="dispositivos ligados ao PC agora" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="COM PROBLEMA" Style="{StaticResource T.Overline}" />
                            <TextBlock Text="{Binding ProblemReports.Count}" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Metric}">
                                        <Setter Property="Foreground" Value="{StaticResource B.Warning}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProblemReports.Count}" Value="0"><Setter Property="Foreground" Value="{StaticResource B.Success}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="sem driver ou com erro" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" ToolTip="Pacotes oemNN.inf de terceiros em uso">
                        <StackPanel>
                            <TextBlock Text="DRIVERS DE FABRICANTES" Style="{StaticResource T.Overline}" />
                            <TextBlock Text="{Binding ThirdPartyCount}" Style="{StaticResource T.Metric}" Margin="0,4,0,0" />
                            <TextBlock Text="não vêm com o Windows" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SEM ASSINATURA VÁLIDA" Style="{StaticResource T.Overline}" />
                            <TextBlock Text="{Binding UnsignedCount}" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Metric}">
                                        <Setter Property="Foreground" Value="{StaticResource B.Warning}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UnsignedCount}" Value="0"><Setter Property="Foreground" Value="{StaticResource B.Text}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="origem não confirmada" Style="{StaticResource T.Caption}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Dispositivos que precisam de atenção" Style="{StaticResource T.H2}" />
                            <TextBlock Text="Os links abrem só páginas oficiais dos fabricantes e o Catálogo do Microsoft Update. Nada é baixado sozinho."
                                       Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,12" />
                            <StackPanel Margin="0,8,0,12" Visibility="{Binding ProblemReports.Count, Converter={StaticResource VisInv}}">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource EmptyIcon}" Foreground="{StaticResource B.Success}" />
                                <TextBlock Text="Todos os dispositivos conectados estão funcionando" Style="{StaticResource T.H3}" HorizontalAlignment="Center" />
                                <TextBlock Text="Nenhum aparelho sem driver ou com código de erro. Não é preciso atualizar nada só por atualizar."
                                           Style="{StaticResource T.WrapMuted}" FontSize="12" TextAlignment="Center" Margin="20,4,20,0" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ProblemReports}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dr:UnknownDeviceReport}">
                                        <Border Style="{StaticResource Callout.Warn}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Ver detalhes" Style="{StaticResource Drv.Small}" VerticalAlignment="Top"
                                                            Command="{Binding DataContext.ShowDeviceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Device}" />
                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Device.Name}" Style="{StaticResource T.H3}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding SummaryPt}" Style="{StaticResource T.WrapMuted}" FontSize="12" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Device.Problem.SuggestedActionPt}" Style="{StaticResource T.Wrap}" FontSize="12" Margin="0,6,0,0"
                                                           Visibility="{Binding Device.Problem, Converter={StaticResource Vis}}" />
                                                <TextBlock Style="{StaticResource T.Caption}" Margin="0,6,0,0" Visibility="{Binding ShortId, Converter={StaticResource Vis}}">
                                                    <Run Text="ID curto:" /> <Run Text="{Binding ShortId, Mode=OneWay}" FontFamily="{StaticResource F.Mono}" />
                                                </TextBlock>
                                                <WrapPanel Margin="0,6,0,0">
                                                    <ItemsControl ItemsSource="{Binding Sources}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type dr:OfficialSource}">
                                                                <Button Content="{Binding TitlePt}" Style="{StaticResource Drv.Link}" ToolTip="{Binding Url}"
                                                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Url}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl ItemsSource="{Binding CatalogSearches}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type dr:CatalogSearchLink}">
                                                                <Button Style="{StaticResource Drv.Link}" ToolTip="{Binding Url}"
                                                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Url}">
                                                                    <TextBlock MaxWidth="320" TextTrimming="CharacterEllipsis"><Run Text="Catálogo:" /> <Run Text="{Binding Query, Mode=OneWay}" /></TextBlock>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Pontos de atenção" Style="{StaticResource T.H2}" />
                                <TextBlock Text="O que a análise dos drivers instalados encontrou (assinatura, idade, versões acumuladas)." Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,12" />
                                <Border Style="{StaticResource Callout.Ok}" Visibility="{Binding Findings.Count, Converter={StaticResource VisInv}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="{StaticResource B.Success}" Margin="0,0,8,0" />
                                        <TextBlock Text="Nada relevante encontrado." Style="{StaticResource T.Base}" />
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Findings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type core:Finding}">
                                            <Border Style="{StaticResource CardInner}" Margin="0,0,0,8" Padding="10,8">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{Binding Severity, Converter={StaticResource LevelBrush}}" Margin="0,0,10,0" />
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Severity, Converter={StaticResource Pt}}" Style="{StaticResource T.Caption}" Foreground="{Binding Severity, Converter={StaticResource LevelBrush}}" Margin="8,0,0,0" />
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource T.H3}" TextWrapping="Wrap" TextTrimming="None" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,3,0,0" />
                                                        <TextBlock Style="{StaticResource T.Wrap}" FontSize="12" Margin="0,4,0,0" Visibility="{Binding Solution, Converter={StaticResource Vis}}">
                                                            <Run Text="O que fazer:" FontWeight="SemiBold" /> <Run Text="{Binding Solution, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <Expander Margin="0,4,0,0" Visibility="{Binding Evidence.Count, Converter={StaticResource Vis}}">
                                                            <Expander.Header><TextBlock Text="Evidências" Style="{StaticResource T.Caption}" /></Expander.Header>
                                                            <ItemsControl ItemsSource="{Binding Evidence}" ItemTemplate="{StaticResource Drv.Bullet}" />
                                                        </Expander>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Callout}" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="Antes de atualizar drivers" Style="{StaticResource T.H3}" />
                                <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,8"
                                           Text="1) Faça um backup dos drivers. 2) Salve uma fotografia no Histórico para comparar depois. 3) Baixe só do site do fabricante — a versão mais nova nem sempre é a melhor." />
                                <WrapPanel>
                                    <Button Style="{StaticResource Drv.Small}" Content="Backup e instalação" Command="{Binding ShowBackupCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource Drv.Small}" Content="Histórico" Command="{Binding ShowHistoryCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <Expander Style="{StaticResource Tech}" Margin="2,0,12,12">
                    <TextBlock Text="{Binding InventoryInfo}" Style="{StaticResource T.WrapMuted}" FontSize="12" />
                </Expander>
            </StackPanel>

            <!-- ================= TODOS OS DISPOSITIVOS ================= -->
            <Grid Visibility="{Binding TabDevices, Converter={StaticResource Vis}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="380" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Procurar por nome, tipo, fabricante ou ID de hardware…" />
                            <ComboBox Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" ToolTip="Filtrar por tipo de dispositivo" />
                        </Grid>
                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox Content="Só com problema" IsChecked="{Binding FilterProblems}" Margin="0,0,16,4" />
                            <CheckBox Content="Só drivers de fabricantes" IsChecked="{Binding FilterThirdParty}" Margin="0,0,16,4" ToolTip="Drivers que não vêm com o Windows (oemNN.inf)" />
                            <CheckBox Content="Sem assinatura válida" IsChecked="{Binding FilterUnsigned}" Margin="0,0,16,4" />
                            <CheckBox Content="Mostrar desconectados" IsChecked="{Binding ShowNotPresent}" Margin="0,0,16,4" />
                            <Button Content="Limpar filtros" Command="{Binding ClearFiltersCommand}" Style="{StaticResource Drv.Link}" Margin="0,-3,12,0" />
                            <TextBlock Text="{Binding VisibleCountText}" Style="{StaticResource T.Caption}" VerticalAlignment="Center" Margin="0,0,0,4" />
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding DevicesView}" SelectedItem="{Binding SelectedDevice}" Height="560" Margin="0,8,0,0" CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Situação" Width="150" SortMemberPath="StatusText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type ps:DriverDeviceRow}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding StatusLevel, Converter={StaticResource LevelBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource T.Base}" FontSize="12" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Dispositivo" Width="2*" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type ps:DriverDeviceRow}">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontSize="12.5" ToolTip="{Binding Name}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding ClassName}" Width="110" />
                                <DataGridTextColumn Header="Driver de" Binding="{Binding Provider}" Width="*" />
                                <DataGridTextColumn Header="Versão" Binding="{Binding Version}" Width="112" />
                                <DataGridTextColumn Header="Data" Binding="{Binding DateText}" SortMemberPath="Date" Width="86" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Detalhes -->
                <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <Grid>
                        <StackPanel Margin="0,16" Visibility="{Binding HasSelection, Converter={StaticResource VisInv}}">
                            <TextBlock Text="&#xE946;" Style="{StaticResource EmptyIcon}" />
                            <TextBlock Text="Escolha um dispositivo" Style="{StaticResource T.H3}" HorizontalAlignment="Center" />
                            <TextBlock Text="Clique em um item da lista para ver se ele está funcionando, qual driver usa e onde conseguir o driver oficial."
                                       Style="{StaticResource T.WrapMuted}" FontSize="12.5" TextAlignment="Center" Margin="8,6,8,0" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding SelectedDevice.Name}" Style="{StaticResource T.H2}" TextWrapping="Wrap" TextTrimming="None" />
                            <TextBlock Text="{Binding GuidanceCategory}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />

                            <Border Style="{StaticResource Callout.Warn}" Margin="0,12,0,0" Visibility="{Binding ProblemTitle, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ProblemTitle}" Style="{StaticResource T.Wrap}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ProblemAction}" Style="{StaticResource T.Wrap}" FontSize="12" Margin="0,4,0,0" Visibility="{Binding ProblemAction, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Callout.Ok}" Margin="0,12,0,0" Visibility="{Binding SelectedIsOk, Converter={StaticResource Vis}}">
                                <DockPanel>
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="{StaticResource B.Success}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                    <TextBlock Text="Funcionando normalmente. Só troque o driver se tiver um problema específico com este dispositivo." Style="{StaticResource T.Wrap}" FontSize="12" />
                                </DockPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding DetailRows}" ItemTemplate="{StaticResource Drv.InfoRow}" Margin="0,6,0,0" />

                            <!-- Fontes oficiais -->
                            <TextBlock Text="Onde conseguir o driver oficial" Style="{StaticResource T.H3}" Margin="0,16,0,6" />
                            <ItemsControl ItemsSource="{Binding Sources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dr:OfficialSource}">
                                        <StackPanel Margin="0,0,0,4">
                                            <Button Style="{StaticResource Drv.Link}" Margin="0" ToolTip="{Binding Url}"
                                                    Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Url}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource T.Icon}" FontSize="11" Foreground="{StaticResource B.Cyan}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding TitlePt}" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="{Binding NotesPt}" Style="{StaticResource T.WrapMuted}" FontSize="11" Margin="6,0,0,0" Visibility="{Binding NotesPt, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Procurar no Catálogo do Microsoft Update" Style="{StaticResource T.Overline}" Margin="0,8,0,4" Visibility="{Binding CatalogLinks.Count, Converter={StaticResource Vis}}" />
                            <ItemsControl ItemsSource="{Binding CatalogLinks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dr:CatalogSearchLink}">
                                        <Button Style="{StaticResource Drv.Link}" ToolTip="{Binding Url}"
                                                Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Url}">
                                            <TextBlock Text="{Binding Query}" TextTrimming="CharacterEllipsis" MaxWidth="360" FontFamily="{StaticResource F.Mono}" FontSize="11.5" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding GuidanceNotes}" ItemTemplate="{StaticResource Drv.Bullet}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding NewestNotAlwaysBest}" Style="{StaticResource T.WrapMuted}" FontSize="11.5" Margin="0,8,0,0" />

                            <!-- Troca de versão -->
                            <Expander Margin="0,16,0,0">
                                <Expander.Header><TextBlock Text="Voltar ou trocar a versão do driver" Style="{StaticResource T.H3}" /></Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="Procura outras versões que o Windows já guardou no PC e que servem para este dispositivo. A troca pede permissão de administrador e afeta só este dispositivo."
                                               Style="{StaticResource T.WrapMuted}" FontSize="11.5" Margin="0,0,0,8" />
                                    <Button Content="Procurar versões compatíveis" Command="{Binding FindAlternativesCommand}" Style="{StaticResource Drv.Small}" HorizontalAlignment="Left"
                                            Visibility="{Binding CanSearchCandidates, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{Binding CandidatesUnavailableReason}" Style="{StaticResource T.WrapMuted}" FontSize="12" Visibility="{Binding CandidatesUnavailableReason, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="{Binding CandidatesStatus}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,8,0,0" Visibility="{Binding CandidatesStatus, Converter={StaticResource Vis}}" />
                                    <ItemsControl ItemsSource="{Binding Candidates}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type ps:DriverCandidateRow}">
                                                <Border BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0" Padding="0,8,0,4">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Trocar…" Style="{StaticResource Drv.SmallDanger}" VerticalAlignment="Top"
                                                                Command="{Binding DataContext.SwitchToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                        <StackPanel Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource T.H3}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Relation}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Cyan}" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.WrapMuted}" FontSize="11" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>

                            <!-- Técnico -->
                            <Expander Style="{StaticResource Tech}">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding TechRows}" ItemTemplate="{StaticResource Drv.InfoRow}" />
                                    <TextBlock Text="IDS DE HARDWARE" Style="{StaticResource T.Overline}" Margin="0,10,0,4" />
                                    <TextBlock Text="Nenhum ID de hardware informado." Style="{StaticResource T.Caption}" Visibility="{Binding HardwareIds.Count, Converter={StaticResource VisInv}}" />
                                    <ItemsControl ItemsSource="{Binding HardwareIds}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,1">
                                                    <Button DockPanel.Dock="Right" Content="&#xE8C8;" Style="{StaticResource Btn.Icon}" Padding="4" FontSize="11" ToolTip="Copiar"
                                                            Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Drv.Mono}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="IDS COMPATÍVEIS" Style="{StaticResource T.Overline}" Margin="0,10,0,4" Visibility="{Binding CompatibleIds.Count, Converter={StaticResource Vis}}" />
                                    <ItemsControl ItemsSource="{Binding CompatibleIds}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Drv.Mono}" Margin="0,1" /></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= VERSÕES GUARDADAS (DRIVER STORE) ================= -->
            <StackPanel Visibility="{Binding TabStore, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Style="{StaticResource Chip.Info}" Margin="0,0,6,0">
                                    <TextBlock Foreground="{StaticResource B.Info}" FontSize="12"><Run Text="{Binding PackageCount, Mode=OneWay}" /><Run Text=" pacotes" /></TextBlock>
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Foreground="{StaticResource B.TextMuted}" FontSize="12"><Run Text="{Binding DuplicateCount, Mode=OneWay}" /><Run Text=" com várias versões" /></TextBlock>
                                </Border>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Versões de drivers guardadas pelo Windows" Style="{StaticResource T.H2}" />
                                <TextBlock Text="O Windows mantém cópias dos drivers de fabricantes (Driver Store). As versões antigas são o que permite voltar atrás — por isso o RBM não apaga nada daqui."
                                           Style="{StaticResource T.Lead}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding StoreSummary}" Style="{StaticResource T.Caption}" Margin="0,6,0,10" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding StoreSearch, UpdateSourceTrigger=PropertyChanged}" Tag="Procurar por arquivo (oemNN.inf), nome, fabricante, tipo ou versão…" />
                            <CheckBox Grid.Column="1" Content="Só sem dispositivo conectado" IsChecked="{Binding StoreOnlyUnused}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding PackagesView}" Height="440" Margin="0,10,0,0">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Situação" Width="200" SortMemberPath="StatusText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type ps:DriverPackageRow}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding StatusLevel, Converter={StaticResource LevelBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource T.Base}" FontSize="12" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Arquivo" Binding="{Binding PublishedName}" Width="90" />
                                <DataGridTextColumn Header="Nome original" Binding="{Binding OriginalName}" Width="*" />
                                <DataGridTextColumn Header="Fabricante" Binding="{Binding Provider}" Width="*" MinWidth="120" />
                                <DataGridTextColumn Header="Tipo" Binding="{Binding ClassName}" Width="100" />
                                <DataGridTextColumn Header="Versão" Binding="{Binding Version}" Width="120" />
                                <DataGridTextColumn Header="Data" Binding="{Binding DateText}" SortMemberPath="Date" Width="86" />
                                <DataGridTextColumn Binding="{Binding Kind}" Width="70">
                                    <DataGridTextColumn.Header><TextBlock Text="Pacote" ToolTip="Base: driver principal · Extensão: complemento do fabricante" /></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Assinado por" Binding="{Binding Signer}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Drivers com mais de uma versão guardada" Style="{StaticResource T.H2}" />
                        <TextBlock Text="A primeira linha de cada grupo é a versão mais nova; “EM USO” indica a versão que algum dispositivo está usando agora."
                                   Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,10" />
                        <TextBlock Text="Nenhum driver com versões repetidas." Style="{StaticResource T.Muted}" Visibility="{Binding Duplicates.Count, Converter={StaticResource VisInv}}" />
                        <ItemsControl ItemsSource="{Binding Duplicates}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ps:DriverDuplicateRow}">
                                    <Border Style="{StaticResource CardInner}" Margin="0,0,10,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding OriginalName}" Style="{StaticResource T.H3}" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource T.Caption}" Margin="0,0,0,4" />
                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Drv.Mono}" Foreground="{StaticResource B.TextMuted}" Margin="0,1" /></DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= BACKUP E INSTALAÇÃO ================= -->
            <UniformGrid Columns="3" Visibility="{Binding TabBackup, Converter={StaticResource Vis}}" VerticalAlignment="Top">
                <!-- Backup -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="&#xE896;" Style="{StaticResource T.Icon}" FontSize="22" Foreground="{StaticResource B.Cyan}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                        <TextBlock Text="1. Fazer backup" Style="{StaticResource T.H2}" />
                        <TextBlock Text="Copia todos os drivers de fabricantes para uma pasta que você escolher. Não muda nada no sistema — é a sua garantia antes de atualizar."
                                   Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Fazer backup…" Command="{Binding ExportBackupCommand}" Style="{StaticResource Btn.Primary}" IsEnabled="{Binding IsExporting, Converter={StaticResource Not}}" />
                            <ProgressBar IsIndeterminate="True" Width="90" Margin="12,0,0,0" Visibility="{Binding IsExporting, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding BackupStatus}" Style="{StaticResource T.Wrap}" FontSize="12" Margin="0,10,0,0" Visibility="{Binding BackupStatus, Converter={StaticResource Vis}}" />
                        <Button Content="Tentar como administrador (RBM Agent)" Command="{Binding ExportViaAgentCommand}" Style="{StaticResource Drv.Small}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Visibility="{Binding OfferAgentExport, Converter={StaticResource Vis}}" IsEnabled="{Binding IsExporting, Converter={StaticResource Not}}" />
                        <Button Content="Abrir pasta do backup" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding LastBackupFolder}" Style="{StaticResource Drv.Link}" Margin="0,8,0,0"
                                Visibility="{Binding LastBackupFolder, Converter={StaticResource Vis}}" />
                        <Border Style="{StaticResource Drv.Log}" Visibility="{Binding BackupMessages.Count, Converter={StaticResource Vis}}">
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding BackupMessages}" ItemTemplate="{StaticResource Drv.LogLine}" />
                            </ScrollViewer>
                        </Border>
                        <Expander Style="{StaticResource Tech}">
                            <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="11.5"
                                       Text="Usa pnputil /export-driver para todos os pacotes de terceiros, numa subpasta datada com manifesto JSON e hashes SHA-256. Somente leitura do Driver Store." />
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Verificação -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="&#xE9D5;" Style="{StaticResource T.Icon}" FontSize="22" Foreground="{StaticResource B.Cyan}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                        <TextBlock Text="2. Conferir um backup" Style="{StaticResource T.H2}" />
                        <TextBlock Text="Confere se nenhum arquivo do backup sumiu ou foi alterado. Faça isso antes de depender dele."
                                   Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Escolher pasta e conferir…" Command="{Binding VerifyBackupCommand}" Style="{StaticResource Drv.Small}" IsEnabled="{Binding IsVerifying, Converter={StaticResource Not}}" />
                            <ProgressBar IsIndeterminate="True" Width="90" Margin="12,0,0,0" Visibility="{Binding IsVerifying, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding VerifyStatus}" Style="{StaticResource T.Wrap}" FontSize="12" Margin="0,10,0,0" Foreground="{Binding VerifyOk, Converter={StaticResource LevelBrush}}"
                                   Visibility="{Binding VerifyStatus, Converter={StaticResource Vis}}" />
                        <Border Style="{StaticResource Drv.Log}" Visibility="{Binding VerifyMessages.Count, Converter={StaticResource Vis}}">
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding VerifyMessages}" ItemTemplate="{StaticResource Drv.LogLine}" />
                            </ScrollViewer>
                        </Border>
                        <Expander Style="{StaticResource Tech}">
                            <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="11.5"
                                       Text="Confere cada arquivo contra o manifesto (SHA-256), a assinatura dos catálogos .cat e se cada INF consta no seu catálogo." />
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Instalação -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="&#xE7B8;" Style="{StaticResource T.Icon}" FontSize="22" Foreground="{StaticResource B.Cyan}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                        <TextBlock Text="3. Instalar um driver baixado" Style="{StaticResource T.H2}" />
                        <TextBlock Text="Para drivers oficiais que você já baixou e extraiu: escolha o arquivo .inf. O RBM confere a assinatura antes e só então instala (pede administrador)."
                                   Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,12" />
                        <Button Content="Escolher arquivo .inf…" Command="{Binding PickInfCommand}" Style="{StaticResource Drv.Small}" HorizontalAlignment="Left" IsEnabled="{Binding IsInstalling, Converter={StaticResource Not}}" />
                        <StackPanel Visibility="{Binding HasInstallPath, Converter={StaticResource Vis}}" Margin="0,10,0,0">
                            <TextBlock Text="{Binding InstallInfPath}" Style="{StaticResource Drv.Mono}" />
                            <TextBlock Text="{Binding InstallHeaderText}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding InstallHeaderText, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{Binding InstallSignatureText}" Style="{StaticResource T.Wrap}" FontSize="12" Margin="0,4,0,0" Foreground="{Binding InstallValid, Converter={StaticResource LevelBrush}}" />
                            <ItemsControl ItemsSource="{Binding InstallMessages}" ItemTemplate="{StaticResource Drv.Bullet}" Margin="0,6,0,0" />
                            <Border Style="{StaticResource Callout.Danger}" Margin="0,6,0,0" Visibility="{Binding InstallValid, Converter={StaticResource VisInv}}">
                                <TextBlock Text="A verificação falhou: a instalação deste arquivo está bloqueada." Style="{StaticResource T.Wrap}" FontSize="12" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding InstallValid, Converter={StaticResource Vis}}">
                                <Button Content="Instalar como administrador…" Command="{Binding InstallInfCommand}" Style="{StaticResource Btn.Danger}" IsEnabled="{Binding CanInstall}" />
                                <ProgressBar IsIndeterminate="True" Width="90" Margin="12,0,0,0" Visibility="{Binding IsInstalling, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </StackPanel>
                        <Expander Style="{StaticResource Tech}">
                            <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="11.5"
                                       Text="Validação: catálogo declarado, assinatura Authenticode confiável e hash do INF presente no catálogo. A instalação é feita pelo RBM Agent via pnputil /add-driver /install." />
                        </Expander>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ================= HISTÓRICO ================= -->
            <Border Style="{StaticResource Card}" Visibility="{Binding TabHistory, Converter={StaticResource Vis}}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Salvar fotografia agora" Command="{Binding SaveSnapshotCommand}" Style="{StaticResource Btn.Primary}" VerticalAlignment="Top"
                                IsEnabled="{Binding HasInventory}" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Fotografias dos drivers" Style="{StaticResource T.H2}" />
                            <TextBlock Text="Uma fotografia registra qual driver (e versão) cada dispositivo usa. Salve uma antes de atualizar drivers ou o Windows e compare depois para ver exatamente o que mudou."
                                       Style="{StaticResource T.Lead}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding HistoryStatus}" Style="{StaticResource T.Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Margin="0,16,0,8" Visibility="{Binding Snapshots.Count, Converter={StaticResource VisInv}}">
                        <TextBlock Text="&#xE722;" Style="{StaticResource EmptyIcon}" />
                        <TextBlock Text="Nenhuma fotografia ainda" Style="{StaticResource T.H3}" HorizontalAlignment="Center" />
                        <TextBlock Text="Salve a primeira agora; depois de uma atualização, compare com o estado atual." Style="{StaticResource T.Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                    <Grid Margin="0,14,0,0" Visibility="{Binding Snapshots.Count, Converter={StaticResource Vis}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="320" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="320" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Fotografia" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" DisplayMemberPath="Title" />
                        <TextBlock Grid.Column="2" Text="comparar com" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="12,0,10,0" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding CompareTargets}" SelectedItem="{Binding SelectedCompareTarget}" DisplayMemberPath="Title" />
                        <Button Grid.Column="4" Content="Comparar" Command="{Binding CompareSnapshotsCommand}" Style="{StaticResource Drv.Small}" Margin="12,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding DiffSummary}" Style="{StaticResource T.Wrap}" Margin="0,12,0,0" Visibility="{Binding DiffSummary, Converter={StaticResource Vis}}" />
                    <DataGrid ItemsSource="{Binding DiffRows}" Height="420" Margin="0,10,0,0" Visibility="{Binding DiffRows.Count, Converter={StaticResource Vis}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="O que mudou" Width="130" SortMemberPath="KindText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type ps:DriverChangeRow}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Level, Converter={StaticResource LevelBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding KindText}" Style="{StaticResource T.Base}" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dispositivo" Binding="{Binding DeviceName}" Width="*" />
                            <DataGridTextColumn Header="Detalhe" Binding="{Binding Description}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- ================= NVIDIA E DDU ================= -->
            <Grid Visibility="{Binding TabNvidia, Converter={StaticResource Vis}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Assistente do pacote NVIDIA" Style="{StaticResource T.H2}" />
                        <TextBlock Text="Escolha a pasta do driver NVIDIA já extraído e o RBM explica cada componente: o que é essencial, recomendado ou opcional. Use isso na “Instalação personalizada” do instalador oficial. Nada é instalado nem alterado."
                                   Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,8" />
                        <TextBlock Text="{Binding NvidiaGpuText}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Escolher pasta do pacote…" Command="{Binding AnalyzeNvidiaCommand}" Style="{StaticResource Drv.Small}" IsEnabled="{Binding IsAnalyzingNvidia, Converter={StaticResource Not}}" />
                            <Button Content="Drivers oficiais NVIDIA" Command="{Binding OpenUrlCommand}" CommandParameter="https://www.nvidia.com/pt-br/drivers/" Style="{StaticResource Drv.Link}" Margin="8,0,0,0" />
                            <ProgressBar IsIndeterminate="True" Width="90" Margin="12,0,0,0" Visibility="{Binding IsAnalyzingNvidia, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding NvidiaSummary}" Style="{StaticResource T.Wrap}" Margin="0,12,0,0" Visibility="{Binding NvidiaSummary, Converter={StaticResource Vis}}" />
                        <ItemsControl ItemsSource="{Binding NvidiaWarnings}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource T.Wrap}" FontSize="12" Foreground="{StaticResource B.Warning}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding NvidiaComponents}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type ps:NvidiaComponentRow}">
                                    <Border Style="{StaticResource CardInner}" Margin="0,0,0,8" Padding="10,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{StaticResource B.Surface3}">
                                                    <TextBlock Text="{Binding RoleText}" FontSize="11" Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.H3}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Dependencies}" Style="{StaticResource T.WrapMuted}" FontSize="11" Margin="0,2,0,0" Visibility="{Binding Dependencies, Converter={StaticResource Vis}}" />
                                            <TextBlock Style="{StaticResource T.Caption}" Margin="0,4,0,0">
                                                <Run Text="{Binding Folder, Mode=OneWay}" FontFamily="{StaticResource F.Mono}" /> <Run Text="· v" /><Run Text="{Binding Version, Mode=OneWay}" />
                                                <Run Text="·" /> <Run Text="{Binding SizeText, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding CatalogText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Recomendações" Style="{StaticResource T.H3}" Margin="0,6,0,4" Visibility="{Binding NvidiaRecommendations.Count, Converter={StaticResource Vis}}" />
                        <ItemsControl ItemsSource="{Binding NvidiaRecommendations}" ItemTemplate="{StaticResource Drv.Bullet}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Remoção completa do driver de vídeo (DDU)" Style="{StaticResource T.H2}" />
                        <TextBlock Text="O RBM nunca baixa nem executa o Display Driver Uninstaller. Abaixo: se vale a pena usar, pelos dados do seu PC, e o passo a passo seguro."
                                   Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,12" />
                        <Border Style="{StaticResource CardInner}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{Binding DduLevel, Converter={StaticResource LevelBrush}}" Margin="0,0,10,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding DduVerdict}" Style="{StaticResource T.Wrap}" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding DduReasons}" ItemTemplate="{StaticResource Drv.Bullet}" Margin="0,6,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <CheckBox Content="Tenho falhas persistentes (tela preta, erro de instalação) mesmo após instalação limpa" IsChecked="{Binding UserReportsIssues}" Margin="0,10,0,0" />
                        <Expander Margin="0,12,0,0">
                            <Expander.Header><TextBlock Text="Passo a passo e avisos" Style="{StaticResource T.H3}" /></Expander.Header>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding DduSteps}" ItemTemplate="{StaticResource Drv.Bullet}" />
                                <TextBlock Text="Avisos" Style="{StaticResource T.H3}" Margin="0,12,0,4" />
                                <ItemsControl ItemsSource="{Binding DduWarnings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource T.Icon}" FontSize="11" Foreground="{StaticResource B.Warning}" Margin="0,2,8,0" VerticalAlignment="Top" />
                                                <TextBlock Text="{Binding}" Style="{StaticResource T.WrapMuted}" FontSize="12" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Página oficial (Wagnardsoft)" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding DduOfficialPage}" Style="{StaticResource Drv.Link}" />
                            <Button Content="Download oficial do DDU" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding DduDownloadPage}" Style="{StaticResource Drv.Link}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
