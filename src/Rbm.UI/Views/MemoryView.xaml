<UserControl x:Class="Rbm.UI.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Rbm.UI.Controls"
             xmlns:hw="clr-namespace:Rbm.UI.Pages.Hardware">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RBMOptimizer;component/Pages/Hardware/HwResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,16,20">
        <StackPanel>
            <!-- ===== Resumo ===== -->
            <Border Style="{StaticResource Hero}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Content="Ver o que está usando" Style="{StaticResource Hw.HeroPrimary}" Command="{x:Static hw:HwNav.Go}" CommandParameter="processes"
                                ToolTip="Abre a página Processos, com todos os programas em execução." />
                        <Button Content="Saúde do PC" Style="{StaticResource Hw.HeroButton}" Command="{x:Static hw:HwNav.Go}" CommandParameter="diagnostics"
                                ToolTip="Diagnóstico completo, incluindo pressão de memória ao longo do tempo." />
                    </StackPanel>
                    <ContentControl Content="{Binding Hero}" Focusable="False" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Callout.Warn}" Margin="0,0,12,12" Visibility="{Binding XmpWarn, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource T.Icon}" Foreground="{StaticResource B.Warning}" FontSize="15" VerticalAlignment="Top" Margin="0,2,10,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding XmpTitle}" Style="{StaticResource T.H3}" />
                        <TextBlock Text="{Binding XmpText}" Style="{StaticResource T.WrapMuted}" FontSize="12.5" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <UniformGrid Columns="4">
                <ContentControl Content="{Binding UsedFact}" Focusable="False" />
                <ContentControl Content="{Binding AvailFact}" Focusable="False" />
                <ContentControl Content="{Binding CommitFact}" Focusable="False" />
                <ContentControl Content="{Binding FaultsFact}" Focusable="False" />
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <!-- ===== Composição ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Como a memória está dividida" Style="{StaticResource T.H2}" />
                        <TextBlock Text="Mesma divisão do Gerenciador de Tarefas. &quot;Em espera&quot; é cache útil e conta como disponível." Style="{StaticResource T.Lead}" FontSize="12.5" />
                        <hw:StackedBar Height="18" Margin="0,12,0,4" Segments="{Binding Composition}" />
                        <ItemsControl ItemsSource="{Binding CompositionLegend}" Style="{StaticResource Hw.LegendList}" />
                        <UniformGrid Columns="2" Margin="0,4,0,0">
                            <Border Style="{StaticResource Hw.Stat}" ToolTip="Memória comprometida (commit) vs. limite (RAM + arquivo de paginação). Quando chega ao limite, alocações falham mesmo com RAM 'livre'.">
                                <StackPanel>
                                    <TextBlock Text="Memória comprometida" Style="{StaticResource T.Muted}" FontSize="12" />
                                    <TextBlock Text="{Binding CommitText}" Style="{StaticResource T.H3}" Margin="0,3,0,6" />
                                    <ProgressBar Maximum="100" Value="{Binding CommitPct, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Hw.Stat}" ToolTip="Memory\Cache Bytes: working set do cache de arquivos do sistema.">
                                <StackPanel>
                                    <TextBlock Text="Cache de arquivos do sistema" Style="{StaticResource T.Muted}" FontSize="12" />
                                    <TextBlock Text="{Binding CacheText}" Style="{StaticResource T.H3}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="Últimos minutos: RAM em uso e commit (% do limite)" Style="{StaticResource T.Muted}" FontSize="12" Margin="0,8,0,0" />
                        <c:LineChart Height="100" Margin="0,4,0,0" Series="{Binding UsageChart}" Maximum="100" Unit="%" ToolTip="RAM em uso (%) e commit (% do limite)" />
                    </StackPanel>
                </Border>
                <!-- ===== Hard faults ===== -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Leituras do disco (falhas de página)" Style="{StaticResource T.H2}" />
                        <TextBlock Text="Vezes por segundo em que o Windows buscou no disco algo que não estava na RAM. Picos ao abrir programas são normais." Style="{StaticResource T.Lead}" FontSize="12.5" />
                        <ItemsControl ItemsSource="{Binding FaultsLegend}" Style="{StaticResource Hw.LegendList}" />
                        <c:LineChart Height="120" Series="{Binding FaultsChart}" LabelFormat="0" />
                        <Border Style="{StaticResource Hw.Note}">
                            <StackPanel>
                                <TextBlock Text="Por que o RBM não tem um &quot;limpador de RAM&quot;" Style="{StaticResource T.H3}" />
                                <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,3,0,0"
                                           Text="Memória em espera é cache útil, não desperdício: o Windows a entrega na hora a quem precisar. &quot;Limpadores&quot; esvaziam esse cache — o número de RAM livre sobe, mas o PC volta a ler do disco (mais travadinhas e carregamentos lentos). Se a RAM realmente falta, os sinais são commit perto do limite e leituras do disco altas e contínuas; a solução é fechar o que consome memória (veja abaixo) ou instalar mais RAM." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <!-- ===== Processos ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Programas que mais usam memória" Style="{StaticResource T.H2}" />
                        <TextBlock Text="{Binding ProcStatus}" Style="{StaticResource T.Muted}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                        <DataGrid ItemsSource="{Binding TopProcs}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Programa" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Na RAM" Binding="{Binding WsText}" SortMemberPath="WorkingSet" Width="90" />
                                <DataGridTextColumn Header="Reservada" Binding="{Binding PrivText}" SortMemberPath="PrivateBytes" Width="90" />
                                <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" SortMemberPath="CpuSort" Width="60" />
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,8,0,0"
                                   Text="Na RAM (working set) = o que o programa ocupa na memória agora. Reservada (bytes privados) = o que ele realmente consome do limite de memória." />
                    </StackPanel>
                </Border>
                <!-- ===== Vazamentos ===== -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Programas com memória sempre crescendo" Style="{StaticResource T.H2}" />
                        <TextBlock Text="Possíveis vazamentos de memória, observados enquanto esta página fica aberta." Style="{StaticResource T.Lead}" FontSize="12.5" />
                        <TextBlock Text="{Binding LeakStatus}" Style="{StaticResource T.Muted}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" />
                        <DataGrid ItemsSource="{Binding Leaks}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Programa" Binding="{Binding Name}" Width="*" MinWidth="110" />
                                <DataGridTextColumn Header="Memória reservada" Binding="{Binding PrivateText}" SortMemberPath="PrivateEnd" Width="Auto" />
                                <DataGridTextColumn Header="Ritmo" Binding="{Binding SlopeText}" SortMemberPath="SlopeMbMin" Width="Auto" />
                                <DataGridTextColumn Header="Em alta" Binding="{Binding MonoText}" SortMemberPath="Monotonicity" Width="Auto" />
                                <DataGridTemplateColumn Header="Avaliação" SortMemberPath="PossibleLeak" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Verdict}" ToolTip="{Binding Notes}" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PossibleLeak}" Value="True"><Setter Property="Foreground" Value="{StaticResource B.Warning}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Expander Style="{StaticResource TechDetails}">
                            <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12"
                                       Text="Critérios (BackgroundImpactAnalyzer): janela ≥ 2 min, ≥ 6 amostras (1 a cada ~10 s), crescimento da memória privada ≥ 50 MB, ≥ 5 MB/min e alta em ≥ 80% dos intervalos. Crescimento sozinho pode ser cache legítimo; observe por mais tempo antes de concluir. Passe o mouse sobre a avaliação para ver as notas." />
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                <!-- ===== Resumo / canais / XMP ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sua memória instalada" Style="{StaticResource T.H2}" />
                        <ItemsControl ItemsSource="{Binding Summary}" ItemTemplate="{StaticResource Hw.InfoRow}" Margin="0,8,0,0" />
                        <Grid Margin="0,5" Background="Transparent" ToolTip="Estimativa a partir dos rótulos SMBIOS (BankLabel/DeviceLocator). Nunca é chutada: quando os rótulos não permitem concluir, fica indeterminada.">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Canais (estimativa)" Style="{StaticResource T.Muted}" FontSize="12" Margin="0,1,10,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding ChannelText}" Style="{StaticResource T.H3}" />
                                <TextBlock Text="{Binding ChannelEvidence}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" TextTrimming="None" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Hw.Note}" BorderBrush="{Binding XmpBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding XmpTitle}" Style="{StaticResource T.H3}" Foreground="{Binding XmpBrush}" TextWrapping="Wrap" TextTrimming="None" />
                                <TextBlock Text="{Binding XmpText}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <!-- ===== Módulos ===== -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Pentes instalados" Style="{StaticResource T.H2}" />
                        <TextBlock Text="Nominal = velocidade padrão declarada pelo pente; configurada = velocidade em uso agora." Style="{StaticResource T.Lead}" FontSize="12.5" />
                        <DataGrid ItemsSource="{Binding Modules}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="Auto" />
                                <DataGridTextColumn Header="Fabricante" Binding="{Binding Manufacturer}" Width="Auto" />
                                <DataGridTextColumn Header="Capacidade" Binding="{Binding CapacityText}" SortMemberPath="Capacity" Width="Auto" />
                                <DataGridTextColumn Header="Configurada" Binding="{Binding ConfiguredText}" SortMemberPath="Configured" Width="Auto" />
                                <DataGridTextColumn Header="Nominal" Binding="{Binding RatedText}" SortMemberPath="Rated" Width="Auto" />
                                <DataGridTextColumn Header="Modelo (part number)" Binding="{Binding PartNumber}" Width="*" MinWidth="110" />
                                <DataGridTextColumn Header="Banco" Binding="{Binding Bank}" Width="Auto" />
                                <DataGridTextColumn Header="Formato" Binding="{Binding FormFactor}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Fonte: SMBIOS via Win32_PhysicalMemory." Style="{StaticResource T.Caption}" FontSize="11.5" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Arquivo de paginação ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Reler" Command="{Binding RefreshPageFileCommand}" Style="{StaticResource Hw.SmallButton}" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="Arquivo de paginação (memória virtual)" Style="{StaticResource T.H2}" />
                            <TextBlock Style="{StaticResource T.Muted}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap"><Run Text="Configuração:" /> <Run Text="{Binding PageFileConfig, Mode=OneWay}" Foreground="{StaticResource B.Text}" /></TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource T.Lead}" FontSize="12.5" Margin="0,6,0,0"
                               Text="Ele amplia o limite de memória e guarda dados pouco usados; não deixa o PC lento por existir. Desativá-lo não acelera nada e pode fazer programas fecharem. O tamanho gerenciado pelo sistema é a melhor escolha na maioria dos casos." />
                    <DataGrid ItemsSource="{Binding PageFiles}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Arquivo" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Tamanho alocado" Binding="{Binding AllocatedText}" SortMemberPath="AllocatedMb" Width="140" />
                            <DataGridTextColumn Header="Em uso" Binding="{Binding CurrentText}" SortMemberPath="CurrentMb" Width="110" />
                            <DataGridTextColumn Header="Pico desde que o PC ligou" Binding="{Binding PeakText}" SortMemberPath="PeakMb" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding PageFileDetail}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
