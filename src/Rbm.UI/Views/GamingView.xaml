<UserControl x:Class="Rbm.UI.Views.GamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Rbm.UI.Controls"
             xmlns:vm="clr-namespace:Rbm.UI.ViewModels"
             xmlns:pa="clr-namespace:Rbm.UI.Pages.Analysis">
    <UserControl.Resources>
        <pa:EqualsToBool x:Key="EqB" />
        <pa:EqualsToVisibility x:Key="EqV" />
        <pa:BrushKeyConverter x:Key="BK" />
        <Style x:Key="ToneChip" TargetType="Border" BasedOn="{StaticResource Chip.Info}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HeroTone}" Value="ok"><Setter Property="Background" Value="{StaticResource B.SuccessSoft}" /></DataTrigger>
                <DataTrigger Binding="{Binding HeroTone}" Value="warn"><Setter Property="Background" Value="{StaticResource B.WarningSoft}" /></DataTrigger>
                <DataTrigger Binding="{Binding HeroTone}" Value="danger"><Setter Property="Background" Value="{StaticResource B.DangerSoft}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToneText" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource B.Info}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HeroTone}" Value="ok"><Setter Property="Foreground" Value="{StaticResource B.Success}" /></DataTrigger>
                <DataTrigger Binding="{Binding HeroTone}" Value="warn"><Setter Property="Foreground" Value="{StaticResource B.Warning}" /></DataTrigger>
                <DataTrigger Binding="{Binding HeroTone}" Value="danger"><Setter Property="Foreground" Value="{StaticResource B.Danger}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Número do passo (1, 2, 3) -->
        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{StaticResource B.AccentSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource B.Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="StepNum" TargetType="TextBlock" BasedOn="{StaticResource T.H3}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        </Style>
        <Style x:Key="Tech" TargetType="Expander" BasedOn="{StaticResource TechDetails}" />
        <DataTemplate x:Key="BulletItem">
            <DockPanel Margin="0,2">
                <TextBlock DockPanel.Dock="Left" Text="•" Style="{StaticResource T.Muted}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding}" Style="{StaticResource T.WrapMuted}" FontSize="12" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="KvRow" DataType="{x:Type vm:GKv}">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,0,10,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Value}" Style="{StaticResource T.H3}" Foreground="{Binding Brush, Converter={StaticResource BK}}" ToolTip="{Binding Value}" />
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource T.WrapMuted}" FontSize="11.5" Visibility="{Binding Hint, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MetricTile" DataType="{x:Type vm:GKv}">
            <Border Style="{StaticResource CardInner}" Margin="0,0,10,0" ToolTip="{Binding Hint}">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource T.Caption}" />
                    <TextBlock Text="{Binding Value}" Style="{StaticResource T.Metric}" FontSize="24" Foreground="{Binding Brush, Converter={StaticResource BK}}" />
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource T.WrapMuted}" FontSize="11" MaxHeight="32" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,16,20">
        <StackPanel>
            <!-- ===== Banner ===== -->
            <Border Style="{StaticResource Hero}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource B.AccentSoft}" VerticalAlignment="Top">
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource T.Icon}" FontSize="24" Foreground="{StaticResource B.Violet}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,20,0">
                        <Border Style="{StaticResource ToneChip}" ToolTip="{Binding PmStatus}">
                            <TextBlock Text="{Binding HeroChip}" Style="{StaticResource ToneText}" />
                        </Border>
                        <TextBlock Text="{Binding HeroTitle}" Style="{StaticResource T.H1}" FontSize="22" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding HeroText}" Style="{StaticResource T.Lead}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="220">
                        <Button Style="{StaticResource Btn.Primary}" Padding="18,10" FontSize="14" Command="{Binding GoTabCommand}" CommandParameter="capture">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource T.Icon}" FontSize="14" Foreground="White" Margin="0,0,10,0" />
                                <TextBlock Text="Medir FPS de um jogo" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,8,0,0" Padding="14,8" Command="{Binding GoProfilesCommand}"
                                ToolTip="Perfis como Competitivo/Gaming aplicam conjuntos de ajustes com reversão — ficam na página Perfis prontos.">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="Perfis de jogo prontos" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Abas ===== -->
            <Border Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,12,12" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="gm" Content="Meus jogos" IsChecked="{Binding Tab, Converter={StaticResource EqB}, ConverterParameter=library}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="gm" Content="Medir FPS" IsChecked="{Binding Tab, Converter={StaticResource EqB}, ConverterParameter=capture}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="gm" Content="Resultados e comparação" IsChecked="{Binding Tab, Converter={StaticResource EqB}, ConverterParameter=sessions}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="gm" Content="Programas em segundo plano" IsChecked="{Binding Tab, Converter={StaticResource EqB}, ConverterParameter=system}" />
                </StackPanel>
            </Border>

            <!-- =========================================================== Meus jogos -->
            <Grid Visibility="{Binding Tab, Converter={StaticResource EqV}, ConverterParameter=library}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Btn.Icon}" Content="&#xE72C;" ToolTip="Procurar jogos novamente" Command="{Binding ScanCommand}" />
                                <Button Command="{Binding AddManualCommand}" Padding="10,5" FontSize="12" Margin="6,0,0,0" ToolTip="Adicionar um jogo que não foi encontrado, escolhendo o .exe dele">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource T.Icon}" FontSize="11" Margin="0,0,6,0" />
                                        <TextBlock Text="Adicionar jogo" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Jogos instalados" Style="{StaticResource T.H2}" />
                                <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="Buscar jogo…" Margin="0,12,0,10" />
                        <StackPanel Visibility="{Binding Games.Count, Converter={StaticResource VisInv}}" Margin="0,4,0,10">
                            <TextBlock Text="&#xE7FC;" Style="{StaticResource EmptyIcon}" />
                            <TextBlock Text="Nenhum jogo nesta lista" Style="{StaticResource T.H3}" HorizontalAlignment="Center" />
                            <TextBlock Text="Se o seu jogo não apareceu, adicione-o escolhendo o .exe." Style="{StaticResource T.Caption}" HorizontalAlignment="Center" Margin="0,2,0,10" />
                            <Button Content="Adicionar jogo" Command="{Binding AddManualCommand}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" MaxHeight="520" VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GameRow}">
                                    <Border Style="{StaticResource CardInner}" Padding="10,7">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}"><TextBlock Text="{Binding Source}" Style="{StaticResource T.Caption}" /></Border>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.H3}" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource T.Caption}" Margin="0,2,0,0">
                                                <Run Text="{Binding Exe, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ConfidenceText, Mode=OneWay}" Foreground="{Binding ConfidenceBrush, Converter={StaticResource BK}, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Expander Style="{StaticResource Tech}">
                            <Expander.Header><TextBlock Text="Lojas verificadas" Foreground="{StaticResource B.TextMuted}" FontSize="12.5" /></Expander.Header>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding ScanSummary}" ItemTemplate="{StaticResource BulletItem}" />
                                <TextBlock Text="AVISOS DA BUSCA" Style="{StaticResource T.Overline}" Margin="0,8,0,4" Visibility="{Binding ScanWarnings.Count, Converter={StaticResource Vis}}" />
                                <ItemsControl ItemsSource="{Binding ScanWarnings}" ItemTemplate="{StaticResource BulletItem}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasSelection, Converter={StaticResource VisInv}}">
                        <StackPanel Margin="0,24">
                            <TextBlock Text="&#xE8A9;" Style="{StaticResource EmptyIcon}" />
                            <TextBlock Text="Escolha um jogo na lista" Style="{StaticResource T.H2}" HorizontalAlignment="Center" />
                            <TextBlock Text="Você verá qual placa de vídeo ele usa, o histórico de medições e um atalho para medir o FPS." Style="{StaticResource T.WrapMuted}"
                                       TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource Btn.Primary}" Command="{Binding MeasureSelectedCommand}" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9D9;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="White" Margin="0,0,8,0" />
                                            <TextBlock Text="Medir FPS deste jogo" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding SelectedGame.Name}" Style="{StaticResource T.H2}" FontSize="18" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding GameInfo}" ItemTemplate="{StaticResource KvRow}" Margin="0,10,0,0" />
                                <Expander Style="{StaticResource Tech}" Visibility="{Binding GameAlternatives.Count, Converter={StaticResource Vis}}">
                                    <Expander.Header><TextBlock Text="Outros executáveis candidatos" Foreground="{StaticResource B.TextMuted}" FontSize="12.5" /></Expander.Header>
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding GameAlternatives}" ItemTemplate="{StaticResource BulletItem}" />
                                        <TextBlock Text="Se o executável detectado estiver errado, use &quot;Adicionar jogo&quot; para escolher o correto." Style="{StaticResource T.Caption}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Expander>
                                <Button HorizontalAlignment="Left" Style="{StaticResource Btn.Ghost}" Content="Remover este jogo da lista" Padding="8,4" FontSize="12" Margin="-8,8,0,0"
                                        Command="{Binding RemoveManualCommand}" Visibility="{Binding SelectedGame.IsManual, Converter={StaticResource Vis}, FallbackValue=Collapsed}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Placa de vídeo usada pelo jogo" Style="{StaticResource T.H2}" />
                                <TextBlock Text="Em PCs com duas placas (ex.: notebook), escolha “Alto desempenho” para o jogo usar a placa mais forte. Reinicie o jogo para valer." Style="{StaticResource T.Lead}" FontSize="12.5" Margin="0,2,0,10" />
                                <TextBlock Text="{Binding GpuCurrent}" Style="{StaticResource T.H3}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding GpuAvailable}">
                                    <ComboBox Width="240" ItemsSource="{Binding GpuChoices}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding GpuChoice}" />
                                    <Button Style="{StaticResource Btn.Primary}" Content="Aplicar" Margin="10,0,0,0" Command="{Binding ApplyGpuCommand}" />
                                    <Button Content="Desfazer" Margin="8,0,0,0" Command="{Binding UndoGpuCommand}" IsEnabled="{Binding CanUndoGpu}"
                                            ToolTip="Restaura o valor que existia antes da última alteração feita aqui." />
                                </StackPanel>
                                <Expander Style="{StaticResource Tech}">
                                    <Expander.Header><TextBlock Text="Detalhes técnicos" Foreground="{StaticResource B.TextMuted}" FontSize="12.5" /></Expander.Header>
                                    <TextBlock Text="Mesma opção de Configurações → Sistema → Tela → Gráficos. Gravada no registro do usuário (HKCU), sem precisar de administrador." Style="{StaticResource T.WrapMuted}" FontSize="12" />
                                </Expander>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Medições anteriores deste jogo" Style="{StaticResource T.H2}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding GameSessions.Count, Converter={StaticResource VisInv}}">
                                    <TextBlock Text="Ainda não há medições deste jogo." Style="{StaticResource T.Muted}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource Btn.Ghost}" Content="Medir agora" Padding="8,4" FontSize="12" Margin="6,0,0,0" Command="{Binding MeasureSelectedCommand}" Foreground="{StaticResource B.Accent}" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding GameSessions}" Margin="0,8,0,0" MaxHeight="300" Visibility="{Binding GameSessions.Count, Converter={StaticResource Vis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Quando" Binding="{Binding When}" Width="1.2*" />
                                        <DataGridTextColumn Header="FPS médio" Binding="{Binding Fps}" Width="80" />
                                        <DataGridTextColumn Header="Piores momentos" Binding="{Binding Lows}" Width="*" />
                                        <DataGridTextColumn Header="Travadas" Binding="{Binding Stutters}" Width="100" />
                                        <DataGridTextColumn Header="Limite" Binding="{Binding Bound}" Width="*" />
                                        <DataGridTextColumn Header="Condições" Binding="{Binding Conditions}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- =========================================================== Medir FPS (passo a passo) -->
            <Grid Visibility="{Binding Tab, Converter={StaticResource EqV}, ConverterParameter=capture}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" VerticalAlignment="Top" Padding="20,18">
                    <StackPanel>
                        <!-- Passo 1 -->
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource StepBadge}"><TextBlock Text="1" Style="{StaticResource StepNum}" /></Border>
                            <StackPanel IsEnabled="{Binding IsCapturing, Converter={StaticResource Not}}">
                                <TextBlock Text="Escolha o jogo" Style="{StaticResource T.H2}" />
                                <TextBlock Text="Abra o jogo e vá até a cena que você quer medir." Style="{StaticResource T.Lead}" FontSize="12.5" Margin="0,2,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Jogo da lista" Style="{StaticResource T.Caption}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" DisplayMemberPath="Name" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="ou o nome do processo" Style="{StaticResource T.Caption}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" Tag="ex.: jogo.exe" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </DockPanel>

                        <Border Height="1" Background="{StaticResource B.Border}" Margin="42,16,0,16" />

                        <!-- Passo 2 -->
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource StepBadge}"><TextBlock Text="2" Style="{StaticResource StepNum}" /></Border>
                            <StackPanel>
                                <TextBlock Text="Prepare o medidor de FPS (PresentMon)" Style="{StaticResource T.H2}" />
                                <TextBlock Text="Ferramenta oficial e gratuita da Intel. Ela só observa o Windows — nada é injetado no jogo (seguro para anti-cheat)." Style="{StaticResource T.Lead}" FontSize="12.5" Margin="0,2,0,8" />
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding PmBrush, Converter={StaticResource BK}}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PmStatus}" Style="{StaticResource T.H3}" Foreground="{Binding PmBrush, Converter={StaticResource BK}}" />
                                </DockPanel>
                                <WrapPanel Margin="0,10,0,0" Visibility="{Binding PmReady, Converter={StaticResource VisInv}}">
                                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding DownloadPresentMonCommand}" IsEnabled="{Binding IsDownloading, Converter={StaticResource Not}}" Margin="0,0,8,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE896;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="White" Margin="0,0,8,0" />
                                            <TextBlock Text="Baixar e verificar" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <ProgressBar Maximum="1" Value="{Binding DownloadProgress, Mode=OneWay}" Margin="0,6,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource Vis}}" />
                                <Expander Style="{StaticResource Tech}">
                                    <Expander.Header><TextBlock Text="Detalhes técnicos e outras opções" Foreground="{StaticResource B.TextMuted}" FontSize="12.5" /></Expander.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding PmDetail}" Style="{StaticResource T.WrapMuted}" FontSize="11.5" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="Baixar novamente" Command="{Binding DownloadPresentMonCommand}" IsEnabled="{Binding IsDownloading, Converter={StaticResource Not}}" Margin="0,0,8,6"
                                                    Visibility="{Binding PmReady, Converter={StaticResource Vis}}" />
                                            <Button Content="Escolher executável…" Command="{Binding ChoosePresentMonCommand}" Margin="0,0,8,6" />
                                            <Button Content="Verificar novamente" Command="{Binding RecheckPresentMonCommand}" Margin="0,0,8,6" />
                                        </WrapPanel>
                                        <TextBlock Text="PERMISSÃO DE CAPTURA" Style="{StaticResource T.Overline}" Margin="0,8,0,4" />
                                        <TextBlock Text="{Binding CapabilityText}" Style="{StaticResource T.Wrap}" FontSize="12" />
                                        <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="11.5" Margin="0,6,0,0"
                                                   Text="Sem essa permissão, a captura usa o agente elevado do RBM Optimizer (o Windows pede confirmação no primeiro uso)." Visibility="{Binding CanCaptureUnelevated, Converter={StaticResource VisInv}}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </DockPanel>

                        <Border Height="1" Background="{StaticResource B.Border}" Margin="42,16,0,16" />

                        <!-- Passo 3 -->
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Style="{StaticResource StepBadge}"><TextBlock Text="3" Style="{StaticResource StepNum}" /></Border>
                            <StackPanel>
                                <TextBlock Text="Meça enquanto joga" Style="{StaticResource T.H2}" />
                                <TextBlock Text="Clique em Iniciar e continue jogando normalmente. O resultado aparece em “Resultados e comparação”." Style="{StaticResource T.Lead}" FontSize="12.5" Margin="0,2,0,10" />
                                <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsCapturing, Converter={StaticResource Not}}">
                                    <TextBlock Text="Duração" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ComboBox Width="100" ItemsSource="{Binding CaptureDurations}" SelectedItem="{Binding CaptureSeconds}" ItemStringFormat="{}{0} s" />
                                    <TextBlock Text="segundos" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                                <Expander Style="{StaticResource Tech}" IsEnabled="{Binding IsCapturing, Converter={StaticResource Not}}">
                                    <Expander.Header><TextBlock Text="Anotações para comparar depois (opcional)" Foreground="{StaticResource B.TextMuted}" FontSize="12.5" /></Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Resolução" Style="{StaticResource T.Caption}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding Resolution, UpdateSourceTrigger=PropertyChanged}" Tag="ex.: 1920x1080" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Configurações gráficas" Style="{StaticResource T.Caption}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding SettingsLabel, UpdateSourceTrigger=PropertyChanged}" Tag="ex.: Alto, FSR Qualidade" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                            <TextBlock Text="Cena / trecho do jogo" Style="{StaticResource T.Caption}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding Scenario, UpdateSourceTrigger=PropertyChanged}" Tag="ex.: benchmark interno, mapa X rota Y" />
                                        </StackPanel>
                                    </Grid>
                                </Expander>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Style="{StaticResource Btn.Primary}" Padding="18,9" Command="{Binding StartCaptureCommand}" IsEnabled="{Binding IsCapturing, Converter={StaticResource Not}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="White" Margin="0,0,8,0" />
                                            <TextBlock Text="Iniciar medição" />
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="8,0,0,0" Content="Cancelar" Command="{Binding CancelCaptureCommand}" Visibility="{Binding IsCapturing, Converter={StaticResource Vis}}" />
                                </StackPanel>
                                <TextBlock Text="Prepare o medidor no passo 2 para habilitar a medição." Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Warning}" Margin="0,8,0,0"
                                           Visibility="{Binding PmReady, Converter={StaticResource VisInv}}" />
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsCapturing, Converter={StaticResource Vis}}">
                                    <ProgressBar Maximum="1" Value="{Binding CaptureProgress, Mode=OneWay}" />
                                    <TextBlock Text="{Binding CaptureStatus}" Style="{StaticResource T.Caption}" Margin="0,6,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Dicas para uma medição confiável" Style="{StaticResource T.H2}" Margin="0,0,0,10" />
                        <DockPanel Margin="0,0,0,8"><TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="{StaticResource B.Success}" VerticalAlignment="Top" Margin="0,3,10,0" />
                            <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12.5" Text="Meça sempre a mesma cena, com as mesmas configurações gráficas." /></DockPanel>
                        <DockPanel Margin="0,0,0,8"><TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="{StaticResource B.Success}" VerticalAlignment="Top" Margin="0,3,10,0" />
                            <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12.5" Text="Use pelo menos 20 s — sessões mais curtas não podem ser comparadas (60 s é um bom padrão)." /></DockPanel>
                        <DockPanel Margin="0,0,0,8"><TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="{StaticResource B.Success}" VerticalAlignment="Top" Margin="0,3,10,0" />
                            <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12.5" Text="Faça uma medição antes e outra depois de mudar algo (driver, ajuste, perfil) e compare em “Resultados”." /></DockPanel>
                        <DockPanel><TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="{StaticResource B.Success}" VerticalAlignment="Top" Margin="0,3,10,0" />
                            <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12.5" Text="O jogo precisa estar aberto e em primeiro plano durante a medição." /></DockPanel>
                        <Expander Style="{StaticResource Tech}">
                            <Expander.Header><TextBlock Text="O que mais é registrado" Foreground="{StaticResource B.TextMuted}" FontSize="12.5" /></Expander.Header>
                            <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12"
                                       Text="Durante a captura o RBM Optimizer guarda a telemetria do sistema (CPU, GPU, VRAM, disco, DPC…) para relacionar com as travadas. Plano de energia e ajustes ativos são registrados automaticamente." />
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- =========================================================== Resultados -->
            <StackPanel Visibility="{Binding Tab, Converter={StaticResource EqV}, ConverterParameter=sessions}">
                <!-- Estado vazio -->
                <Border Style="{StaticResource Card}" Visibility="{Binding SavedSessions.Count, Converter={StaticResource VisInv}}">
                    <StackPanel Margin="0,20">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource EmptyIcon}" />
                        <TextBlock Text="Nenhuma medição ainda" Style="{StaticResource T.H2}" HorizontalAlignment="Center" />
                        <TextBlock Text="Meça o FPS de um jogo para ver aqui a média, os piores momentos e as travadas." Style="{StaticResource T.WrapMuted}" HorizontalAlignment="Center" Margin="0,4,0,12" />
                        <Button Style="{StaticResource Btn.Primary}" Content="Medir FPS de um jogo" HorizontalAlignment="Center" Command="{Binding GoTabCommand}" CommandParameter="capture" />
                    </StackPanel>
                </Border>

                <!-- ===== Sessão aberta: resumo simples primeiro ===== -->
                <StackPanel Visibility="{Binding HasSession, Converter={StaticResource Vis}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding SessionGame}" Style="{StaticResource T.Caption}" ToolTip="{Binding SessionTitle}" />
                            <TextBlock Text="{Binding SessionHeadline}" Style="{StaticResource T.H1}" Foreground="{StaticResource B.Cyan}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SessionPlain}" Style="{StaticResource T.Lead}" Margin="0,4,0,0" />
                            <ItemsControl ItemsSource="{Binding SessionMetrics}" ItemTemplate="{StaticResource MetricTile}" Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Expander Style="{StaticResource Tech}">
                                <Expander.Header><TextBlock Text="O que significa cada número" Foreground="{StaticResource B.TextMuted}" FontSize="12.5" /></Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="{Binding MetricDefinitions}" Style="{StaticResource T.WrapMuted}" FontSize="11.5" />
                                    <TextBlock Text="{Binding SessionTitle}" Style="{StaticResource T.Caption}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Lista + comparação ===== -->
                <Grid Visibility="{Binding SavedSessions.Count, Converter={StaticResource Vis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="Medições salvas" Style="{StaticResource T.H2}" />
                                <TextBlock Text="Clique numa medição para ver os detalhes." Style="{StaticResource T.Caption}" Margin="0,2,0,8" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding SavedSessions}" SelectedItem="{Binding SelectedSession}" MaxHeight="300">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GameSessionItem}">
                                        <Border Style="{StaticResource CardInner}" Padding="10,6">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource Btn.Icon}" Content="&#xE74D;" ToolTip="Excluir medição"
                                                        Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding Display}" Style="{StaticResource T.Base}" FontSize="12" VerticalAlignment="Center" ToolTip="{Binding Display}" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Comparar antes × depois" Style="{StaticResource T.H2}" />
                            <TextBlock Style="{StaticResource T.Lead}" FontSize="12.5" Margin="0,2,0,10"
                                       Text="Escolha uma medição de antes e outra de depois de uma mudança. O RBM diz se a diferença é real ou só variação normal." />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Antes" Style="{StaticResource T.Caption}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding SavedSessions}" SelectedItem="{Binding BeforeSession}" DisplayMemberPath="Display" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Depois" Style="{StaticResource T.Caption}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding SavedSessions}" SelectedItem="{Binding AfterSession}" DisplayMemberPath="Display" />
                                </StackPanel>
                            </Grid>
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource Btn.Primary}" Content="Comparar" Command="{Binding CompareSessionsCommand}" Margin="10,0,0,0" />
                                <CheckBox IsChecked="{Binding SettingsChanged}" VerticalAlignment="Center">
                                    <TextBlock Text="Mudei resolução, gráficos ou cena entre as duas" Style="{StaticResource T.Base}" FontSize="12" TextWrapping="Wrap" />
                                </CheckBox>
                            </DockPanel>
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding HasComparison, Converter={StaticResource Vis}}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="5" CornerRadius="2" Background="{Binding CompareBrush, Converter={StaticResource BK}}" Margin="0,0,12,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding CompareHeadline}" Style="{StaticResource T.H2}" Foreground="{Binding CompareBrush, Converter={StaticResource BK}}" TextWrapping="Wrap" TextTrimming="None" />
                                        <TextBlock Text="{Binding CompareVerdict}" Style="{StaticResource T.Wrap}" FontSize="12.5" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding CompareDeltas}" Margin="0,10,0,0" Visibility="{Binding CompareDeltas.Count, Converter={StaticResource Vis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Métrica" Binding="{Binding Name}" Width="1.6*" />
                                        <DataGridTextColumn Header="Antes" Binding="{Binding Before}" Width="*" />
                                        <DataGridTextColumn Header="Depois" Binding="{Binding After}" Width="*" />
                                        <DataGridTemplateColumn Header="Diferença" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Delta}" FontWeight="SemiBold" Foreground="{Binding Brush, Converter={StaticResource BK}}" /></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ItemsControl ItemsSource="{Binding CompareCaveats}" ItemTemplate="{StaticResource BulletItem}" Margin="0,8,0,0" />
                            </StackPanel>
                            <Expander Style="{StaticResource Tech}">
                                <Expander.Header><TextBlock Text="Como a comparação decide" Foreground="{StaticResource B.TextMuted}" FontSize="12.5" /></Expander.Header>
                                <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12"
                                           Text="Teste de Welch sobre o FPS por segundo (p &lt; 0,05 e diferença ≥ 2%). Recusa sessões com menos de 20 s ou com resolução/configurações diferentes. A mais antiga é sempre o &quot;antes&quot;. A coluna Diferença é descritiva." />
                            </Expander>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== Detalhes da sessão aberta ===== -->
                <StackPanel Visibility="{Binding HasSession, Converter={StaticResource Vis}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Tempo entre quadros (frametime)" Style="{StaticResource T.H2}" />
                                <TextBlock Text="Linha baixa e estável = jogo fluido. Cada pico para cima é uma travada que você pode ter sentido." Style="{StaticResource T.Caption}" Margin="0,2,0,8" TextWrapping="Wrap" />
                                <c:LineChart Height="200" Series="{Binding FrameTimeSeries}" Capacity="{Binding FrameTimeCapacity}" Unit=" ms" LabelFormat="0.#" />
                                <TextBlock Text="FPS a cada segundo" Style="{StaticResource T.Caption}" Margin="0,12,0,4" />
                                <c:LineChart Height="110" Series="{Binding FpsSeries}" Capacity="{Binding FpsCapacity}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="O que limitou o FPS" Style="{StaticResource T.H2}" />
                                <TextBlock Text="{Binding BoundLabel}" Style="{StaticResource T.H2}" FontSize="18" Foreground="{Binding BoundBrush, Converter={StaticResource BK}}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None" />
                                <TextBlock Text="{Binding BoundExplanation}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding BoundDetail}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="Distribuição do frametime" Style="{StaticResource T.H3}" Margin="0,16,0,0" />
                                <TextBlock Text="Quantos quadros caíram em cada faixa (ms)." Style="{StaticResource T.Caption}" Margin="0,2,0,8" />
                                <c:BarChart Height="150" Values="{Binding HistogramValues}" Labels="{Binding HistogramLabels}" Fill="{StaticResource B.AccentGradient}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Travadas (stutters) e o que acontecia no PC" Style="{StaticResource T.H2}" />
                            <TextBlock Text="{Binding StutterSummary}" Style="{StaticResource T.H3}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding CorrelationSummary}" Style="{StaticResource T.Wrap}" FontSize="12.5" Margin="0,6,0,0" />
                            <ItemsControl ItemsSource="{Binding Associations}" Margin="0,8,0,0" Visibility="{Binding HasCorrelation, Converter={StaticResource Vis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AssociationRow}">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="60" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Base}" FontSize="12" Foreground="{Binding Brush, Converter={StaticResource BK}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Lift}" Style="{StaticResource T.H3}" FontSize="12" ToolTip="Quantas vezes mais frequente nas janelas com travada do que nas demais" />
                                            <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource T.WrapMuted}" FontSize="11.5" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding ClusterNotes}" ItemTemplate="{StaticResource BulletItem}" Margin="0,6,0,0" />
                            <Border Style="{StaticResource Callout.Warn}" Margin="0,10,0,0">
                                <TextBlock Text="{Binding CorrelationDisclaimer}" Style="{StaticResource T.Wrap}" FontSize="11.5" />
                            </Border>
                            <Expander Style="{StaticResource Tech}" Margin="0,2,0,0">
                                <Expander.Header><TextBlock Text="Lista das travadas mais longas" Foreground="{StaticResource B.TextMuted}" FontSize="12.5" /></Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="{Binding StutterDefinition}" Style="{StaticResource T.WrapMuted}" FontSize="11.5" Margin="0,0,0,8" />
                                    <DataGrid ItemsSource="{Binding Stutters}" MaxHeight="260" Visibility="{Binding Stutters.Count, Converter={StaticResource Vis}}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Momento" Binding="{Binding Time}" Width="*" />
                                            <DataGridTextColumn Header="Frametime" Binding="{Binding FrameTime}" Width="*" />
                                            <DataGridTextColumn Header="Mediana anterior" Binding="{Binding Baseline}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Como os quadros chegaram à tela" Style="{StaticResource T.H2}" />
                            <TextBlock Text="{Binding TearingText}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,0" />
                            <Expander Style="{StaticResource Tech}">
                                <Expander.Header><TextBlock Text="Modo de apresentação (flip, V-Sync e afins)" Foreground="{StaticResource B.TextMuted}" FontSize="12.5" /></Expander.Header>
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding PresentModes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PresentModeRow}">
                                                <StackPanel Margin="0,0,0,6">
                                                    <TextBlock Style="{StaticResource T.H3}">
                                                        <Run Text="{Binding Mode, Mode=OneWay}" Foreground="{Binding Brush, Converter={StaticResource BK}, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Percent, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Impact}" Style="{StaticResource T.WrapMuted}" FontSize="11.5" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding PresentModeText}" Style="{StaticResource T.WrapMuted}" FontSize="11.5" Margin="0,4,0,0" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding SessionWarnings.Count, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="Observações" Style="{StaticResource T.H3}" />
                            <ItemsControl ItemsSource="{Binding SessionWarnings}" ItemTemplate="{StaticResource BulletItem}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- =========================================================== Programas em segundo plano -->
            <Grid Visibility="{Binding Tab, Converter={StaticResource EqV}, ConverterParameter=system}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Atualizar" Command="{Binding RefreshSystemCommand}" Padding="10,5" FontSize="12" />
                            <StackPanel>
                                <TextBlock Text="Overlays, gravadores e monitores abertos agora" Style="{StaticResource T.H2}" />
                                <TextBlock Text="Programas que desenham por cima do jogo ou gravam a tela podem custar alguns FPS ou causar travadas." Style="{StaticResource T.Lead}" FontSize="12.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource Callout.Ok}" Margin="0,12,0,0" Visibility="{Binding Overlays.Count, Converter={StaticResource VisInv}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="{StaticResource B.Success}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding OverlayStatus}" Style="{StaticResource T.Wrap}" />
                            </DockPanel>
                        </Border>
                        <TextBlock Text="{Binding OverlayStatus}" Style="{StaticResource T.H3}" Margin="0,12,0,8" Visibility="{Binding Overlays.Count, Converter={StaticResource Vis}}" />
                        <ItemsControl ItemsSource="{Binding Overlays}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:OverlayRow}">
                                    <Border Style="{StaticResource CardInner}" Margin="0,0,0,8" Padding="12,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}"><TextBlock Text="{Binding Category}" Style="{StaticResource T.Caption}" /></Border>
                                                <TextBlock Style="{StaticResource T.H3}">
                                                    <Run Text="{Binding Product, Mode=OneWay}" /><Run Text="  ·  " Foreground="{StaticResource B.TextFaint}" /><Run Text="{Binding Process, Mode=OneWay}" Foreground="{StaticResource B.TextMuted}" />
                                                </TextBlock>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Impact}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Test}" Style="{StaticResource T.Wrap}" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource B.Cyan}" />
                                            <TextBlock Text="{Binding Confidence, StringFormat=Confiança da nota: {0}}" Style="{StaticResource T.Caption}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Expander Style="{StaticResource Tech}">
                            <Expander.Header><TextBlock Text="Como a detecção funciona" Foreground="{StaticResource B.TextMuted}" FontSize="12.5" /></Expander.Header>
                            <TextBlock Text="{Binding OverlayDisclaimer}" Style="{StaticResource T.WrapMuted}" FontSize="11.5" />
                        </Expander>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Gravação do Xbox Game Bar (Game DVR)" Style="{StaticResource T.H2}" TextWrapping="Wrap" TextTrimming="None" />
                        <TextBlock Text="{Binding DvrText}" Style="{StaticResource T.Lead}" FontSize="12.5" Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding DvrValues}" ItemTemplate="{StaticResource KvRow}" />
                        <TextBlock Text="Somente leitura. Para mudar, use Otimizações (com opção de desfazer)." Style="{StaticResource T.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
