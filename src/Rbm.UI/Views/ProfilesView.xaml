<UserControl x:Class="Rbm.UI.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Rbm.UI.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="CardTpl" DataType="{x:Type vm:ProfileCard}">
            <Border Background="{StaticResource B.Surface}" CornerRadius="9" Padding="14,12">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip.Ok}" Visibility="{Binding Badge, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource B.Success}" />
                        </Border>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.H3}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource T.Caption}" Margin="0,6,0,0" Visibility="{Binding CountText, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="ActionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WillChange}" Value="True"><Setter Property="Foreground" Value="{StaticResource B.Cyan}" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,0,28,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" Style="{StaticResource Hero}" Margin="0,0,0,12" Padding="20,14">
            <StackPanel>
                <TextBlock Text="Otimize com um clique — e veja tudo antes" Style="{StaticResource T.H2}" FontSize="18" />
                <TextBlock Style="{StaticResource T.Lead}" Margin="0,4,0,0" MaxWidth="900" HorizontalAlignment="Left"
                           Text="Cada perfil é um conjunto de ajustes com benefício comprovado ou provável. Escolha um, revise o que vai mudar no seu PC e confirme. Não sabe qual usar? Comece pela Otimização Segura. Tudo pode ser desfeito no Histórico." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
            <StackPanel>
                <TextBlock Text="PARA O DIA A DIA" Style="{StaticResource T.Overline}" Margin="2,0,0,8" />
                <ListBox ItemsSource="{Binding SystemProfiles}" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource CardTpl}" />
                <TextBlock Text="PARA JOGOS" Style="{StaticResource T.Overline}" Margin="2,10,0,8" />
                <ListBox ItemsSource="{Binding GamingProfiles}" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource CardTpl}" />
                <Border Style="{StaticResource Callout}" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource T.Wrap}" FontSize="12"
                                   Text="Ajustes experimentais nunca entram em perfis. Se quiser testá-los, use o Laboratório em Otimizações, um de cada vez." />
                        <Button Content="Abrir Otimizações" Command="{Binding OpenOptimizationsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,5" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Salvar minha seleção" Margin="0,0,8,0" Command="{Binding SaveCustomCommand}" Visibility="{Binding IsCustom, Converter={StaticResource Vis}}" />
                            <Button Content="Aplicar este perfil" Style="{StaticResource Btn.Primary}" Command="{Binding ApplyCommand}" Padding="16,7"
                                    Visibility="{Binding Selected, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Selected.Name, TargetNullValue=O que vai mudar}" Style="{StaticResource T.H2}" />
                            <TextBlock Text="{Binding Selected.Description}" Style="{StaticResource T.WrapMuted}" FontSize="12.5" Margin="0,4,12,0" Visibility="{Binding Selected, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Style="{StaticResource Callout}" Margin="0,12,0,0">
                        <TextBlock Text="{Binding DiffSummary}" Style="{StaticResource T.Wrap}" FontSize="12.5" />
                    </Border>
                    <Border Style="{StaticResource Callout.Warn}" Margin="0,0,0,0" Visibility="{Binding ConditionWarning, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding ConditionWarning}" Style="{StaticResource T.Wrap}" FontSize="12.5" />
                    </Border>
                </StackPanel>
                <Grid Margin="0,8,0,0">
                    <DataGrid ItemsSource="{Binding Diff}" IsReadOnly="False" RowHeight="36">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Rationale}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Incluir" Binding="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                            <DataGridTextColumn Header="Ajuste" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Agora" Binding="{Binding Current}" Width="1.3*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Depois" Binding="{Binding OptionLabel}" Width="1.3*" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="O que acontece" Width="1.4*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Action}" Style="{StaticResource ActionText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Action}" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel VerticalAlignment="Center" Visibility="{Binding Selected, Converter={StaticResource VisInv}}">
                        <TextBlock Text="&#xE8F1;" Style="{StaticResource EmptyIcon}" />
                        <TextBlock Text="Escolha um perfil para ver a prévia." Style="{StaticResource T.Lead}" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
