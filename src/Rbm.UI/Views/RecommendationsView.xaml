<UserControl x:Class="Rbm.UI.Views.RecommendationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Rbm.UI.ViewModels">
    <UserControl.Resources>
        <Style x:Key="StepIcon" TargetType="TextBlock" BasedOn="{StaticResource T.Icon}">
            <Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{StaticResource B.TextFaint}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="running"><Setter Property="Foreground" Value="{StaticResource B.Cyan}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="ok"><Setter Property="Foreground" Value="{StaticResource B.Success}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="warn"><Setter Property="Foreground" Value="{StaticResource B.Warning}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="fail"><Setter Property="Foreground" Value="{StaticResource B.Danger}" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,16,20">
        <StackPanel>
            <Border Style="{StaticResource Hero}">
                <StackPanel>
                    <TextBlock Text="Escolha o quanto quer otimizar" Style="{StaticResource T.H1}" FontSize="21" />
                    <TextBlock Style="{StaticResource T.Lead}" Margin="0,4,0,0" MaxWidth="900" HorizontalAlignment="Left"
                               Text="Cada nível junta limpeza e ajustes com benefício comprovado. Você vê exatamente o que muda no seu PC antes de confirmar, e tudo pode ser desfeito depois." />
                </StackPanel>
            </Border>

            <!-- Níveis -->
            <ItemsControl ItemsSource="{Binding Levels}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LevelCard}">
                        <Button Margin="0,0,12,12" Cursor="Hand" FocusVisualStyle="{x:Null}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="card" CornerRadius="12" Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Border}" BorderThickness="2" Padding="20,18">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="{StaticResource B.BorderStrong}" /></Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                                            <Setter TargetName="card" Property="Background" Value="#162F7BFF" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Chip.Ok}" VerticalAlignment="Top" Visibility="{Binding Badge, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource B.Success}" />
                                    </Border>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource B.AccentSoft}" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource T.Icon}" Foreground="{StaticResource B.Cyan}" FontSize="18" HorizontalAlignment="Center" />
                                    </Border>
                                </DockPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource T.H1}" FontSize="22" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding Tagline}" Style="{StaticResource T.Lead}" Margin="0,4,0,0" />
                                <TextBlock Text="O QUE FAZ" Style="{StaticResource T.Overline}" Margin="0,14,0,6" />
                                <ItemsControl ItemsSource="{Binding Does}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <TextBlock Text="&#xE73E;" Style="{StaticResource T.Icon}" FontSize="11" Foreground="{StaticResource B.Success}" VerticalAlignment="Top" Margin="0,3,8,0" />
                                                <TextBlock Text="{Binding}" Style="{StaticResource T.Wrap}" FontSize="12.5" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Height="1" Background="{StaticResource B.Border}" Margin="0,14,0,10" />
                                <TextBlock Style="{StaticResource T.Caption}" Margin="0,2"><Run Text="&#xE916;" FontFamily="{StaticResource F.Icons}" />  <Run Text="{Binding Time, Mode=OneWay}" /></TextBlock>
                                <TextBlock Style="{StaticResource T.Caption}" Margin="0,2"><Run Text="&#xE72E;" FontFamily="{StaticResource F.Icons}" />  <Run Text="{Binding Admin, Mode=OneWay}" /></TextBlock>
                                <TextBlock Style="{StaticResource T.Caption}" Margin="0,2"><Run Text="&#xE777;" FontFamily="{StaticResource F.Icons}" />  <Run Text="{Binding Restart, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                <!-- Prévia -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="O que vai acontecer no seu PC" Style="{StaticResource T.H2}" />
                        <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource T.WrapMuted}" FontSize="12.5" Margin="0,4,0,10" />
                        <ProgressBar IsIndeterminate="True" Margin="0,6" Visibility="{Binding PlanLoading, Converter={StaticResource Vis}}" />
                        <ItemsControl ItemsSource="{Binding Plan}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PlanItem}">
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Chip}" VerticalAlignment="Top"><TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{StaticResource B.TextMuted}" /></Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource T.H3}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="&#xE72E;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="{StaticResource B.TextFaint}"
                                                   ToolTip="Pede permissão de administrador" Visibility="{Binding NeedsAdmin, Converter={StaticResource Vis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Ação / progresso -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding Selected.Title, StringFormat=Otimização {0}}" Style="{StaticResource T.H2}" />
                        <TextBlock Text="{Binding Selected.Tagline}" Style="{StaticResource T.WrapMuted}" FontSize="12.5" Margin="0,4,0,14" />
                        <Button Style="{StaticResource Btn.Primary}" Padding="18,12" HorizontalAlignment="Stretch" Command="{Binding RunCommand}"
                                IsEnabled="{Binding Running, Converter={StaticResource Not}}">
                            <TextBlock FontSize="14"><Run Text="&#xE768;" FontFamily="{StaticResource F.Icons}" />  <Run Text="Otimizar agora" /></TextBlock>
                        </Button>
                        <TextBlock Text="Antes de começar, você vê a lista completa e confirma. Ajustes podem ser desfeitos a qualquer momento."
                                   Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <ItemsControl ItemsSource="{Binding Steps}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RunStep}">
                                    <DockPanel Margin="0,6">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource StepIcon}" Margin="0,1,10,0" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource T.Base}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Visibility="{Binding Detail, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Callout.Ok}" Margin="0,14,0,0" Visibility="{Binding Finished, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ResultTitle}" Style="{StaticResource T.H3}" />
                                <TextBlock Text="{Binding ResultText}" Style="{StaticResource T.Wrap}" FontSize="12.5" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Desfazer esta otimização" Command="{Binding UndoCommand}" Margin="0,0,8,0" />
                                    <Button Content="Ver o Painel" Style="{StaticResource Btn.Ghost}" Command="{Binding GoCommand}" CommandParameter="dashboard" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
