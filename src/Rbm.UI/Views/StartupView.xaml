<UserControl x:Class="Rbm.UI.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:Rbm.UI.Pages.SystemPages">
    <UserControl.Resources>
        <Style x:Key="Btn.Small" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Btn.Row" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock" BasedOn="{StaticResource T.Overline}">
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="Val" TargetType="TextBlock" BasedOn="{StaticResource T.Wrap}">
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource Val}">
            <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <!-- TechDetails define o cabeçalho como um único TextBlock compartilhado (só pode ser usado uma vez por página): aqui o cabeçalho é texto. -->
        <Style x:Key="Tech" TargetType="Expander" BasedOn="{StaticResource TechDetails}">
            <Setter Property="Header" Value="Detalhes técnicos" />
            <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <!-- Chip cuja cor segue o nível (Tag = ok | warn | danger | info) -->
        <Style x:Key="LevelChip" TargetType="Border" BasedOn="{StaticResource Chip.Info}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="ok"><Setter Property="Background" Value="{StaticResource B.SuccessSoft}" /></Trigger>
                <Trigger Property="Tag" Value="warn"><Setter Property="Background" Value="{StaticResource B.WarningSoft}" /></Trigger>
                <Trigger Property="Tag" Value="danger"><Setter Property="Background" Value="{StaticResource B.DangerSoft}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LevelChipText" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource B.Info}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="ok"><Setter Property="Foreground" Value="{StaticResource B.Success}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="warn"><Setter Property="Foreground" Value="{StaticResource B.Warning}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="danger"><Setter Property="Foreground" Value="#FFFCA5A5" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Duas linhas: nome em destaque + linha secundária -->
        <Style x:Key="TwoLineGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="RowHeight" Value="44" />
        </Style>
        <DataTemplate x:Key="RecCell">
            <Border Style="{StaticResource Pill}" ToolTip="{Binding PlainReason}">
                <TextBlock Text="{Binding Recommendation}" FontSize="11.5" Foreground="{Binding RecommendationTone, Converter={StaticResource LevelBrush}}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,0,16,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="300" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Resumo ===== -->
        <Border Style="{StaticResource Hero}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding ReviewSuggestionsCommand}" Margin="0,0,8,0"
                            Visibility="{Binding HasSuggestions, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="White" Margin="0,0,8,0" />
                            <TextBlock Text="Revisar sugestões" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ClearFiltersCommand}" ToolTip="Mostra todos os itens, inclusive os do Windows">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Ver tudo" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Margin="0,0,24,0">
                    <Border Style="{StaticResource LevelChip}" Tag="{Binding HeroLevel}">
                        <TextBlock Text="{Binding HeroChipText}" Style="{StaticResource LevelChipText}" />
                    </Border>
                    <TextBlock Text="{Binding HeroTitle}" Style="{StaticResource T.H1}" FontSize="20" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None" />
                    <TextBlock Text="{Binding HeroText}" Style="{StaticResource T.Lead}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Abas ===== -->
        <DockPanel Grid.Row="1" Margin="0,0,12,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Small}" Margin="8,0,0,0" Command="{Binding RefreshCommand}" ToolTip="Ler novamente a aba atual" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="Atualizar" />
                </StackPanel>
            </Button>
            <Border Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="startupTabs" IsChecked="{Binding TabStartup}" Content="{Binding StartupTabText}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="startupTabs" IsChecked="{Binding TabServices}" Content="{Binding ServiceTabText}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="startupTabs" IsChecked="{Binding TabTasks}" Content="{Binding TaskTabText}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="startupTabs" IsChecked="{Binding TabOther}" Content="{Binding OtherTabText}"
                                 ToolTip="Winlogon, extensões do Explorer e drivers de inicialização (somente leitura)" />
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- ===== Lista + detalhes ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="370" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="14,12,14,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding TabHint}" Style="{StaticResource T.WrapMuted}" FontSize="12.5" />
                        <DockPanel Margin="0,10,0,0">
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding HideMicrosoft}" Margin="16,0,0,0" VerticalAlignment="Center"
                                          ToolTip="Esconde apenas itens com assinatura digital da Microsoft VERIFICADA. Drivers de outros fabricantes continuam visíveis.">
                                <TextBlock Text="Ocultar itens do Windows" Style="{StaticResource T.Base}" FontSize="12.5" />
                            </ToggleButton>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding OnlySuggestions}" Margin="16,0,0,0" VerticalAlignment="Center"
                                          ToolTip="Mostra só o que pode ser desativado com segurança ou que merece verificação">
                                <TextBlock Text="Só sugestões" Style="{StaticResource T.Base}" FontSize="12.5" />
                            </ToggleButton>
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="Procurar por nome, fabricante ou caminho…" />
                        </DockPanel>
                        <!-- Carregando -->
                        <Grid Margin="0,10,0,0" Visibility="{Binding IsLoading, Converter={StaticResource Vis}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding LoadingText}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Cyan}" />
                                <ProgressBar IsIndeterminate="True" Margin="0,5,0,0" Height="4" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Btn.Small}" Content="Cancelar" Margin="12,0,0,0" Command="{Binding CancelLoadCommand}" />
                        </Grid>
                        <DockPanel Margin="2,8,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Padding="8,2" FontSize="12" Foreground="{StaticResource B.Cyan}" Content="Limpar filtros"
                                    Command="{Binding ClearFiltersCommand}" Visibility="{Binding FiltersActive, Converter={StaticResource Vis}}" />
                            <Grid VerticalAlignment="Center">
                                <TextBlock Text="{Binding StartupSummary}" Style="{StaticResource T.Caption}" Visibility="{Binding TabStartup, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{Binding ServiceSummary}" Style="{StaticResource T.Caption}" Visibility="{Binding TabServices, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{Binding TaskSummary}" Style="{StaticResource T.Caption}" Visibility="{Binding TabTasks, Converter={StaticResource Vis}}" />
                                <TextBlock Text="{Binding OtherSummary}" Style="{StaticResource T.Caption}" Visibility="{Binding TabOther, Converter={StaticResource Vis}}" />
                            </Grid>
                        </DockPanel>
                    </StackPanel>
                    <Expander DockPanel.Dock="Bottom" Style="{StaticResource Tech}" Margin="2,6,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding TabTech}" Style="{StaticResource T.WrapMuted}" FontSize="12" />
                            <TextBlock Text="{Binding LoadInfo}" Style="{StaticResource T.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                    <Grid>
                        <!-- Estado vazio -->
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding IsListEmpty, Converter={StaticResource Vis}}">
                            <TextBlock Text="&#xE721;" Style="{StaticResource EmptyIcon}" />
                            <TextBlock Text="Nada para mostrar aqui" Style="{StaticResource T.H3}" HorizontalAlignment="Center" />
                            <TextBlock Text="Nenhum item corresponde aos filtros atuais." Style="{StaticResource T.Caption}" HorizontalAlignment="Center" Margin="0,4,0,10"
                                       Visibility="{Binding FiltersActive, Converter={StaticResource Vis}}" />
                            <Button Style="{StaticResource Btn.Small}" Margin="0" Content="Mostrar tudo" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Center"
                                    Visibility="{Binding FiltersActive, Converter={StaticResource Vis}}" />
                        </StackPanel>

                        <!-- Programas ao iniciar -->
                        <DataGrid Style="{StaticResource TwoLineGrid}" ItemsSource="{Binding StartupView}" SelectedItem="{Binding SelectedStartup}"
                                  Visibility="{Binding TabStartup, Converter={StaticResource Vis}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Programa" Width="*" MinWidth="180" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type sp:StartupRow}">
                                            <StackPanel VerticalAlignment="Center" ToolTip="{Binding Command}">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding PublisherLine}" Style="{StaticResource T.Caption}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Situação" Width="118" SortMemberPath="IsEnabled">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type sp:StartupRow}">
                                            <Border Style="{StaticResource Pill}">
                                                <TextBlock Text="{Binding StateText}" FontSize="11.5" Foreground="{Binding StateTone, Converter={StaticResource LevelBrush}}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Sugestão" Width="172" SortMemberPath="Suggestion">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type sp:StartupRow}">
                                            <Border Style="{StaticResource Pill}" ToolTip="{Binding PlainReason}">
                                                <TextBlock Text="{Binding Suggestion}" FontSize="11.5" Foreground="{Binding SuggestionTone, Converter={StaticResource LevelBrush}}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Ação" Width="100" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type sp:StartupRow}">
                                            <Grid>
                                                <Button Style="{StaticResource Btn.Row}" Content="{Binding ShortToggleText}" Visibility="{Binding CanToggle, Converter={StaticResource Vis}}"
                                                        Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <TextBlock Text="Fixo" Style="{StaticResource T.Caption}" ToolTip="{Binding NoToggleReason}" Visibility="{Binding CanToggle, Converter={StaticResource VisInv}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Serviços -->
                        <DataGrid Style="{StaticResource TwoLineGrid}" ItemsSource="{Binding ServiceView}" SelectedItem="{Binding SelectedService}"
                                  Visibility="{Binding TabServices, Converter={StaticResource Vis}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Serviço" Width="*" MinWidth="200" SortMemberPath="DisplayName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type sp:ServiceRow}">
                                            <StackPanel VerticalAlignment="Center" ToolTip="{Binding Description}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" Style="{StaticResource T.Icon}" FontSize="11" Foreground="{StaticResource B.Warning}" Margin="0,0,6,0"
                                                               ToolTip="Protegido pelo RBM (essencial ou de segurança)" Visibility="{Binding IsProtected, Converter={StaticResource Vis}}" />
                                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource T.Base}" FontSize="12.5" FontWeight="SemiBold" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding PublisherLine}" Style="{StaticResource T.Caption}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Situação" Width="104" SortMemberPath="StatusText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type sp:ServiceRow}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{Binding StatusTone, Converter={StaticResource LevelBrush}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Binding="{Binding StartModeText}" Width="150">
                                    <DataGridTextColumn.Header><TextBlock Text="Como inicia" ToolTip="Automático: inicia com o Windows · Manual: só quando algo pede · Desativado: nunca" /></DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Sugestão" Width="124" SortMemberPath="Recommendation" CellTemplate="{StaticResource RecCell}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Tarefas -->
                        <DataGrid Style="{StaticResource TwoLineGrid}" ItemsSource="{Binding TaskView}" SelectedItem="{Binding SelectedTask}"
                                  Visibility="{Binding TabTasks, Converter={StaticResource Vis}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Tarefa" Width="1.3*" MinWidth="180" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type sp:TaskRow}">
                                            <StackPanel VerticalAlignment="Center" ToolTip="{Binding Path}">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Folder}" Style="{StaticResource T.Caption}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Situação" Width="96" SortMemberPath="Enabled">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type sp:TaskRow}">
                                            <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="{Binding StateTone, Converter={StaticResource LevelBrush}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Quando roda" Width="*" SortMemberPath="Triggers">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type sp:TaskRow}">
                                            <TextBlock Text="{Binding Triggers}" Style="{StaticResource T.Base}" FontSize="12" ToolTip="{Binding Triggers}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Sugestão" Width="124" SortMemberPath="Recommendation" CellTemplate="{StaticResource RecCell}" />
                                <DataGridTextColumn Header="Próxima vez" Binding="{Binding NextRun}" Width="116" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Avançado -->
                        <DataGrid Style="{StaticResource TwoLineGrid}" ItemsSource="{Binding OtherView}" SelectedItem="{Binding SelectedOther}"
                                  Visibility="{Binding TabOther, Converter={StaticResource Vis}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Item" Width="1.2*" MinWidth="180" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type sp:OtherRow}">
                                            <StackPanel VerticalAlignment="Center" ToolTip="{Binding Image}">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Publisher}" Style="{StaticResource T.Caption}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Category}" Width="150" />
                                <DataGridTemplateColumn Header="Padrão do Windows?" Width="170" SortMemberPath="Deviation">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type sp:OtherRow}">
                                            <TextBlock Text="{Binding Deviation}" FontSize="12" Foreground="{Binding DeviationTone, Converter={StaticResource LevelBrush}}" ToolTip="{Binding Deviation}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Sugestão" Width="124" SortMemberPath="Recommendation" CellTemplate="{StaticResource RecCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ===== Painel de detalhes ===== -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <!-- Nada selecionado -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding TabStartup}" Value="True" />
                                                <Condition Binding="{Binding SelectedStartup}" Value="{x:Null}" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding TabServices}" Value="True" />
                                                <Condition Binding="{Binding SelectedService}" Value="{x:Null}" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding TabTasks}" Value="True" />
                                                <Condition Binding="{Binding SelectedTask}" Value="{x:Null}" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding TabOther}" Value="True" />
                                                <Condition Binding="{Binding SelectedOther}" Value="{x:Null}" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE946;" Style="{StaticResource EmptyIcon}" Margin="0,16,0,10" />
                            <TextBlock Text="Escolha um item" Style="{StaticResource T.H3}" HorizontalAlignment="Center" />
                            <TextBlock Text="Clique em um item da lista para ver o que ele é, quem fez e o que você pode fazer."
                                       Style="{StaticResource T.WrapMuted}" FontSize="12.5" TextAlignment="Center" Margin="8,6,8,0" />
                            <Border Style="{StaticResource CardInner}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="COMO LER A SUGESTÃO" Style="{StaticResource T.Overline}" />
                                    <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,6,0,0">
                                        <Run Text="Recomendado desativar / Pode desativar" Foreground="{StaticResource B.Info}" FontWeight="SemiBold" /><Run Text=" — inicializador ou atualizador conhecido; o programa funciona normalmente quando você abrir." />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,6,0,0">
                                        <Run Text="Verificar" Foreground="{StaticResource B.Warning}" FontWeight="SemiBold" /><Run Text=" — sem assinatura válida ou arquivo ausente; confira se você reconhece." />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,6,0,0">
                                        <Run Text="Manter" Foreground="{StaticResource B.Success}" FontWeight="SemiBold" /><Run Text=" — parte do Windows ou protegido." />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,6,0,0">
                                        <Run Text="Sem sugestão" FontWeight="SemiBold" /><Run Text=" — faltam dados; desative só se não usar. Nada é aplicado automaticamente." />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Detalhes: programa ao iniciar -->
                        <Grid Visibility="{Binding TabStartup, Converter={StaticResource Vis}}">
                            <StackPanel DataContext="{Binding SelectedStartup}" Visibility="{Binding Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.H2}" TextWrapping="Wrap" TextTrimming="None" />
                                <TextBlock Text="{Binding PublisherLine}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding StateText}" FontSize="11.5" Foreground="{Binding StateTone, Converter={StaticResource LevelBrush}}" />
                                    </Border>
                                    <Border Style="{StaticResource Pill}">
                                        <TextBlock Text="{Binding Suggestion}" FontSize="11.5" Foreground="{Binding SuggestionTone, Converter={StaticResource LevelBrush}}" />
                                    </Border>
                                </WrapPanel>
                                <Border Style="{StaticResource Callout}" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding PlainReason}" Style="{StaticResource T.Wrap}" FontSize="12.5" />
                                </Border>

                                <StackPanel Margin="0,4,0,0" Visibility="{Binding CanToggle, Converter={StaticResource Vis}}">
                                    <WrapPanel>
                                        <Button Style="{StaticResource Btn.Primary}" Padding="12,6" FontSize="12.5" Content="{Binding ToggleText}"
                                                Command="{Binding DataContext.ToggleStartupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Btn.Small}" Margin="8,0,0,0" Content="Mostrar arquivo"
                                                Command="{Binding DataContext.RevealPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Entry.ExecutablePath}"
                                                Visibility="{Binding Entry.TargetExists, Converter={StaticResource Vis}}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding AdminNote}" Style="{StaticResource T.WrapMuted}" FontSize="11.5" Margin="0,8,0,0" />
                                </StackPanel>
                                <Border Style="{StaticResource Callout.Warn}" Visibility="{Binding CanToggle, Converter={StaticResource VisInv}}">
                                    <StackPanel>
                                        <TextBlock Text="NÃO DÁ PARA DESATIVAR POR AQUI" Style="{StaticResource T.Overline}" Foreground="{StaticResource B.Warning}" />
                                        <TextBlock Text="{Binding NoToggleReason}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding DisabledAt}" Style="{StaticResource T.Caption}" Margin="0,8,0,0" Visibility="{Binding DisabledAt, Converter={StaticResource Vis}}" />

                                <Expander Style="{StaticResource Tech}">
                                    <StackPanel>
                                        <TextBlock Text="LOCAL" Style="{StaticResource Lbl}" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding Location}" Style="{StaticResource Val}" />
                                        <TextBlock Text="COMANDO" Style="{StaticResource Lbl}" />
                                        <TextBlock Text="{Binding Command}" Style="{StaticResource Mono}" />
                                        <TextBlock Text="ASSINATURA DIGITAL" Style="{StaticResource Lbl}" />
                                        <TextBlock Text="{Binding Signature}" Style="{StaticResource Val}" Foreground="{Binding SignatureTone, Converter={StaticResource LevelBrush}}" />
                                        <TextBlock Text="ANÁLISE COMPLETA" Style="{StaticResource Lbl}" />
                                        <TextBlock Text="{Binding RecommendationReason}" Style="{StaticResource T.WrapMuted}" FontSize="12" />
                                        <TextBlock Text="{Binding AdminNoteTech}" Style="{StaticResource T.WrapMuted}" FontSize="11.5" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding Entry.Note}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding Entry.Note, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Grid>

                        <!-- Detalhes: serviço -->
                        <Grid Visibility="{Binding TabServices, Converter={StaticResource Vis}}">
                            <StackPanel Visibility="{Binding SelectedService, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding SelectedService.DisplayName}" Style="{StaticResource T.H2}" TextWrapping="Wrap" TextTrimming="None" />
                                <TextBlock Text="{Binding SelectedService.PublisherLine}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding SelectedService.StatusText}" FontSize="11.5" Foreground="{Binding SelectedService.StatusTone, Converter={StaticResource LevelBrush}}" />
                                    </Border>
                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding SelectedService.StartModeText}" FontSize="11.5" Foreground="{StaticResource B.TextMuted}" />
                                    </Border>
                                    <Border Style="{StaticResource Pill}">
                                        <TextBlock Text="{Binding SelectedService.Recommendation}" FontSize="11.5" Foreground="{Binding SelectedService.RecommendationTone, Converter={StaticResource LevelBrush}}" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{Binding SelectedService.Description}" Style="{StaticResource Val}" Margin="0,10,0,0" />
                                <Border Style="{StaticResource Callout}" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding SelectedService.PlainReason}" Style="{StaticResource T.Wrap}" FontSize="12.5" />
                                </Border>

                                <StackPanel Margin="0,4,0,0" Visibility="{Binding SelectedService.CanChange, Converter={StaticResource Vis}}">
                                    <TextBlock Text="COMO ESTE SERVIÇO INICIA" Style="{StaticResource T.Overline}" />
                                    <DockPanel Margin="0,6,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Padding="12,6" FontSize="12.5" Margin="8,0,0,0" Content="Aplicar" Command="{Binding ApplyStartModeCommand}" />
                                        <ComboBox ItemsSource="{Binding StartModes}" SelectedValuePath="Mode" SelectedValue="{Binding PendingStartMode}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding StartModeHint}" Style="{StaticResource T.WrapMuted}" FontSize="11.5" Margin="0,6,0,0" Visibility="{Binding StartModeHint, Converter={StaticResource Vis}}" />
                                    <TextBlock Text="AGORA" Style="{StaticResource T.Overline}" Margin="0,14,0,0" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Style="{StaticResource Btn.Small}" Content="Iniciar" Command="{Binding StartServiceCommand}" Visibility="{Binding SelectedService.IsStopped, Converter={StaticResource Vis}}" />
                                        <Button Style="{StaticResource Btn.Danger}" Padding="10,5" FontSize="12" Margin="0,0,8,0" Content="Parar" Command="{Binding StopServiceCommand}" Visibility="{Binding SelectedService.IsRunning, Converter={StaticResource Vis}}" />
                                        <Button Style="{StaticResource Btn.Small}" Content="Reiniciar" Command="{Binding RestartServiceCommand}" Visibility="{Binding SelectedService.IsRunning, Converter={StaticResource Vis}}" />
                                    </WrapPanel>
                                    <TextBlock Text="Pede permissão de administrador. Tudo fica registrado em “Alterações”, com opção de desfazer." Style="{StaticResource T.WrapMuted}" FontSize="11.5" Margin="0,8,0,0" />
                                </StackPanel>
                                <Border Style="{StaticResource Callout.Warn}" Visibility="{Binding SelectedService.CanChange, Converter={StaticResource VisInv}}">
                                    <StackPanel>
                                        <TextBlock Text="SERVIÇO PROTEGIDO" Style="{StaticResource T.Overline}" Foreground="{StaticResource B.Warning}" />
                                        <TextBlock Text="{Binding SelectedService.ProtectionReason}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Expander Style="{StaticResource Tech}">
                                    <StackPanel>
                                        <TextBlock Text="NOME INTERNO" Style="{StaticResource Lbl}" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding SelectedService.Name}" Style="{StaticResource Mono}" />
                                        <TextBlock Text="ARQUIVO" Style="{StaticResource Lbl}" />
                                        <TextBlock Text="{Binding SelectedService.Path}" Style="{StaticResource Mono}" />
                                        <TextBlock Text="CONTA" Style="{StaticResource Lbl}" />
                                        <TextBlock Text="{Binding SelectedService.Account}" Style="{StaticResource Val}" />
                                        <TextBlock Text="ASSINATURA DIGITAL" Style="{StaticResource Lbl}" />
                                        <TextBlock Text="{Binding SelectedService.Signature}" Style="{StaticResource Val}" Foreground="{Binding SelectedService.SignatureTone, Converter={StaticResource LevelBrush}}" />
                                        <TextBlock Text="DEPENDE DE" Style="{StaticResource Lbl}" />
                                        <TextBlock Text="{Binding SelectedService.Dependencies}" Style="{StaticResource Val}" />
                                        <TextBlock Text="OUTROS SERVIÇOS QUE DEPENDEM DELE" Style="{StaticResource Lbl}" />
                                        <TextBlock Text="{Binding SelectedService.Dependents}" Style="{StaticResource Val}" />
                                        <TextBlock Text="ANÁLISE COMPLETA" Style="{StaticResource Lbl}" />
                                        <TextBlock Text="{Binding SelectedService.RecommendationReason}" Style="{StaticResource T.WrapMuted}" FontSize="12" />
                                        <TextBlock Text="{Binding SelectedService.Entry.Note}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding SelectedService.Entry.Note, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Grid>

                        <!-- Detalhes: tarefa -->
                        <Grid Visibility="{Binding TabTasks, Converter={StaticResource Vis}}">
                            <StackPanel Visibility="{Binding SelectedTask, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding SelectedTask.Name}" Style="{StaticResource T.H2}" TextWrapping="Wrap" TextTrimming="None" />
                                <TextBlock Text="{Binding SelectedTask.Publisher}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding SelectedTask.StateText}" FontSize="11.5" Foreground="{Binding SelectedTask.StateTone, Converter={StaticResource LevelBrush}}" />
                                    </Border>
                                    <Border Style="{StaticResource Pill}">
                                        <TextBlock Text="{Binding SelectedTask.Recommendation}" FontSize="11.5" Foreground="{Binding SelectedTask.RecommendationTone, Converter={StaticResource LevelBrush}}" />
                                    </Border>
                                </WrapPanel>
                                <Border Style="{StaticResource Callout}" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding SelectedTask.PlainReason}" Style="{StaticResource T.Wrap}" FontSize="12.5" />
                                </Border>
                                <TextBlock Text="QUANDO RODA" Style="{StaticResource Lbl}" Margin="0,4,0,2" />
                                <TextBlock Text="{Binding SelectedTask.Triggers}" Style="{StaticResource Val}" />
                                <TextBlock Text="ÚLTIMA VEZ / PRÓXIMA" Style="{StaticResource Lbl}" />
                                <TextBlock Text="{Binding SelectedTask.LastRun}" Style="{StaticResource Val}" />
                                <TextBlock Text="{Binding SelectedTask.NextRun, StringFormat=Próxima: {0}}" Style="{StaticResource Val}" />

                                <StackPanel Margin="0,14,0,0" Visibility="{Binding SelectedTask.CanToggle, Converter={StaticResource Vis}}">
                                    <Button Style="{StaticResource Btn.Primary}" Padding="12,6" FontSize="12.5" HorizontalAlignment="Left" Content="{Binding SelectedTask.ToggleText}" Command="{Binding ToggleTaskCommand}" CommandParameter="{Binding SelectedTask}" />
                                    <TextBlock Text="A tarefa nunca é apagada. Se ela for do sistema, o RBM pede permissão de administrador antes." Style="{StaticResource T.WrapMuted}" FontSize="11.5" Margin="0,8,0,0" />
                                </StackPanel>
                                <Border Style="{StaticResource Callout.Warn}" Margin="0,14,0,0" Visibility="{Binding SelectedTask.CanToggle, Converter={StaticResource VisInv}}">
                                    <StackPanel>
                                        <TextBlock Text="TAREFA PROTEGIDA" Style="{StaticResource T.Overline}" Foreground="{StaticResource B.Warning}" />
                                        <TextBlock Text="{Binding SelectedTask.ProtectionReason}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Expander Style="{StaticResource Tech}">
                                    <StackPanel>
                                        <TextBlock Text="CAMINHO NO AGENDADOR" Style="{StaticResource Lbl}" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding SelectedTask.Path}" Style="{StaticResource Mono}" />
                                        <TextBlock Text="O QUE ELA EXECUTA" Style="{StaticResource Lbl}" />
                                        <TextBlock Text="{Binding SelectedTask.Actions}" Style="{StaticResource Mono}" />
                                        <TextBlock Text="AUTOR" Style="{StaticResource Lbl}" />
                                        <TextBlock Text="{Binding SelectedTask.Author}" Style="{StaticResource Val}" />
                                        <TextBlock Text="ASSINATURA DIGITAL" Style="{StaticResource Lbl}" />
                                        <TextBlock Text="{Binding SelectedTask.Signature}" Style="{StaticResource Val}" Foreground="{Binding SelectedTask.SignatureTone, Converter={StaticResource LevelBrush}}" />
                                        <TextBlock Text="ANÁLISE COMPLETA" Style="{StaticResource Lbl}" />
                                        <TextBlock Text="{Binding SelectedTask.RecommendationReason}" Style="{StaticResource T.WrapMuted}" FontSize="12" />
                                        <TextBlock Text="{Binding SelectedTask.Entry.Note}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding SelectedTask.Entry.Note, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Grid>

                        <!-- Detalhes: avançado (somente leitura) -->
                        <Grid Visibility="{Binding TabOther, Converter={StaticResource Vis}}">
                            <StackPanel Visibility="{Binding SelectedOther, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding SelectedOther.Name}" Style="{StaticResource T.H2}" TextWrapping="Wrap" TextTrimming="None" />
                                <TextBlock Text="{Binding SelectedOther.Category}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Border Style="{StaticResource Pill}" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding SelectedOther.Deviation}" FontSize="11.5" Foreground="{Binding SelectedOther.DeviationTone, Converter={StaticResource LevelBrush}}" />
                                    </Border>
                                    <Border Style="{StaticResource Pill}">
                                        <TextBlock Text="{Binding SelectedOther.Recommendation}" FontSize="11.5" Foreground="{Binding SelectedOther.RecommendationTone, Converter={StaticResource LevelBrush}}" />
                                    </Border>
                                </WrapPanel>
                                <Border Style="{StaticResource Callout}" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding SelectedOther.PlainReason}" Style="{StaticResource T.Wrap}" FontSize="12.5" />
                                </Border>
                                <TextBlock Text="FABRICANTE" Style="{StaticResource Lbl}" Margin="0,4,0,2" />
                                <TextBlock Text="{Binding SelectedOther.Publisher}" Style="{StaticResource Val}" />
                                <TextBlock Text="{Binding SelectedOther.Note}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding SelectedOther.Note, Converter={StaticResource Vis}}" />
                                <Border Style="{StaticResource CardInner}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="SOMENTE LEITURA" Style="{StaticResource T.Overline}" />
                                        <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,0"
                                                   Text="Estes locais não têm um jeito seguro e reversível de desativar; mexer neles pode impedir o logon ou a inicialização do Windows. O RBM só mostra e destaca o que foge do padrão — em caso de dúvida, procure o fabricante do software." />
                                    </StackPanel>
                                </Border>
                                <Expander Style="{StaticResource Tech}">
                                    <StackPanel>
                                        <TextBlock Text="LOCAL" Style="{StaticResource Lbl}" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding SelectedOther.Location}" Style="{StaticResource Mono}" />
                                        <TextBlock Text="COMANDO / ARQUIVO" Style="{StaticResource Lbl}" />
                                        <TextBlock Text="{Binding SelectedOther.Command}" Style="{StaticResource Mono}" />
                                        <TextBlock Text="{Binding SelectedOther.Image}" Style="{StaticResource Mono}" />
                                        <TextBlock Text="ASSINATURA DIGITAL" Style="{StaticResource Lbl}" />
                                        <TextBlock Text="{Binding SelectedOther.Signature}" Style="{StaticResource Val}" Foreground="{Binding SelectedOther.SignatureTone, Converter={StaticResource LevelBrush}}" />
                                        <TextBlock Text="ANÁLISE COMPLETA" Style="{StaticResource Lbl}" />
                                        <TextBlock Text="{Binding SelectedOther.RecommendationReason}" Style="{StaticResource T.WrapMuted}" FontSize="12" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Alterações registradas ===== -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="16,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="Tudo o que você muda aqui pode ser desfeito" Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                    <TextBlock Text="Alterações" Style="{StaticResource T.H2}" />
                </DockPanel>
                <TextBlock Text="Nenhuma alteração feita por esta página ainda. Cada mudança aparece aqui com o valor anterior e um botão para desfazer."
                           Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,0" Visibility="{Binding HasChanges, Converter={StaticResource VisInv}}" />
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Visibility="{Binding HasChanges, Converter={StaticResource Vis}}">
                    <ItemsControl ItemsSource="{Binding Changes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type sp:StartupChangeRecord}">
                                <Border BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding WhenText}" Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding KindText}" Style="{StaticResource T.Muted}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Target}" Style="{StaticResource T.H3}" FontSize="12.5" VerticalAlignment="Center" ToolTip="{Binding Key1}" />
                                        <TextBlock Grid.Column="3" Text="{Binding ChangeText}" Style="{StaticResource T.Base}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource T.Caption}" VerticalAlignment="Center">
                                            <Run Text="{Binding StatusText, Mode=OneWay}" /><Run Text=" · via " /><Run Text="{Binding Via, Mode=OneWay}" />
                                        </TextBlock>
                                        <Button Grid.Column="5" Style="{StaticResource Btn.Small}" Margin="0" Content="Desfazer" HorizontalAlignment="Right"
                                                Visibility="{Binding ShowRevert, Converter={StaticResource Vis}}"
                                                Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
