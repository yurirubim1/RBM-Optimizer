<UserControl x:Class="Rbm.UI.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:Rbm.UI.Pages.SystemPages"
             xmlns:pr="clr-namespace:Rbm.Processes;assembly=Rbm.Processes">
    <UserControl.Resources>
        <sp:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <!-- Tabelas mais compactas nesta página (muitas colunas numéricas) -->
        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Padding" Value="7,0" />
        </Style>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Padding" Value="7,8" />
        </Style>
        <Style x:Key="NumCell" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Overline}">
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock" BasedOn="{StaticResource T.Wrap}">
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SmallDanger" TargetType="Button" BasedOn="{StaticResource Btn.Danger}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- TechDetails define o cabeçalho como um único TextBlock compartilhado (só pode ser usado uma vez por página): aqui o cabeçalho é texto. -->
        <Style x:Key="Tech" TargetType="Expander" BasedOn="{StaticResource TechDetails}">
            <Setter Property="Header" Value="Detalhes técnicos" />
            <Setter Property="Foreground" Value="{StaticResource B.TextMuted}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="RowBtn" TargetType="Button" BasedOn="{StaticResource Btn.Tile}">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <!-- Chip cuja cor segue o nível (Tag = ok | warn | danger | info) -->
        <Style x:Key="LevelChip" TargetType="Border" BasedOn="{StaticResource Chip.Info}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="ok"><Setter Property="Background" Value="{StaticResource B.SuccessSoft}" /></Trigger>
                <Trigger Property="Tag" Value="warn"><Setter Property="Background" Value="{StaticResource B.WarningSoft}" /></Trigger>
                <Trigger Property="Tag" Value="danger"><Setter Property="Background" Value="{StaticResource B.DangerSoft}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LevelChipText" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource B.Info}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="ok"><Setter Property="Foreground" Value="{StaticResource B.Success}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="warn"><Setter Property="Foreground" Value="{StaticResource B.Warning}" /></DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="danger"><Setter Property="Foreground" Value="#FFFCA5A5" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Linha da lista "mais pesados" -->
        <DataTemplate x:Key="GroupTpl" DataType="{x:Type sp:ProcessGroupRow}">
            <Button Style="{StaticResource RowBtn}" Visibility="{Binding IsUsed, Converter={StaticResource Vis}}" ToolTip="{Binding ToolTip}"
                    Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" Style="{StaticResource T.Icon}" FontSize="11" Foreground="{StaticResource B.Warning}" Margin="0,0,6,0"
                                   Visibility="{Binding IsProtected, Converter={StaticResource Vis}}" ToolTip="Protegido: não pode ser encerrado nem alterado por aqui" />
                        <TextBlock Style="{StaticResource T.Base}">
                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Subtitle, Mode=OneWay}" Foreground="{StaticResource B.TextFaint}" FontSize="11.5" />
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource T.H3}" Foreground="{StaticResource B.Cyan}" Margin="12,0,0,0" />
                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Maximum="1" Value="{Binding Share, Mode=OneWay}" Height="4" Margin="0,7,0,0" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,0,16,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Resumo ===== -->
        <Border Style="{StaticResource Hero}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding ShowTopCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="White" Margin="0,0,8,0" />
                            <TextBlock Text="Ver os mais pesados" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowAllCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Procurar um programa" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Margin="0,0,24,0">
                    <Border Style="{StaticResource LevelChip}" Tag="{Binding HeroLevel}">
                        <TextBlock Text="{Binding HeroChipText}" Style="{StaticResource LevelChipText}" />
                    </Border>
                    <TextBlock Text="{Binding HeroTitle}" Style="{StaticResource T.H1}" FontSize="20" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None" />
                    <TextBlock Text="{Binding HeroText}" Style="{StaticResource T.Lead}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Abas ===== -->
        <DockPanel Grid.Row="1" Margin="0,0,12,12">
            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Style="{StaticResource T.Caption}" VerticalAlignment="Center" ToolTip="{Binding StatusDetail}"
                       Visibility="{Binding IsListTab, Converter={StaticResource Vis}}" />
            <Border Background="{StaticResource B.Surface}" CornerRadius="8" Padding="3" BorderBrush="{StaticResource B.Border}" BorderThickness="1" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" Content="Mais pesados" GroupName="ptab" IsChecked="{Binding IsTabTop}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Todos os processos" GroupName="ptab" IsChecked="{Binding IsTabProcesses}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Regras automáticas" GroupName="ptab" IsChecked="{Binding IsTabRules}" />
                    <RadioButton Style="{StaticResource Segment}" Content="Impacto ao longo do tempo" GroupName="ptab" IsChecked="{Binding IsTabImpact}" />
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- ================= ABAS COM LISTA + DETALHES ================= -->
        <Grid Grid.Row="2" Visibility="{Binding IsListTab, Converter={StaticResource Vis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <!-- ===== Mais pesados ===== -->
            <UniformGrid Columns="2" Visibility="{Binding IsTabTop, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Usando mais CPU agora" Style="{StaticResource T.H2}" />
                            <TextBlock Text="Uso do processador por programa (janelas somadas)." Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Visibility="{Binding HasTopCpu, Converter={StaticResource VisInv}}">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource EmptyIcon}" />
                                <TextBlock Text="Medindo o uso de CPU…" Style="{StaticResource T.H3}" HorizontalAlignment="Center" Visibility="{Binding CpuMeasuring, Converter={StaticResource Vis}}" />
                                <TextBlock Text="Nenhum programa usando a CPU agora" Style="{StaticResource T.H3}" HorizontalAlignment="Center" Visibility="{Binding CpuMeasuring, Converter={StaticResource VisInv}}" />
                                <TextBlock Text="A lista se atualiza sozinha a cada 2 segundos." Style="{StaticResource T.Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasTopCpu, Converter={StaticResource Vis}}">
                                <ItemsControl ItemsSource="{Binding TopCpu}" ItemTemplate="{StaticResource GroupTpl}" />
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Usando mais memória" Style="{StaticResource T.H2}" />
                            <TextBlock Text="RAM ocupada por programa (janelas somadas)." Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TopMemory}" ItemTemplate="{StaticResource GroupTpl}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <!-- ===== Todos os processos ===== -->
            <Border Style="{StaticResource Card}" Padding="6,10,6,4" Visibility="{Binding IsTabProcesses, Converter={StaticResource Vis}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="6,0,6,8">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowTechColumns}" VerticalAlignment="Center" Margin="16,0,0,0"
                                      ToolTip="Mostra PID, memória privada, threads, handles e processo pai">
                            <TextBlock Text="Colunas técnicas" Style="{StaticResource T.Base}" FontSize="12.5" />
                        </ToggleButton>
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding IsTreeView}" VerticalAlignment="Center" Margin="16,0,0,0"
                                      ToolTip="Mostra quem abriu cada processo (pai → filhos)">
                            <TextBlock Text="Árvore" Style="{StaticResource T.Base}" FontSize="12.5" />
                        </ToggleButton>
                        <TextBox Tag="Buscar por nome do programa, arquivo .exe, PID ou caminho…" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding GpuNote}" Style="{StaticResource T.Caption}" Margin="10,4,10,2"
                               Visibility="{Binding GpuNote, Converter={StaticResource Vis}}" />
                    <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding SelectedRow}" CanUserSortColumns="{Binding CanSortColumns}"
                              CanUserReorderColumns="False" CanUserResizeColumns="True" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Programa" Width="*" MinWidth="170" SortMemberPath="DisplayName" CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type sp:ProcessRow}">
                                        <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" ToolTip="{Binding ImagePath}">
                                            <TextBlock Text="&#xE72E;" Style="{StaticResource T.Icon}" FontSize="11" Foreground="{StaticResource B.Warning}" Margin="0,0,6,0"
                                                       Visibility="{Binding IsProtected, Converter={StaticResource Vis}}" ToolTip="Processo protegido: ações bloqueadas" />
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource T.Base}" FontSize="12.5" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding Name}" Width="140" SortMemberPath="Name">
                                <DataGridTextColumn.Header><TextBlock Text="Arquivo" ToolTip="Nome do executável (.exe)" /></DataGridTextColumn.Header>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Base}"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{StaticResource B.TextMuted}" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding CpuText}" SortMemberPath="Cpu" SortDirection="Descending" Width="58" ElementStyle="{StaticResource NumCell}">
                                <DataGridTextColumn.Header><TextBlock Text="CPU" ToolTip="Parte do processador usada agora (100% = todos os núcleos)" /></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding WorkingSet, Converter={StaticResource Bytes}}" SortMemberPath="WorkingSet" Width="84" ElementStyle="{StaticResource NumCell}">
                                <DataGridTextColumn.Header><TextBlock Text="Memória" ToolTip="RAM em uso pelo processo (working set)" /></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding IoText}" SortMemberPath="Io" Width="86" ElementStyle="{StaticResource NumCell}">
                                <DataGridTextColumn.Header><TextBlock Text="Disco" ToolTip="Leitura + gravação por segundo (inclui rede e dispositivos)" /></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding GpuText}" SortMemberPath="Gpu" Width="56" ElementStyle="{StaticResource NumCell}">
                                <DataGridTextColumn.Header><TextBlock Text="GPU" ToolTip="Uso da placa de vídeo (motor mais ocupado, como no Gerenciador de Tarefas)" /></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="64" ElementStyle="{StaticResource NumCell}"
                                                Visibility="{Binding Data.ShowTechColumns, Source={StaticResource Proxy}, Converter={StaticResource Vis}}" />
                            <DataGridTextColumn Binding="{Binding PrivateBytes, Converter={StaticResource Bytes}}" SortMemberPath="PrivateBytes" Width="84" ElementStyle="{StaticResource NumCell}"
                                                Visibility="{Binding Data.ShowTechColumns, Source={StaticResource Proxy}, Converter={StaticResource Vis}}">
                                <DataGridTextColumn.Header><TextBlock Text="Privada" ToolTip="Memória privada (commit) — não compartilhada com outros processos" /></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="60" ElementStyle="{StaticResource NumCell}"
                                                Visibility="{Binding Data.ShowTechColumns, Source={StaticResource Proxy}, Converter={StaticResource Vis}}" />
                            <DataGridTextColumn Header="Handles" Binding="{Binding Handles}" Width="66" ElementStyle="{StaticResource NumCell}"
                                                Visibility="{Binding Data.ShowTechColumns, Source={StaticResource Proxy}, Converter={StaticResource Vis}}" />
                            <DataGridTextColumn Binding="{Binding ParentText}" SortMemberPath="ParentPid" Width="64" ElementStyle="{StaticResource NumCell}"
                                                Visibility="{Binding Data.ShowTechColumns, Source={StaticResource Proxy}, Converter={StaticResource Vis}}">
                                <DataGridTextColumn.Header><TextBlock Text="Pai" ToolTip="PID do processo que abriu este" /></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ===== Detalhes ===== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="24" Visibility="{Binding HasSelection, Converter={StaticResource VisInv}}">
                        <TextBlock Text="&#xE8FD;" Style="{StaticResource EmptyIcon}" />
                        <TextBlock Text="Escolha um programa" Style="{StaticResource T.H3}" HorizontalAlignment="Center" />
                        <TextBlock Text="Clique em um item da lista para ver o que ele é, quanto está usando e o que dá para fazer com ele."
                                   Style="{StaticResource T.WrapMuted}" FontSize="12.5" TextAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Content="&#xE72C;" ToolTip="Recarregar detalhes" Command="{Binding RefreshDetailsCommand}" VerticalAlignment="Top" />
                                <StackPanel>
                                    <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource T.H2}" TextWrapping="Wrap" TextTrimming="None" />
                                    <TextBlock Text="{Binding DetailName}" Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding DetailUsage}" Style="{StaticResource T.Wrap}" FontSize="12.5" Foreground="{StaticResource B.Cyan}" Margin="0,8,0,0" />

                            <Border Style="{StaticResource Callout.Warn}" Margin="0,12,0,0" Visibility="{Binding ProtectionText, Converter={StaticResource Vis}}">
                                <DockPanel>
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="{StaticResource B.Warning}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                    <TextBlock Text="{Binding ProtectionText}" Style="{StaticResource T.Wrap}" FontSize="12" />
                                </DockPanel>
                            </Border>

                            <!-- Ação principal -->
                            <TextBlock Text="O QUE VOCÊ PODE FAZER" Style="{StaticResource DetailLabel}" Margin="0,14,0,6" />
                            <WrapPanel IsEnabled="{Binding CanAct}">
                                <Button Style="{StaticResource SmallDanger}" Command="{Binding EndProcessCommand}" Margin="0,0,8,6" ToolTip="Fecha este processo. Alterações não salvas nele serão perdidas.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE711;" Style="{StaticResource T.Icon}" FontSize="11" Foreground="#FFFCA5A5" Margin="0,0,6,0" />
                                        <TextBlock Text="Encerrar" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SmallDanger}" Content="Encerrar com os filhos" Command="{Binding EndTreeCommand}" Margin="0,0,8,6"
                                        ToolTip="Fecha este processo e todos os que ele abriu (árvore). Pede confirmação digitada." />
                                <Button Style="{StaticResource SmallBtn}" Content="Mostrar arquivo" Command="{Binding RevealImageCommand}" Margin="0,0,8,6"
                                        Visibility="{Binding HasImagePath, Converter={StaticResource Vis}}" />
                            </WrapPanel>

                            <!-- Sobre -->
                            <TextBlock Text="SOBRE O PROGRAMA" Style="{StaticResource DetailLabel}" Margin="0,12,0,2" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Empresa" Style="{StaticResource T.Caption}" Margin="0,6,0,1" />
                                    <TextBlock Text="{Binding DetailCompany}" Style="{StaticResource DetailValue}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Aberto há" Style="{StaticResource T.Caption}" Margin="0,6,0,1" />
                                    <TextBlock Text="{Binding DetailUptime}" Style="{StaticResource DetailValue}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Assinatura digital" Style="{StaticResource T.Caption}" Margin="0,8,0,1" ToolTip="Confirma quem publicou o arquivo e se ele não foi alterado" />
                            <TextBlock Text="{Binding DetailSignature}" Style="{StaticResource DetailValue}" />
                            <TextBlock Text="Local do arquivo" Style="{StaticResource T.Caption}" Margin="0,8,0,1" />
                            <TextBlock Text="{Binding DetailPath}" Style="{StaticResource DetailValue}" FontFamily="{StaticResource F.Mono}" FontSize="11.5" />

                            <!-- Avançado -->
                            <Expander Margin="0,14,0,0">
                                <Expander.Header>
                                    <TextBlock Text="Ajustes avançados: prioridade e núcleos" Style="{StaticResource T.H3}" />
                                </Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="Valem só até o programa ser fechado. Para manter sempre, crie uma regra automática." Style="{StaticResource T.WrapMuted}" FontSize="11.5" />
                                    <TextBlock Text="PRIORIDADE" Style="{StaticResource DetailLabel}" Margin="0,10,0,4" />
                                    <DockPanel IsEnabled="{Binding CanAct}">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallBtn}" Content="Aplicar" Command="{Binding ApplyPriorityCommand}" Margin="8,0,0,0" />
                                        <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding SelectedPriority}" />
                                    </DockPanel>
                                    <TextBlock Text="“Tempo real” não é oferecido: pode congelar mouse, áudio e o próprio Windows."
                                               Style="{StaticResource T.WrapMuted}" FontSize="11" Margin="0,4,0,0" />

                                    <TextBlock Text="NÚCLEOS DO PROCESSADOR (AFINIDADE)" Style="{StaticResource DetailLabel}" Margin="0,12,0,4" />
                                    <StackPanel IsEnabled="{Binding CanAct}">
                                        <ComboBox ItemsSource="{Binding AffinityPresetOptions}" SelectedItem="{Binding SelectedAffinityPreset}" ToolTip="Sugestões calculadas a partir da topologia real da sua CPU" />
                                        <TextBlock Text="{Binding AffinityNote}" Style="{StaticResource T.WrapMuted}" FontSize="11" Margin="0,4,0,0"
                                                   Visibility="{Binding AffinityNote, Converter={StaticResource Vis}}" />
                                        <ItemsControl ItemsSource="{Binding Cores}" Margin="0,8,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type sp:CoreToggle}">
                                                    <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,12,6" MinWidth="58">
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource T.Base}" FontSize="12" />
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Style="{StaticResource SmallBtn}" Content="Aplicar núcleos" Command="{Binding ApplyAffinityCommand}" Margin="0,0,8,0" />
                                            <Button Style="{StaticResource Btn.Ghost}" Padding="10,5" FontSize="12" Content="Marcar todos" Command="{Binding SelectAllCoresCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="Se o Windows negar acesso, você pode confirmar a execução pelo RBM Agent (pede permissão de administrador)."
                                               Style="{StaticResource T.WrapMuted}" FontSize="11" Margin="0,10,0,0" />
                                </StackPanel>
                            </Expander>

                            <!-- Técnico -->
                            <Expander Style="{StaticResource Tech}">
                                <StackPanel>
                                    <TextBlock Text="IDENTIFICAÇÃO" Style="{StaticResource DetailLabel}" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding DetailPid}" Style="{StaticResource DetailValue}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="VERSÃO" Style="{StaticResource DetailLabel}" />
                                            <TextBlock Text="{Binding DetailVersion}" Style="{StaticResource DetailValue}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="INÍCIO" Style="{StaticResource DetailLabel}" />
                                            <TextBlock Text="{Binding DetailStart}" Style="{StaticResource DetailValue}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="DESCRIÇÃO DO ARQUIVO" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Text="{Binding DetailDescription}" Style="{StaticResource DetailValue}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="PRIORIDADE ATUAL" Style="{StaticResource DetailLabel}" />
                                            <TextBlock Text="{Binding DetailPriority}" Style="{StaticResource DetailValue}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="AFINIDADE ATUAL" Style="{StaticResource DetailLabel}" />
                                            <TextBlock Text="{Binding DetailAffinity}" Style="{StaticResource DetailValue}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="USUÁRIO" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Text="{Binding DetailUser}" Style="{StaticResource DetailValue}" />
                                    <TextBlock Text="LINHA DE COMANDO" Style="{StaticResource DetailLabel}" />
                                    <TextBox Text="{Binding DetailCommandLine, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto"
                                             FontFamily="{StaticResource F.Mono}" FontSize="11" Padding="6,4" />
                                    <TextBlock Text="{Binding DetailNotes}" Style="{StaticResource T.WrapMuted}" FontSize="11.5" Margin="0,8,0,0"
                                               Visibility="{Binding DetailNotes, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= ABA REGRAS ================= -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsTabRules, Converter={StaticResource Vis}}">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding WatcherEnabled}" VerticalAlignment="Center">
                            <TextBlock Text="Aplicar regras automaticamente" Style="{StaticResource T.Base}" />
                        </ToggleButton>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Regras automáticas" Style="{StaticResource T.H2}" />
                            <TextBlock Style="{StaticResource T.Lead}" Margin="0,4,0,0"
                                       Text="Escolha uma prioridade ou quais núcleos um programa usa, e o RBM aplica isso sozinho toda vez que ele abrir. Processos críticos do Windows nunca são alterados." />
                            <TextBlock Text="{Binding WatcherStatus}" Style="{StaticResource T.Caption}" Margin="0,6,0,0" />
                            <Border Style="{StaticResource Callout.Warn}" Margin="0,8,0,0" Visibility="{Binding RulesMessage, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding RulesMessage}" Style="{StaticResource T.Wrap}" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallBtn}" Content="Nova regra" Command="{Binding NewRuleCommand}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Padding="10,5" FontSize="12" Content="Recarregar" Command="{Binding ReloadRulesCommand}" Margin="0,0,6,0" />
                                <TextBlock Text="Suas regras" Style="{StaticResource T.Section}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <Expander DockPanel.Dock="Bottom" Style="{StaticResource Tech}">
                                <StackPanel>
                                    <TextBlock Text="Arquivo de regras" Style="{StaticResource T.Caption}" />
                                    <TextBlock Text="{Binding RulesFile}" Style="{StaticResource T.Wrap}" FontFamily="{StaticResource F.Mono}" FontSize="11.5" />
                                    <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="11.5" Margin="0,6,0,0"
                                               Text="Cada regra é aplicada uma vez a cada processo novo com o nome indicado (e aos já abertos ao ativar), verificando a cada 2 s. Se o acesso for negado, a regra só usa o RBM Agent quando ele já estiver ativo — nenhum pedido de administrador é aberto em segundo plano." />
                                </StackPanel>
                            </Expander>
                            <Grid>
                                <StackPanel Margin="0,16" Visibility="{Binding RuleRows.Count, Converter={StaticResource VisInv}}">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource EmptyIcon}" />
                                    <TextBlock Text="Nenhuma regra ainda" Style="{StaticResource T.H3}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Exemplo: deixar um jogo sempre com prioridade “Acima do normal”. O programa selecionado na lista é sugerido automaticamente."
                                               Style="{StaticResource T.WrapMuted}" FontSize="12" TextAlignment="Center" Margin="20,4,20,10" />
                                    <Button Style="{StaticResource Btn.Primary}" Content="Criar regra" Command="{Binding NewRuleCommand}" HorizontalAlignment="Center" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding RuleRows}" SelectedItem="{Binding SelectedRuleRow}" MinHeight="120" MaxHeight="360"
                                          Visibility="{Binding RuleRows.Count, Converter={StaticResource Vis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Programa" Binding="{Binding Rule.ExecutableName}" Width="1.4*" />
                                        <DataGridTextColumn Header="Prioridade" Binding="{Binding PriorityText}" Width="*" />
                                        <DataGridTextColumn Header="Núcleos" Binding="{Binding AffinityText}" Width="1.3*" />
                                        <DataGridTextColumn Header="Exceções" Binding="{Binding ExceptionsText}" Width="*" />
                                        <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Editor -->
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Editar regra" Style="{StaticResource T.H2}" Visibility="{Binding IsEditingExisting, Converter={StaticResource Vis}}" />
                            <TextBlock Text="Nova regra" Style="{StaticResource T.H2}" Visibility="{Binding IsEditingExisting, Converter={StaticResource VisInv}}" />
                            <TextBlock Text="PROGRAMA (NOME DO .EXE)" Style="{StaticResource DetailLabel}" Margin="0,12,0,4" />
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Tag="ex.: jogo.exe ou jogo*.exe" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="PRIORIDADE" Style="{StaticResource T.Overline}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding RulePriorityOptions}" SelectedItem="{Binding EditPriority}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="NÚCLEOS (AFINIDADE)" Style="{StaticResource T.Overline}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding RulePresetOptions}" SelectedItem="{Binding EditPreset}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Visibility="{Binding IsCustomMask, Converter={StaticResource Vis}}">
                                <TextBlock Text="MÁSCARA (HEXADECIMAL)" Style="{StaticResource DetailLabel}" Margin="0,10,0,4" />
                                <TextBox Text="{Binding EditMask, UpdateSourceTrigger=PropertyChanged}" Tag="ex.: 0x3F (CPUs 0–5)" FontFamily="{StaticResource F.Mono}" />
                            </StackPanel>
                            <CheckBox Content="Regra ligada" IsChecked="{Binding EditEnabled}" Margin="0,12,0,0" />
                            <Expander Margin="0,10,0,0">
                                <Expander.Header><TextBlock Text="Exceções e anotação" Style="{StaticResource T.Base}" Foreground="{StaticResource B.TextMuted}" FontSize="12.5" /></Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="NÃO APLICAR QUANDO O CAMINHO FOR (UM POR LINHA)" Style="{StaticResource T.Overline}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EditExceptions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" Height="64"
                                             VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource F.Mono}" FontSize="11.5" Tag="C:\Jogos\Launcher\*" />
                                    <TextBlock Text="ANOTAÇÃO" Style="{StaticResource DetailLabel}" Margin="0,10,0,4" />
                                    <TextBox Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}" Tag="Opcional" />
                                </StackPanel>
                            </Expander>
                            <TextBlock Text="{Binding EditPreview}" Style="{StaticResource T.WrapMuted}" FontSize="11.5" Margin="0,10,0,0"
                                       Visibility="{Binding EditPreview, Converter={StaticResource Vis}}" />
                            <Border Style="{StaticResource Callout.Danger}" Margin="0,8,0,0" Visibility="{Binding EditErrors, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding EditErrors}" Style="{StaticResource T.Wrap}" FontSize="12" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource Btn.Primary}" Content="Salvar regra" Command="{Binding SaveRuleCommand}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource Btn.Danger}" Content="Excluir" Command="{Binding DeleteRuleCommand}"
                                        Visibility="{Binding IsEditingExisting, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Padding="10,5" FontSize="12" Content="Limpar" Command="{Binding ClearRuleLogCommand}"
                                    Visibility="{Binding RuleLog.Count, Converter={StaticResource Vis}}" />
                            <StackPanel>
                                <TextBlock Text="O que as regras fizeram" Style="{StaticResource T.H3}" VerticalAlignment="Center" />
                                <TextBlock Text="Cada vez que uma regra é aplicada (ou falha), aparece aqui. Só desta sessão." Style="{StaticResource T.Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="Nada aplicado nesta sessão." Style="{StaticResource T.Muted}" Margin="0,10,0,0"
                                   Visibility="{Binding RuleLog.Count, Converter={StaticResource VisInv}}" />
                        <DataGrid ItemsSource="{Binding RuleLog}" MaxHeight="260" Margin="0,8,0,0" Visibility="{Binding RuleLog.Count, Converter={StaticResource Vis}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hora" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="80" />
                                <DataGridTextColumn Header="Programa" Binding="{Binding ProcessName}" Width="*" />
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                                <DataGridTextColumn Header="Ação" Binding="{Binding Action}" Width="*" />
                                <DataGridTemplateColumn Header="Resultado" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type pr:RuleActionLog}">
                                            <TextBlock Text="{Binding Message}" ToolTip="{Binding Message}" Style="{StaticResource T.Base}" FontSize="12"
                                                       Foreground="{Binding Success, Converter={StaticResource LevelBrush}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= ABA IMPACTO ================= -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Visibility="{Binding IsTabImpact, Converter={StaticResource Vis}}" VerticalAlignment="Stretch">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ShowTechColumns}" VerticalAlignment="Center" Margin="0,0,16,0"
                                      ToolTip="Mostra PID, tempo observado, crescimento do working set e notas da análise">
                            <TextBlock Text="Colunas técnicas" Style="{StaticResource T.Base}" FontSize="12.5" />
                        </ToggleButton>
                        <Button Style="{StaticResource SmallBtn}" Command="{Binding AnalyzeImpactCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Analisar agora" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Quem pesou mais nos últimos minutos" Style="{StaticResource T.H2}" />
                        <TextBlock Text="Programas que mais usaram CPU e disco enquanto esta página esteve aberta, e se a memória de algum só cresce (sinal de vazamento). Atualiza a cada 10 s."
                                   Style="{StaticResource T.Lead}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding ImpactSummary}" Style="{StaticResource T.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <Border Style="{StaticResource Callout.Warn}" Margin="0,8,0,0" Visibility="{Binding ImpactNotes, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding ImpactNotes}" Style="{StaticResource T.Wrap}" FontSize="12" />
                        </Border>
                        <Expander Style="{StaticResource Tech}" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="11.5"
                                       Text="CPU e E/S médias e de pico, e a tendência de memória (regressão linear) de cada processo na janela observada (até 5 min, amostras a cada 2 s). “Possível vazamento” só é marcado com janela ≥ 2 min, ≥ 6 amostras, crescimento ≥ 50 MB e ≥ 5 MB/min contínuo." />
                        </Expander>
                    </StackPanel>
                </DockPanel>
                <Grid Margin="0,12,0,0">
                    <StackPanel VerticalAlignment="Center" Visibility="{Binding ImpactRows.Count, Converter={StaticResource VisInv}}">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource EmptyIcon}" />
                        <TextBlock Text="Ainda sem medições suficientes" Style="{StaticResource T.H3}" HorizontalAlignment="Center" />
                        <TextBlock Text="Deixe esta aba aberta por alguns segundos — quanto mais tempo, mais confiável a análise."
                                   Style="{StaticResource T.Caption}" HorizontalAlignment="Center" Margin="0,4,0,10" />
                        <Button Style="{StaticResource SmallBtn}" Content="Analisar agora" Command="{Binding AnalyzeImpactCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding ImpactRows}" Visibility="{Binding ImpactRows.Count, Converter={StaticResource Vis}}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Programa" Width="1.6*" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type sp:ProcessImpactRow}">
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding ImagePath}">
                                            <Border Style="{StaticResource Chip.Danger}" Padding="7,1" Margin="0,0,6,0"
                                                    Visibility="{Binding PossibleLeak, Converter={StaticResource Vis}}"
                                                    ToolTip="A memória deste programa cresceu sem parar durante a observação">
                                                <TextBlock Text="memória crescendo" FontSize="10.5" Foreground="#FFFCA5A5" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontSize="12.5" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding AvgCpu, StringFormat={}{0:0.0}%}" SortMemberPath="AvgCpu" Width="84" ElementStyle="{StaticResource NumCell}">
                                <DataGridTextColumn.Header><TextBlock Text="CPU média" ToolTip="Média de uso do processador no período" /></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding PeakCpu, StringFormat={}{0:0.0}%}" SortMemberPath="PeakCpu" Width="80" ElementStyle="{StaticResource NumCell}">
                                <DataGridTextColumn.Header><TextBlock Text="CPU máx." ToolTip="Maior uso do processador medido no período" /></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding AvgIo}" Width="92" ElementStyle="{StaticResource NumCell}">
                                <DataGridTextColumn.Header><TextBlock Text="Disco (média)" ToolTip="Leitura + gravação média por segundo" /></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding PrivateEnd}" Width="88" ElementStyle="{StaticResource NumCell}">
                                <DataGridTextColumn.Header><TextBlock Text="Memória" ToolTip="Memória privada no fim do período" /></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding PrivateGrowth}" Width="120" ElementStyle="{StaticResource NumCell}">
                                <DataGridTextColumn.Header><TextBlock Text="Memória por minuto" ToolTip="Quanto a memória privada cresceu (+) ou caiu (−) por minuto (Δ Privada)" /></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="64" ElementStyle="{StaticResource NumCell}"
                                                Visibility="{Binding Data.ShowTechColumns, Source={StaticResource Proxy}, Converter={StaticResource Vis}}" />
                            <DataGridTextColumn Binding="{Binding WsGrowth}" Width="112" ElementStyle="{StaticResource NumCell}"
                                                Visibility="{Binding Data.ShowTechColumns, Source={StaticResource Proxy}, Converter={StaticResource Vis}}">
                                <DataGridTextColumn.Header><TextBlock Text="Δ WS" ToolTip="Tendência do working set (MB/min)" /></DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Observado" Binding="{Binding ObservedFor}" Width="90" ElementStyle="{StaticResource NumCell}"
                                                Visibility="{Binding Data.ShowTechColumns, Source={StaticResource Proxy}, Converter={StaticResource Vis}}" />
                            <DataGridTemplateColumn Header="Notas" Width="2*" Visibility="{Binding Data.ShowTechColumns, Source={StaticResource Proxy}, Converter={StaticResource Vis}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type sp:ProcessImpactRow}">
                                        <TextBlock Text="{Binding Notes}" ToolTip="{Binding Notes}" Style="{StaticResource T.Caption}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
