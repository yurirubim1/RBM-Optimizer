<UserControl x:Class="Rbm.UI.Views.LatencyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Rbm.UI.Controls"
             xmlns:vm="clr-namespace:Rbm.UI.ViewModels"
             xmlns:pa="clr-namespace:Rbm.UI.Pages.Analysis"
             xmlns:core="clr-namespace:Rbm.Core.Diagnostics;assembly=Rbm.Core">
    <UserControl.Resources>
        <pa:EqualsToBool x:Key="EqB" />
        <pa:EqualsToVisibility x:Key="EqV" />
        <pa:BrushKeyConverter x:Key="BK" />
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource T.H2}" />
        <Style x:Key="Bullet" TargetType="TextBlock" BasedOn="{StaticResource T.WrapMuted}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
        <Style x:Key="ToneChip" TargetType="Border" BasedOn="{StaticResource Chip.Info}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HeroTone}" Value="ok"><Setter Property="Background" Value="{StaticResource B.SuccessSoft}" /></DataTrigger>
                <DataTrigger Binding="{Binding HeroTone}" Value="warn"><Setter Property="Background" Value="{StaticResource B.WarningSoft}" /></DataTrigger>
                <DataTrigger Binding="{Binding HeroTone}" Value="danger"><Setter Property="Background" Value="{StaticResource B.DangerSoft}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToneText" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource B.Info}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HeroTone}" Value="ok"><Setter Property="Foreground" Value="{StaticResource B.Success}" /></DataTrigger>
                <DataTrigger Binding="{Binding HeroTone}" Value="warn"><Setter Property="Foreground" Value="{StaticResource B.Warning}" /></DataTrigger>
                <DataTrigger Binding="{Binding HeroTone}" Value="danger"><Setter Property="Foreground" Value="{StaticResource B.Danger}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="BulletItem">
            <DockPanel Margin="0,2">
                <TextBlock DockPanel.Dock="Left" Text="•" Style="{StaticResource T.Muted}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding}" Style="{StaticResource Bullet}" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="KvTile" DataType="{x:Type vm:LatencyKv}">
            <Border Style="{StaticResource CardInner}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource T.Caption}" />
                    <TextBlock Text="{Binding Value}" Style="{StaticResource T.H2}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource T.WrapMuted}" FontSize="11.5" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,16,20">
        <StackPanel>
            <!-- ===== Banner ===== -->
            <Border Style="{StaticResource Hero}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource B.AccentSoft}" VerticalAlignment="Top">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource T.Icon}" FontSize="24" Foreground="{StaticResource B.Cyan}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,20,0">
                        <Border Style="{StaticResource ToneChip}">
                            <TextBlock Text="{Binding HeroChip}" Style="{StaticResource ToneText}" />
                        </Border>
                        <TextBlock Text="Verifique se algum driver está causando travadas ou estalos no áudio" Style="{StaticResource T.H1}" FontSize="22" Margin="0,8,0,0"
                                   TextWrapping="Wrap" TextTrimming="None" />
                        <TextBlock Style="{StaticResource T.Lead}" Margin="0,4,0,0"
                                   Text="A análise observa o Windows por alguns segundos e mostra qual driver segura o processador por mais tempo. Use o PC normalmente enquanto ela roda — de preferência reproduzindo o problema." />
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsCapturing, Converter={StaticResource Vis}}" MaxWidth="520" HorizontalAlignment="Left">
                            <ProgressBar Maximum="1" Value="{Binding CaptureProgress, Mode=OneWay}" />
                            <TextBlock Text="{Binding CaptureStatus}" Style="{StaticResource T.Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="250">
                        <Button Style="{StaticResource Btn.Primary}" Padding="18,10" FontSize="14" Command="{Binding StartCaptureCommand}"
                                IsEnabled="{Binding IsCapturing, Converter={StaticResource Not}}"
                                ToolTip="Usa o agente elevado do RBM Optimizer (o Windows pede confirmação no primeiro uso). Nada é alterado no sistema.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="White" Margin="0,0,10,0" />
                                <TextBlock Text="Iniciar análise" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="requer administrador" Style="{StaticResource T.Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="Duração" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Width="90" ItemsSource="{Binding CaptureDurations}" SelectedItem="{Binding CaptureSeconds}" ItemStringFormat="{}{0} s"
                                      IsEnabled="{Binding IsCapturing, Converter={StaticResource Not}}" />
                            <TextBlock Text="s" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <Button Margin="0,8,0,0" Content="Parar de aguardar" Command="{Binding CancelCaptureCommand}" HorizontalAlignment="Center"
                                Visibility="{Binding IsCapturing, Converter={StaticResource Vis}}"
                                ToolTip="O agente não aceita cancelamento remoto: a sessão termina sozinha ao fim da duração e o resultado é descartado." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Aviso: não é input lag ===== -->
            <Border Style="{StaticResource Callout}" Margin="0,0,12,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource T.Icon}" Foreground="{StaticResource B.Info}" FontSize="14" Margin="0,2,12,0" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock Text="Bom saber: isto não mede o atraso do mouse ou do teclado (input lag)" Style="{StaticResource T.H3}" TextWrapping="Wrap" TextTrimming="None" />
                        <TextBlock Text="{Binding NotInputLag}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Abas ===== -->
            <Border Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,12,12" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="lat" Content="Atrasos de drivers (DPC/ISR)" IsChecked="{Binding Tab, Converter={StaticResource EqB}, ConverterParameter=dpc}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="lat" Content="Teste rápido (sem admin)" IsChecked="{Binding Tab, Converter={StaticResource EqB}, ConverterParameter=indicators}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="lat" Content="Resolução do timer" IsChecked="{Binding Tab, Converter={StaticResource EqB}, ConverterParameter=timer}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="lat" Content="Mouse e teclado (polling rate)" IsChecked="{Binding Tab, Converter={StaticResource EqB}, ConverterParameter=input}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="lat" Content="Interrupções MSI" IsChecked="{Binding Tab, Converter={StaticResource EqB}, ConverterParameter=msi}" />
                </StackPanel>
            </Border>

            <!-- =========================================================== DPC/ISR -->
            <StackPanel Visibility="{Binding Tab, Converter={StaticResource EqV}, ConverterParameter=dpc}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                    <StackPanel>
                        <!-- Estado vazio -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasReport, Converter={StaticResource VisInv}}">
                            <StackPanel Margin="0,18">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource EmptyIcon}" />
                                <TextBlock Text="Nenhuma análise aberta" Style="{StaticResource T.H2}" HorizontalAlignment="Center" />
                                <TextBlock Text="Clique em “Iniciar análise” no topo, ou escolha uma análise anterior no histórico. Sem permissão de administrador, use o teste rápido (mostra só médias, sem apontar o driver)."
                                           Style="{StaticResource T.WrapMuted}" TextAlignment="Center" MaxWidth="460" HorizontalAlignment="Center" Margin="0,4,0,12" />
                                <Button Content="Fazer o teste rápido" HorizontalAlignment="Center" Command="{Binding GoTabCommand}" CommandParameter="indicators" />
                            </StackPanel>
                        </Border>

                        <!-- Veredito em linguagem simples -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasReport, Converter={StaticResource Vis}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="5" CornerRadius="2" Background="{Binding VerdictBrush, Converter={StaticResource BK}}" Margin="0,0,14,0" />
                                <StackPanel>
                                    <Border Style="{StaticResource Chip}">
                                        <TextBlock Text="{Binding VerdictLabel, StringFormat=Resultado: {0}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding VerdictBrush, Converter={StaticResource BK}}" />
                                    </Border>
                                    <TextBlock Text="{Binding PlainVerdict}" Style="{StaticResource T.H1}" FontSize="20" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None" />
                                    <TextBlock Text="{Binding PlainDetail}" Style="{StaticResource T.Lead}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding ReportTitle}" Style="{StaticResource T.Caption}" Margin="0,8,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- O que fazer -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasReport, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Text="O que fazer" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Ligar um driver a picos é uma associação, não uma causa confirmada." Style="{StaticResource T.Caption}" Margin="0,2,0,8" />
                                <Border Style="{StaticResource Callout.Ok}" Visibility="{Binding Findings.Count, Converter={StaticResource VisInv}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="{StaticResource B.Success}" Margin="0,0,10,0" />
                                        <TextBlock Text="Nada a fazer: nenhum achado relevante nesta análise." Style="{StaticResource T.Wrap}" />
                                    </DockPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Findings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type core:Finding}">
                                            <Border Style="{StaticResource CardInner}" Margin="0,0,0,8" Padding="12,10">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{Binding Severity, Converter={StaticResource LevelBrush}}" Margin="0,0,10,0" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource T.H3}" TextWrapping="Wrap" TextTrimming="None" />
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,0" />
                                                        <TextBlock Style="{StaticResource T.Wrap}" FontSize="12.5" Margin="0,6,0,0" Visibility="{Binding Solution, Converter={StaticResource Vis}}">
                                                            <Run Text="O que fazer: " FontWeight="SemiBold" Foreground="{StaticResource B.Cyan}" /><Run Text="{Binding Solution, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <Expander Style="{StaticResource TechDetails}" Margin="0,6,0,0">
                                                            <Expander.Header><TextBlock Text="Por que achamos isso" Foreground="{StaticResource B.TextMuted}" FontSize="12" /></Expander.Header>
                                                            <StackPanel>
                                                                <Border Style="{StaticResource Chip.Warn}" Margin="0,0,0,4" Visibility="{Binding CorrelationOnly, Converter={StaticResource Vis}}">
                                                                    <TextBlock Text="Associação, não causa" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Warning}" />
                                                                </Border>
                                                                <ItemsControl ItemsSource="{Binding Evidence}" ItemTemplate="{StaticResource BulletItem}" />
                                                                <TextBlock Text="{Binding ProbableCause}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,0" />
                                                                <TextBlock Style="{StaticResource T.Caption}" Margin="0,4,0,0"
                                                                           Text="{Binding Confidence, Converter={StaticResource Pt}, StringFormat=Confiança: {0}}" Foreground="{Binding Confidence, Converter={StaticResource LevelBrush}}" />
                                                            </StackPanel>
                                                        </Expander>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Histórico -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="Análises anteriores" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Salvas neste PC. Clique para abrir." Style="{StaticResource T.Caption}" Margin="0,2,0,8" />
                                <StackPanel Visibility="{Binding History.Count, Converter={StaticResource VisInv}}" Margin="0,6">
                                    <TextBlock Text="&#xE81C;" Style="{StaticResource EmptyIcon}" />
                                    <TextBlock Text="Nenhuma análise salva ainda" Style="{StaticResource T.Muted}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" MaxHeight="320">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LatencyHistoryItem}">
                                        <Border Style="{StaticResource CardInner}" Padding="10,7">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource Btn.Icon}" Content="&#xE74D;" ToolTip="Excluir do histórico"
                                                        Command="{Binding DataContext.DeleteHistoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                                <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{Binding VerdictBrush, Converter={StaticResource BK}}" Margin="0,0,10,0" />
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource T.H3}">
                                                        <Run Text="{Binding VerdictLabel, Mode=OneWay}" Foreground="{Binding VerdictBrush, Converter={StaticResource BK}, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Title, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Caption}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ===== Detalhes do relatório ===== -->
                <StackPanel Visibility="{Binding HasReport, Converter={StaticResource Vis}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Atrasos por driver" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Do maior para o menor atraso. Passe o mouse no nome para ver o arquivo do driver." Style="{StaticResource T.Caption}" Margin="0,2,0,8" />
                            <DataGrid ItemsSource="{Binding Modules}" MaxHeight="320">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Driver" Width="1.4*" SortMemberPath="Module">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Module}" Style="{StaticResource T.H3}" ToolTip="{Binding ImagePath}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Category}" Width="*" />
                                    <DataGridTemplateColumn Header="Maior atraso" Width="110" SortMemberPath="Highest">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Highest}" FontWeight="SemiBold" Foreground="{Binding HighestBrush, Converter={StaticResource BK}}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="% do tempo" Binding="{Binding Share}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Expander Style="{StaticResource TechDetails}">
                                <Expander.Header><TextBlock Text="Detalhes técnicos (contagens, gráficos, execuções mais longas)" Foreground="{StaticResource B.TextMuted}" FontSize="12.5" /></Expander.Header>
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding ReportSummary}" ItemTemplate="{StaticResource KvTile}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding ThresholdsText}" Style="{StaticResource T.WrapMuted}" FontSize="11.5" Margin="0,10,0,12" />

                                    <TextBlock Text="Tabela completa por driver" Style="{StaticResource T.H3}" Margin="0,0,0,6" />
                                    <DataGrid ItemsSource="{Binding Modules}" MaxHeight="380">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Driver" Binding="{Binding Module}" Width="1.4*" />
                                            <DataGridTextColumn Header="DPC n" Binding="{Binding DpcCount, StringFormat=N0}" Width="75" />
                                            <DataGridTextColumn Header="DPC total" Binding="{Binding DpcTotal}" Width="85" />
                                            <DataGridTextColumn Header="DPC máx" Binding="{Binding DpcMax}" Width="85" />
                                            <DataGridTextColumn Header="DPC P99" Binding="{Binding DpcP99}" Width="80" />
                                            <DataGridTextColumn Header="ISR n" Binding="{Binding IsrCount, StringFormat=N0}" Width="70" />
                                            <DataGridTextColumn Header="ISR total" Binding="{Binding IsrTotal}" Width="85" />
                                            <DataGridTextColumn Header="ISR máx" Binding="{Binding IsrMax}" Width="85" />
                                            <DataGridTextColumn Header="ISR P99" Binding="{Binding IsrP99}" Width="80" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Distribuição das durações" Style="{StaticResource T.H3}" />
                                            <TextBlock Text="Escala logarítmica (as faixas raras e longas são as que importam)." Style="{StaticResource T.Caption}" Margin="0,2,0,8" TextWrapping="Wrap" />
                                            <TextBlock Text="DPC" Style="{StaticResource T.Overline}" />
                                            <c:BarChart Height="80" Margin="0,4,0,8" Values="{Binding DpcHistogram}" Labels="{Binding HistogramLabels}" Fill="{StaticResource B.Cyan}" />
                                            <TextBlock Text="ISR" Style="{StaticResource T.Overline}" />
                                            <c:BarChart Height="80" Margin="0,4,0,8" Values="{Binding IsrHistogram}" Labels="{Binding HistogramLabels}" Fill="{StaticResource B.Violet}" />
                                            <ItemsControl ItemsSource="{Binding Buckets}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:LatencyBucketRow}">
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label, StringFormat={}{0} µs}" Style="{StaticResource T.Caption}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Dpc, StringFormat=DPC {0:N0}}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Cyan}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Isr, StringFormat=ISR {0:N0}}" Style="{StaticResource T.Caption}" Foreground="{StaticResource B.Violet}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Linha do tempo (pico por segundo)" Style="{StaticResource T.H3}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource B.Cyan}" Margin="0,0,6,0" /><TextBlock Text="Máx. DPC" Style="{StaticResource T.Caption}" Margin="0,0,14,0" />
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource B.Violet}" Margin="0,0,6,0" /><TextBlock Text="Máx. ISR" Style="{StaticResource T.Caption}" />
                                            </StackPanel>
                                            <c:LineChart Height="180" Series="{Binding Timeline}" Capacity="{Binding TimelineCapacity}" Unit=" µs" />
                                            <TextBlock Text="Carga DPC+ISR por CPU lógica (% do tempo)" Style="{StaticResource T.Overline}" Margin="0,14,0,0" />
                                            <c:BarChart Height="70" Margin="0,4,0,0" Values="{Binding PerCpuPercent}" Fill="{StaticResource B.CyanGradient}" />
                                            <TextBlock Text="{Binding PerCpuText}" Style="{StaticResource T.WrapMuted}" FontSize="11.5" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Execuções mais longas" Style="{StaticResource T.H3}" Margin="0,14,0,6" />
                                    <DataGrid ItemsSource="{Binding TopExecutions}" MaxHeight="320">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="55" />
                                            <DataGridTextColumn Header="Driver" Binding="{Binding Module}" Width="*" />
                                            <DataGridTemplateColumn Header="Duração" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Duration}" FontWeight="SemiBold" Foreground="{Binding DurationBrush, Converter={StaticResource BK}}" /></DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Momento" Binding="{Binding When}" Width="150" />
                                            <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="50" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Text="Avisos da captura" Style="{StaticResource T.H3}" Margin="0,14,0,0" Visibility="{Binding ReportWarnings.Count, Converter={StaticResource Vis}}" />
                                    <ItemsControl ItemsSource="{Binding ReportWarnings}" ItemTemplate="{StaticResource BulletItem}" Margin="0,4,0,0" />
                                    <TextBlock Text="Limitações" Style="{StaticResource T.H3}" Margin="0,10,0,0" />
                                    <ItemsControl ItemsSource="{Binding ReportLimitations}" ItemTemplate="{StaticResource BulletItem}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- =========================================================== Teste rápido -->
            <StackPanel Visibility="{Binding Tab, Converter={StaticResource EqV}, ConverterParameter=indicators}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <ComboBox Width="90" ItemsSource="{Binding IndicatorDurations}" SelectedItem="{Binding IndicatorSeconds}" ItemStringFormat="{}{0} s"
                                          IsEnabled="{Binding IsSampling, Converter={StaticResource Not}}" />
                                <Button Style="{StaticResource Btn.Primary}" Margin="10,0,0,0" Content="Medir agora" Command="{Binding SampleIndicatorsCommand}"
                                        IsEnabled="{Binding IsSampling, Converter={StaticResource Not}}" />
                                <Button Margin="8,0,0,0" Content="Cancelar" Command="{Binding CancelSamplingCommand}" Visibility="{Binding IsSampling, Converter={StaticResource Vis}}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Teste rápido (sem administrador)" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource T.Lead}" FontSize="12.5" Margin="0,2,0,0"
                                           Text="Uma checagem de poucos segundos usando os contadores do próprio Windows. Mostra se o processador está gastando tempo demais com drivers, mas não aponta qual — para isso use a análise completa." />
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar Margin="0,12,0,0" Maximum="1" Value="{Binding SamplingProgress, Mode=OneWay}" Visibility="{Binding IsSampling, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Visibility="{Binding HasIndicators, Converter={StaticResource VisInv}}">
                    <StackPanel Margin="0,12">
                        <TextBlock Text="&#xEC4A;" Style="{StaticResource EmptyIcon}" />
                        <TextBlock Text="Nenhuma medição ainda" Style="{StaticResource T.H3}" HorizontalAlignment="Center" />
                        <TextBlock Text="Clique em “Medir agora”. Leva só alguns segundos e é leve." Style="{StaticResource T.Caption}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <StackPanel Visibility="{Binding HasIndicators, Converter={StaticResource Vis}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding IndicatorInterpretation}" Style="{StaticResource T.Wrap}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding IndicatorValues}" ItemTemplate="{StaticResource KvTile}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="% do tempo a cada segundo" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource B.Cyan}" Margin="0,0,6,0" /><TextBlock Text="% DPC" Style="{StaticResource T.Caption}" Margin="0,0,14,0" />
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource B.Violet}" Margin="0,0,6,0" /><TextBlock Text="% interrupção" Style="{StaticResource T.Caption}" />
                                </StackPanel>
                                <c:LineChart Height="180" Series="{Binding IndicatorSeries}" Capacity="{Binding IndicatorCapacity}" Unit="%" LabelFormat="0.##" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Por núcleo do processador" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Picos acima de 10% destacados." Style="{StaticResource T.Caption}" Margin="0,2,0,8" />
                                <DataGrid ItemsSource="{Binding IndicatorPerCpu}" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="60" />
                                        <DataGridTextColumn Header="DPC médio" Binding="{Binding DpcMean}" Width="*" />
                                        <DataGridTextColumn Header="DPC pico" Binding="{Binding DpcMax}" Width="*" />
                                        <DataGridTextColumn Header="Int. médio" Binding="{Binding IntMean}" Width="*" />
                                        <DataGridTemplateColumn Header="Int. pico" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding IntMax}" Foreground="{Binding Brush, Converter={StaticResource BK}}" /></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource Card}">
                        <Expander Style="{StaticResource TechDetails}" Margin="0">
                            <Expander.Header><TextBlock Text="Limitações deste teste" Foreground="{StaticResource B.TextMuted}" FontSize="12.5" /></Expander.Header>
                            <ItemsControl ItemsSource="{Binding IndicatorLimitations}" ItemTemplate="{StaticResource BulletItem}" />
                        </Expander>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- =========================================================== Timer -->
            <StackPanel Visibility="{Binding Tab, Converter={StaticResource EqV}, ConverterParameter=timer}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource Btn.Icon}" Content="&#xE72C;" ToolTip="Atualizar" Command="{Binding RefreshTimerCommand}" />
                                <TextBlock Text="Resolução do timer do Windows" Style="{StaticResource SectionTitle}" />
                            </DockPanel>
                            <TextBlock Text="De quanto em quanto tempo o Windows “acorda” para agendar tarefas. Valores menores são pedidos por jogos e players de vídeo." Style="{StaticResource T.Lead}" FontSize="12.5" Margin="0,2,0,12" />
                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource CardInner}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Agora" Style="{StaticResource T.Caption}" />
                                        <TextBlock Text="{Binding TimerCurrent}" Style="{StaticResource T.Metric}" FontSize="22" Foreground="{StaticResource B.Cyan}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardInner}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Mais fina possível" Style="{StaticResource T.Caption}" />
                                        <TextBlock Text="{Binding TimerFinest}" Style="{StaticResource T.Metric}" FontSize="22" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardInner}">
                                    <StackPanel>
                                        <TextBlock Text="Padrão do Windows" Style="{StaticResource T.Caption}" />
                                        <TextBlock Text="{Binding TimerCoarsest}" Style="{StaticResource T.Metric}" FontSize="22" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource T.Muted}" FontSize="12" TextWrapping="Wrap">
                                <Run Text="GlobalTimerResolutionRequests (somente leitura):" /> <Run Text="{Binding TimerGlobalRequests, Mode=OneWay}" Foreground="{StaticResource B.Text}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Como o Windows trata isso" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding TimerExplanation}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,6,0,8" />
                            <Expander Style="{StaticResource TechDetails}">
                                <Expander.Header><TextBlock Text="Referências" Foreground="{StaticResource B.TextMuted}" FontSize="12.5" /></Expander.Header>
                                <ItemsControl ItemsSource="{Binding TimerReferences}" ItemTemplate="{StaticResource BulletItem}" />
                            </Expander>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Quais programas estão pedindo um timer mais rápido (opcional)" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Callout.Warn}" Margin="0,8,0,12">
                            <TextBlock Style="{StaticResource T.Wrap}" FontSize="12"
                                       Text="Usa &quot;powercfg /energy&quot; no agente elevado (UAC). O comando roda durante TODA a duração escolhida e o agente fica ocupado até terminar (mais até ~2 min de análise). Outras operações administrativas aguardam nesse período." />
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Duração" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox Width="90" ItemsSource="{Binding TimerRequestDurations}" SelectedItem="{Binding TimerRequestSeconds}" ItemStringFormat="{}{0} s"
                                      IsEnabled="{Binding IsCollectingTimers, Converter={StaticResource Not}}" />
                            <Button Style="{StaticResource Btn.Primary}" Margin="12,0,0,0" Content="Descobrir programas" Command="{Binding CollectTimerRequestsCommand}"
                                    IsEnabled="{Binding IsCollectingTimers, Converter={StaticResource Not}}" />
                            <Button Margin="8,0,0,0" Content="Parar de aguardar" Command="{Binding CancelTimerRequestsCommand}" Visibility="{Binding IsCollectingTimers, Converter={StaticResource Vis}}" />
                        </StackPanel>
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsCollectingTimers, Converter={StaticResource Vis}}">
                            <ProgressBar Maximum="1" Value="{Binding TimerProgress, Mode=OneWay}" />
                            <TextBlock Text="{Binding TimerStatus}" Style="{StaticResource T.Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding HasTimerRequests, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding TimerPlatformCurrent}" Style="{StaticResource T.H3}" />
                            <DataGrid ItemsSource="{Binding TimerRequests}" Margin="0,8,0,0" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" />
                                    <DataGridTextColumn Header="Programa" Binding="{Binding Path}" Width="*" />
                                    <DataGridTextColumn Header="Pediu" Binding="{Binding Period}" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <ItemsControl ItemsSource="{Binding TimerWarnings}" ItemTemplate="{StaticResource BulletItem}" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- =========================================================== Mouse e teclado -->
            <StackPanel Visibility="{Binding Tab, Converter={StaticResource EqV}, ConverterParameter=input}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Command="{Binding TogglePollingCommand}" Padding="14,7">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                                        <Setter Property="Content" Value="Iniciar teste" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPolling}" Value="True">
                                                <Setter Property="Content" Value="Parar teste" />
                                                <Setter Property="Background" Value="{StaticResource B.Surface3}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource B.BorderStrong}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="Taxa de atualização do mouse (polling rate)" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Quantas vezes por segundo o mouse informa a posição ao PC. Clique em Iniciar e mova o mouse em círculos rápidos por 5–10 s." Style="{StaticResource T.Lead}" FontSize="12.5" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding PollingStatus}" Style="{StaticResource T.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Polling}" Margin="0,10,0,0" Visibility="{Binding Polling.Count, Converter={StaticResource Vis}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Dispositivo" Width="1.6*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Device}" Style="{StaticResource T.H3}" ToolTip="{Binding Notes}" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Taxa medida" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Rate}" FontWeight="SemiBold" Foreground="{StaticResource B.Cyan}" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Padrão mais próximo" Binding="{Binding Nearest}" Width="140" />
                                <DataGridTextColumn Header="Estabilidade" Binding="{Binding Stability}" Width="100" />
                                <DataGridTemplateColumn Header="Confiança" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Confidence}" Foreground="{Binding ConfidenceBrush, Converter={StaticResource BK}}" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Intervalo mediano" Binding="{Binding Median}" Width="120" />
                                <DataGridTextColumn Header="P99" Binding="{Binding P99}" Width="80" />
                                <DataGridTextColumn Header="Intervalos" Binding="{Binding Intervals, StringFormat=N0}" Width="85" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Expander Style="{StaticResource TechDetails}">
                            <Expander.Header><TextBlock Text="Como interpretar" Foreground="{StaticResource B.TextMuted}" FontSize="12.5" /></Expander.Header>
                            <TextBlock Text="{Binding PollingNote}" Style="{StaticResource T.WrapMuted}" FontSize="11.5" />
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Atualizar" Command="{Binding RefreshInputCommand}" Padding="10,5" FontSize="12" />
                        <StackPanel>
                            <TextBlock Text="Economia de energia das portas USB (suspensão seletiva)" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" TextTrimming="None" />
                            <TextBlock Text="{Binding GlobalSuspend}" Style="{StaticResource T.H3}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding GlobalSuspendDetail}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Mouses, teclados e controles conectados" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Somente leitura. O selo à direita mostra se o Windows pode desligar o dispositivo para economizar energia." Style="{StaticResource T.Caption}" Margin="0,2,0,10" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding InputDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InputDeviceRow}">
                                    <Border Style="{StaticResource CardInner}" Margin="0,0,0,8" Padding="12,9">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}">
                                                    <TextBlock Text="{Binding PowerState}" Style="{StaticResource T.Caption}" Foreground="{Binding PowerBrush, Converter={StaticResource BK}}" />
                                                </Border>
                                                <TextBlock Style="{StaticResource T.H3}" ToolTip="{Binding Instance}">
                                                    <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  ·  " Foreground="{StaticResource B.TextFaint}" /><Run Text="{Binding Category, Mode=OneWay}" Foreground="{StaticResource B.TextMuted}" />
                                                </TextBlock>
                                            </DockPanel>
                                            <TextBlock Text="{Binding PowerText}" Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,0" />
                                            <TextBlock Style="{StaticResource T.Caption}" Margin="0,4,0,0" ToolTip="{Binding Chain}">
                                                <Run Text="{Binding Bus, Mode=OneWay}" /><Run Text=" · serviço " /><Run Text="{Binding Service, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Chain, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding InputNotes}" ItemTemplate="{StaticResource BulletItem}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- =========================================================== MSI -->
            <StackPanel Visibility="{Binding Tab, Converter={StaticResource EqV}, ConverterParameter=msi}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Atualizar" Command="{Binding RefreshMsiCommand}" Padding="10,5" FontSize="12" />
                            <StackPanel>
                                <TextBlock Text="Interrupções MSI" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Como cada placa (vídeo, rede, áudio, USB…) avisa o processador. O modo moderno (MSI) costuma ser mais eficiente que o antigo por linha (INTx)." Style="{StaticResource T.Lead}" FontSize="12.5" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding MsiSummary}" Style="{StaticResource T.H3}" Margin="0,8,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,8,0,10"
                                   Text="Somente leitura. Para mudar o modo, use o catálogo de Otimizações (com ponto de restauração e opção de desfazer)." />
                        <DataGrid ItemsSource="{Binding MsiDevices}" MaxHeight="520">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Dispositivo" Width="1.6*" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource T.H3}" ToolTip="{Binding Interpretation}" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Category}" Width="120" />
                                <DataGridTemplateColumn Header="Modo atual" Width="110" SortMemberPath="Mode">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Mode}" FontWeight="SemiBold" Foreground="{Binding ModeBrush, Converter={StaticResource BK}}" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="O que significa" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Interpretation}" Style="{StaticResource T.Muted}" FontSize="12" ToolTip="{Binding Interpretation}" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Expander Style="{StaticResource TechDetails}">
                            <Expander.Header><TextBlock Text="Detalhes técnicos (MSISupported, limite, política, IRQs)" Foreground="{StaticResource B.TextMuted}" FontSize="12.5" /></Expander.Header>
                            <StackPanel>
                                <TextBlock Text="O modo efetivo vem das IRQs alocadas (MSI aparecem como números negativos)." Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding MsiDevices}" MaxHeight="420">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Dispositivo" Binding="{Binding Name}" Width="1.6*" />
                                        <DataGridTextColumn Header="MSISupported" Binding="{Binding MsiSupported}" Width="100" />
                                        <DataGridTextColumn Header="Limite msg." Binding="{Binding Limit}" Width="85" />
                                        <DataGridTextColumn Header="Política" Binding="{Binding Policy}" Width="*" />
                                        <DataGridTextColumn Header="Prioridade" Binding="{Binding Priority}" Width="90" />
                                        <DataGridTextColumn Header="IRQs" Binding="{Binding Irqs}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ItemsControl ItemsSource="{Binding MsiNotes}" ItemTemplate="{StaticResource BulletItem}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
