<UserControl x:Class="Rbm.UI.Views.PowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Rbm.UI.Controls"
             xmlns:vm="clr-namespace:Rbm.UI.ViewModels"
             xmlns:hw="clr-namespace:Rbm.UI.Pages.Hardware">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RBMOptimizer;component/Pages/Hardware/HwResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,16,20">
        <StackPanel>
            <!-- ===== Resumo ===== -->
            <Border Style="{StaticResource Hero}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Content="Otimizações de energia" Style="{StaticResource Hw.HeroPrimary}" Command="{x:Static hw:HwNav.Go}" CommandParameter="optimizations"
                                ToolTip="Ajustes de energia e do processador com evidência, risco e reversão." />
                        <Button Content="Opções de Energia do Windows" Style="{StaticResource Hw.HeroButton}" Command="{Binding OpenPowerOptionsCommand}"
                                ToolTip="Abre o Painel de Controle › Opções de Energia." />
                    </StackPanel>
                    <ContentControl Content="{Binding Hero}" Focusable="False" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Callout}" Margin="0,0,12,12" Visibility="{Binding SensorMissing, Converter={StaticResource Vis}}" ToolTip="{Binding SensorReason}">
                <DockPanel>
                    <TextBlock Text="&#xE946;" Style="{StaticResource T.Icon}" Foreground="{StaticResource B.Info}" FontSize="15" VerticalAlignment="Top" Margin="0,2,10,0" />
                    <StackPanel>
                        <TextBlock Text="Algumas temperaturas não estão disponíveis" Style="{StaticResource T.H3}" />
                        <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12.5" Margin="0,2,0,0"
                                   Text="A temperatura e o consumo do processador (e a temperatura dos discos) exigem o driver de sensores PawnIO e o RBM rodando como administrador. Sem leitura real, nada é estimado. Passe o mouse aqui para ver o status dos sensores." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <UniformGrid Columns="4">
                <ContentControl Content="{Binding PlanFact}" Focusable="False" />
                <ContentControl Content="{Binding SourceFact}" Focusable="False" />
                <ContentControl Content="{Binding LimitFact}" Focusable="False" />
                <ContentControl Content="{Binding TempFact}" Focusable="False" />
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <!-- ===== Planos ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Atualizar" Command="{Binding RefreshPlansCommand}" Style="{StaticResource Hw.SmallButton}" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="Planos de energia" Style="{StaticResource T.H2}" />
                                <TextBlock Text="{Binding PlanStatus}" Style="{StaticResource T.Muted}" FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="O plano em uso aparece primeiro. Equilibrado é o recomendado na maioria dos casos: acelera sob carga e economiza em repouso."
                                   Style="{StaticResource T.Lead}" FontSize="12.5" Margin="0,8,0,10" />
                        <ItemsControl ItemsSource="{Binding Plans}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PlanRow}">
                                    <Border Padding="12,9" Margin="0,0,0,6" CornerRadius="8" Background="{StaticResource B.Surface2}" ToolTip="{Binding GuidText}" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource B.Accent}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                                <Button Content="Ativar" Style="{StaticResource Hw.SmallButton}"
                                                        Command="{Binding DataContext.ActivatePlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding CanActivate, Converter={StaticResource Vis}}" />
                                                <Border Style="{StaticResource Chip.Ok}" Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="Em uso" Foreground="{StaticResource B.Success}" FontSize="11.5" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.H3}" />
                                                <TextBlock Text="{Binding Hint}" Style="{StaticResource T.WrapMuted}" FontSize="12" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,6,0,0"
                                   Text="Ativar um plano pede confirmação, vale na hora e pode ser desfeito ativando o anterior. Ajustes finos do processador ficam na página Processador (leitura) e em Otimizações (alteração com reversão)." />
                    </StackPanel>
                </Border>
                <!-- ===== Alimentação ===== -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Alimentação" Style="{StaticResource T.H2}" />
                            <TextBlock Text="Atualizado continuamente." Style="{StaticResource T.Muted}" FontSize="12" Margin="0,0,0,10" ToolTip="GetSystemPowerStatus, lido a cada amostra de telemetria." />
                            <Border Style="{StaticResource Hw.Stat}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Fonte" Style="{StaticResource T.Muted}" FontSize="12" />
                                    <TextBlock Text="{Binding AcText}" Style="{StaticResource T.H3}" FontSize="14" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Hw.Stat}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Bateria" Style="{StaticResource T.Muted}" FontSize="12" />
                                    <TextBlock Text="{Binding BatteryText}" Style="{StaticResource T.Wrap}" FontWeight="SemiBold" Margin="0,3,0,0" />
                                    <ProgressBar Maximum="100" Value="{Binding BatteryPct, Mode=OneWay}" Margin="0,6,0,0" Visibility="{Binding HasBattery, Converter={StaticResource Vis}}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding SaverText}" Style="{StaticResource T.Wrap}" Foreground="{StaticResource B.Warning}" FontSize="12.5"
                                       Visibility="{Binding SaverText, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Antes de aumentar limites de energia" Style="{StaticResource T.H2}" />
                            <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12.5" Margin="0,8,0,0"
                                       Text="Mais potência vira mais calor. Se o processador ou a placa de vídeo já chegam ao limite de temperatura, aumentar limites de energia (PL1/PL2, PPT, power limit) não ganha desempenho: o chip só esquenta antes e reduz a velocidade. Cuide primeiro da refrigeração — poeira nos dissipadores e filtros, ventoinhas, fluxo de ar do gabinete e pasta térmica. Em notebooks, use uma superfície rígida e o modo de desempenho do fabricante." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== Limitação ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Limitação de desempenho do processador (throttling)" Style="{StaticResource T.H2}" />
                    <TextBlock Text="100% = sem limitação. Abaixo disso o processador está sendo contido por calor, limite de energia ou pela placa-mãe." Style="{StaticResource T.Lead}" FontSize="12.5"
                               ToolTip="Contador % Performance Limit (limites térmicos, de energia PL/PPT/EDC ou da plataforma)." />
                    <TextBlock Text="{Binding LimitStatus}" Style="{StaticResource T.H3}" Foreground="{Binding LimitBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding LimitLegend}" Style="{StaticResource Hw.LegendList}" />
                    <c:LineChart Height="130" Series="{Binding LimitChart}" Maximum="100" Unit="%" Visibility="{Binding LimitAvailable, Converter={StaticResource Vis}}" />
                </StackPanel>
            </Border>

            <!-- ===== Temperaturas ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Temperaturas" Style="{StaticResource T.H2}" />
                    <TextBlock Text="Somente leituras reais de sensores. Referência: até ~70 °C normal, 70–85 °C morna, acima de 85 °C quente (sob carga pesada pode ser esperado)." Style="{StaticResource T.Lead}" FontSize="12.5" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding TempPanels}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
