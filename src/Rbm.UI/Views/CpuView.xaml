<UserControl x:Class="Rbm.UI.Views.CpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Rbm.UI.Controls"
             xmlns:vm="clr-namespace:Rbm.UI.ViewModels"
             xmlns:hw="clr-namespace:Rbm.UI.Pages.Hardware">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RBMOptimizer;component/Pages/Hardware/HwResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,16,20">
        <StackPanel>
            <!-- ===== Resumo ===== -->
            <Border Style="{StaticResource Hero}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button Content="Ver o que está usando" Style="{StaticResource Hw.HeroPrimary}" Command="{x:Static hw:HwNav.Go}" CommandParameter="processes"
                                ToolTip="Abre a página Processos, com todos os programas em execução." />
                        <Button Content="Energia e temperatura" Style="{StaticResource Hw.HeroButton}" Command="{x:Static hw:HwNav.Go}" CommandParameter="power"
                                ToolTip="Plano de energia, limitação de desempenho e temperaturas." />
                    </StackPanel>
                    <ContentControl Content="{Binding Hero}" Focusable="False" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Callout}" Margin="0,0,12,12" Visibility="{Binding SensorMissing, Converter={StaticResource Vis}}" ToolTip="{Binding SensorReason}">
                <DockPanel>
                    <TextBlock Text="&#xE946;" Style="{StaticResource T.Icon}" Foreground="{StaticResource B.Info}" FontSize="15" VerticalAlignment="Top" Margin="0,2,10,0" />
                    <StackPanel>
                        <TextBlock Text="A temperatura do processador não está disponível" Style="{StaticResource T.H3}" />
                        <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12.5" Margin="0,2,0,0"
                                   Text="Para ler temperatura e consumo do processador, o Windows exige um driver de sensores (PawnIO) e que o RBM rode como administrador. O restante da página funciona normalmente." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <UniformGrid Columns="4">
                <ContentControl Content="{Binding LoadFact}" Focusable="False" />
                <ContentControl Content="{Binding ClockFact}" Focusable="False" />
                <ContentControl Content="{Binding LimitFact}" Focusable="False" />
                <ContentControl Content="{Binding TempFact}" Focusable="False" />
            </UniformGrid>

            <!-- ===== Uso por núcleo ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding LoadText}" Style="{StaticResource T.Muted}" FontSize="12.5" VerticalAlignment="Center" />
                        <TextBlock Text="Uso de cada núcleo" Style="{StaticResource T.H2}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource T.Lead}" FontSize="12.5" Margin="0,2,0,0"
                               Text="Cada barra é uma thread do processador. Uma única barra sempre cheia indica um programa que não aproveita vários núcleos (comum em jogos)." />
                    <c:BarChart Height="120" Margin="0,12,0,0" Values="{Binding ThreadLoads}" Labels="{Binding ThreadLabels}" Maximum="100" Fill="{StaticResource B.CyanGradient}"
                                ToolTip="% Processor Utility por processador lógico (o número abaixo de cada barra é o índice da thread)." />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <!-- ===== Velocidade ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Velocidade ao longo do tempo" Style="{StaticResource T.H2}" />
                        <TextBlock Text="Acima da linha de base = turbo ativo. Abaixo = economizando energia em repouso." Style="{StaticResource T.Lead}" FontSize="12.5" />
                        <ItemsControl ItemsSource="{Binding ClockLegend}" Style="{StaticResource Hw.LegendList}" />
                        <c:LineChart Height="140" Series="{Binding ClockChart}" Visibility="{Binding ClockAvailable, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Border>
                <!-- ===== Limitação ===== -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LimitText}" Style="{StaticResource T.H2}" Foreground="{Binding LimitBrush}" />
                            <TextBlock Text="Limitação de desempenho (throttling)" Style="{StaticResource T.H2}" />
                        </DockPanel>
                        <TextBlock Text="100% = sem limitação. Abaixo disso, calor ou limite de energia estão segurando o processador." Style="{StaticResource T.Lead}" FontSize="12.5" />
                        <TextBlock Text="{Binding LimitStatus}" Style="{StaticResource T.Wrap}" Foreground="{Binding LimitBrush}" FontSize="12.5" Margin="0,8,0,6" />
                        <c:LineChart Height="120" Series="{Binding LimitChart}" Maximum="100" Unit="%" Visibility="{Binding LimitAvailable, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <!-- ===== Processos ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Programas que mais usam o processador" Style="{StaticResource T.H2}" />
                        <TextBlock Text="{Binding ProcStatus}" ToolTip="{Binding ProcTip}" Style="{StaticResource T.Muted}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                        <DataGrid ItemsSource="{Binding TopProcs}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Programa" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" SortMemberPath="CpuSort" Width="70" />
                                <DataGridTextColumn Header="Memória" Binding="{Binding WsText}" SortMemberPath="WorkingSet" Width="95" />
                                <DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="70" />
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="64" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <!-- ===== Sobre o processador ===== -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sobre este processador" Style="{StaticResource T.H2}" />
                        <TextBlock Text="{Binding CpuName}" Style="{StaticResource T.Muted}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,8" />
                        <ItemsControl ItemsSource="{Binding Identity}" ItemTemplate="{StaticResource Hw.InfoRowCompact}" />
                        <TextBlock Text="Passe o mouse sobre cada item para ver o que significa." Style="{StaticResource T.Caption}" FontSize="11.5" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Plano de energia (processador) ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Atualizar" Command="{Binding RefreshPlanCommand}" Style="{StaticResource Hw.SmallButton}" Margin="0,0,8,0" ToolTip="Relê os valores do plano ativo." />
                            <Button Content="Ajustar em Otimizações" Command="{Binding GoOptimizationsCommand}" Style="{StaticResource Btn.Primary}" Padding="12,5" FontSize="12"
                                    ToolTip="Alterações são feitas pelo catálogo de Otimizações, com evidência, risco e reversão." />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Como o Windows controla o processador" Style="{StaticResource T.H2}" />
                            <TextBlock Style="{StaticResource T.Muted}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap"><Run Text="Configurações do plano de energia ativo" /> <Run Text="{Binding PlanName, Mode=OneWay}" Foreground="{StaticResource B.Text}" /> <Run Text="(somente leitura)" /></TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding PlanRows}" ItemTemplate="{StaticResource Hw.InfoRow}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding PlanStatus}" Style="{StaticResource T.Caption}" FontSize="11.5" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- ===== Detalhes técnicos ===== -->
            <Border Style="{StaticResource Card}">
                <Expander Style="{StaticResource TechDetails}" Margin="0">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="Topologia" Style="{StaticResource T.H3}" />
                        <TextBlock Text="{Binding TopologySummary}" Style="{StaticResource T.Caption}" FontSize="11.5" Margin="0,2,0,10" TextWrapping="Wrap" TextTrimming="None" />
                        <ItemsControl ItemsSource="{Binding Cores}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CoreTile}">
                                    <Border Width="112" Margin="0,0,8,8" Padding="10,8" CornerRadius="8" Background="{StaticResource B.Surface2}"
                                            BorderBrush="{Binding Accent}" BorderThickness="0,3,0,0" ToolTip="{Binding Tip}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource T.H3}" FontSize="12.5" />
                                            <TextBlock Text="{Binding Threads}" Style="{StaticResource T.Caption}" />
                                            <TextBlock Style="{StaticResource T.Caption}" Foreground="{Binding Accent}">
                                                <Run Text="{Binding Tag, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Cache, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource Hw.Note}" Margin="0,2,0,0">
                            <TextBlock Text="{Binding TopologyHint}" Style="{StaticResource T.WrapMuted}" FontSize="12" />
                        </Border>

                        <TextBlock Text="Agendador e interrupções" Style="{StaticResource T.H3}" Margin="0,16,0,8" />
                        <UniformGrid Columns="5">
                            <Border Style="{StaticResource Hw.Stat}" ToolTip="Processor Queue Length: threads prontas aguardando CPU. Valores sustentados acima de ~2 por núcleo indicam saturação.">
                                <StackPanel><TextBlock Text="FILA DO PROCESSADOR" Style="{StaticResource T.Overline}" /><TextBlock Text="{Binding QueueText}" Style="{StaticResource T.H3}" FontSize="15" Margin="0,3,0,0" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Hw.Stat}" ToolTip="Context Switches/sec: trocas entre threads por segundo. Picos altos com CPU baixa podem indicar drivers/serviços muito ativos.">
                                <StackPanel><TextBlock Text="TROCAS DE CONTEXTO" Style="{StaticResource T.Overline}" /><TextBlock Text="{Binding CtxText}" Style="{StaticResource T.H3}" FontSize="15" Margin="0,3,0,0" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Hw.Stat}" ToolTip="Interrupts/sec de hardware.">
                                <StackPanel><TextBlock Text="INTERRUPÇÕES" Style="{StaticResource T.Overline}" /><TextBlock Text="{Binding IntText}" Style="{StaticResource T.H3}" FontSize="15" Margin="0,3,0,0" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Hw.Stat}" ToolTip="% DPC Time / % Interrupt Time. Valores persistentes acima de ~1–2% merecem investigação na página Latência.">
                                <StackPanel>
                                    <TextBlock Text="DPC / ISR" Style="{StaticResource T.Overline}" />
                                    <TextBlock Style="{StaticResource T.H3}" FontSize="15" Margin="0,3,0,0"><Run Text="{Binding DpcText, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding IsrText, Mode=OneWay}" /></TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Hw.Stat}" ToolTip="Temperatura e potência do pacote via LibreHardwareMonitor.">
                                <StackPanel>
                                    <TextBlock Text="TEMPERATURA / POTÊNCIA" Style="{StaticResource T.Overline}" />
                                    <TextBlock Style="{StaticResource T.H3}" FontSize="15" Margin="0,3,0,0" TextWrapping="Wrap"><Run Text="{Binding TempText, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding PowerText, Mode=OneWay}" /></TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="Como os números são obtidos" Style="{StaticResource T.H3}" Margin="0,12,0,4" />
                        <TextBlock Style="{StaticResource T.WrapMuted}" FontSize="12"
                                   Text="Identificação: WMI (Win32_Processor) e GetLogicalProcessorInformationEx. Uso por thread: % Processor Utility por processador lógico. Velocidade (clock efetivo): clock base × % Processor Performance (_Total) — o mesmo método do Gerenciador de Tarefas; é uma média de todos os núcleos, não a frequência instantânea de cada um. Limitação: contador % Performance Limit. Temperatura e potência: LibreHardwareMonitor." />
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
