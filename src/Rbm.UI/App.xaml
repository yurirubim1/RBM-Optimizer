<Application x:Class="Rbm.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:Rbm.UI.Infrastructure"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Views/ViewMap.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <inf:BoolToVisibility x:Key="Vis" />
            <inf:BoolToVisibility x:Key="VisInv" Invert="True" />
            <inf:InverseBool x:Key="Not" />
            <inf:BytesConverter x:Key="Bytes" />
            <inf:LevelBrush x:Key="LevelBrush" />
            <inf:ScoreBrush x:Key="ScoreBrush" />
            <inf:PtText x:Key="Pt" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
