<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Rbm.UI.Controls"
                    xmlns:vm="clr-namespace:Rbm.UI.ViewModels"
                    xmlns:hw="clr-namespace:Rbm.UI.Pages.Hardware">
    <!-- Recursos compartilhados pelas páginas de hardware (Monitoramento, CPU, GPU, Memória, Armazenamento, Energia) -->

    <ItemsPanelTemplate x:Key="Hw.WrapPanel"><WrapPanel /></ItemsPanelTemplate>

    <DataTemplate x:Key="Hw.Legend" DataType="{x:Type hw:LegendItem}">
        <StackPanel Orientation="Horizontal" Margin="0,0,16,4" Background="Transparent" ToolTip="{Binding Tip}">
            <Border Width="12" Height="3" CornerRadius="1.5" Background="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Caption}" FontSize="11.5" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Value}" Style="{StaticResource T.Base}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="Hw.LegendList" TargetType="ItemsControl">
        <Setter Property="ItemsPanel" Value="{StaticResource Hw.WrapPanel}" />
        <Setter Property="ItemTemplate" Value="{StaticResource Hw.Legend}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,8,0,6" />
    </Style>

    <DataTemplate x:Key="Hw.InfoRow" DataType="{x:Type vm:InfoRow}">
        <Grid Margin="0,5" Background="Transparent" ToolTip="{Binding Hint}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Muted}" FontSize="12" VerticalAlignment="Top" Margin="0,1,10,0" TextWrapping="Wrap" TextTrimming="None" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Value}" Style="{StaticResource T.H3}" TextWrapping="Wrap" TextTrimming="None" />
                <TextBlock Text="{Binding Hint}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" TextTrimming="None"
                           Visibility="{Binding Hint, Converter={StaticResource Vis}}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Métrica compacta: rótulo + valor -->
    <Style x:Key="Hw.Stat" TargetType="Border" BasedOn="{StaticResource CardInner}">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <!-- Nota explicativa -->
    <Style x:Key="Hw.Note" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Surface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Info}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style x:Key="Hw.Warn" TargetType="Border" BasedOn="{StaticResource Hw.Note}">
        <Setter Property="BorderBrush" Value="{StaticResource B.Warning}" />
        <Setter Property="Background" Value="{StaticResource B.WarningSoft}" />
    </Style>

    <!-- DataGrids das páginas: rolagem do mouse vai para a página -->
    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="hw:HwBehaviors.BubbleWheel" Value="True" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <Style x:Key="Hw.SmallButton" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ===== Componentes de UX das páginas de hardware ===== -->
    <!-- Conteúdo do banner de resumo (Hero): chip de status + frase simples + detalhe -->
    <DataTemplate DataType="{x:Type hw:HeroState}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Style="{StaticResource Chip}" Background="{Binding ChipBackground}" ToolTip="{Binding ChipTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ChipGlyph}" Style="{StaticResource T.Icon}" FontSize="11" Foreground="{Binding ChipForeground}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ChipText}" Foreground="{Binding ChipForeground}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Context}" Style="{StaticResource T.Muted}" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Headline}" Style="{StaticResource T.H1}" FontSize="20" TextWrapping="Wrap" TextTrimming="None" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Lead}" Margin="0,4,0,0" Visibility="{Binding Detail, Converter={StaticResource Vis}}" />
        </StackPanel>
    </DataTemplate>

    <!-- Métrica em destaque: rótulo, valor grande e o que ele significa -->
    <DataTemplate DataType="{x:Type hw:Fact}">
        <Border Style="{StaticResource Card}" Padding="16,14" ToolTip="{Binding Tip}">
            <StackPanel>
                <TextBlock Text="{Binding Label}" Style="{StaticResource T.Muted}" FontSize="12.5" />
                <TextBlock Text="{Binding Value}" Style="{StaticResource T.Metric}" FontSize="22" Margin="0,4,0,4" />
                <DockPanel>
                    <Ellipse Width="7" Height="7" Fill="{Binding NoteBrush}" Margin="0,0,7,0" VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding Note}" Foreground="{Binding NoteBrush}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="None" />
                </DockPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Linha de informação compacta (sem legenda abaixo; explicação no tooltip) -->
    <DataTemplate x:Key="Hw.InfoRowCompact" DataType="{x:Type vm:InfoRow}">
        <Grid Margin="0,4" Background="Transparent" ToolTip="{Binding Hint}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Muted}" FontSize="12.5" Margin="0,0,10,0" TextWrapping="Wrap" TextTrimming="None" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource T.H3}" TextWrapping="Wrap" TextTrimming="None" />
        </Grid>
    </DataTemplate>

    <!-- Botão de ação do banner -->
    <Style x:Key="Hw.HeroButton" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style x:Key="Hw.HeroPrimary" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <!-- Painel de sensor: valor atual + gráfico, ou motivo da indisponibilidade -->
    <DataTemplate DataType="{x:Type hw:SensorPanel}">
        <Border Style="{StaticResource CardInner}" Margin="0,0,10,10" ToolTip="{Binding Tip}">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Style="{StaticResource T.H3}" FontSize="15" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.Overline}" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Legend}" Style="{StaticResource Hw.LegendList}" Margin="0,6,0,2" />
                <c:LineChart Height="96" Series="{Binding Series}" Maximum="{Binding Maximum}" LabelFormat="{Binding LabelFormat}" Visibility="{Binding Available, Converter={StaticResource Vis}}" />
                <TextBlock Text="Sem leitura deste sensor." Style="{StaticResource T.WrapMuted}" FontSize="12" Margin="0,4,0,0" ToolTip="{Binding Reason}"
                           Visibility="{Binding Available, Converter={StaticResource VisInv}}" />
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
