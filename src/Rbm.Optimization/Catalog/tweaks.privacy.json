    {
      "id": "privacy.telemetry.level",
      "name": { "pt": "Nível de dados de diagnóstico (telemetria)", "en": "Diagnostic data level" },
      "category": "Privacidade",
      "subcategory": "Telemetria",
      "technicalDescription": "Política AllowTelemetry (DWORD) em HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection: 0 = Segurança (somente Enterprise/Education/Server; em Home/Pro é tratado como 1), 1 = Obrigatório/Básico, 3 = Opcional/Completo. Ausente = escolha do usuário em Configurações.",
      "plainExplanation": "Limita a quantidade de dados de uso e diagnóstico que o Windows envia à Microsoft ao mínimo permitido pela sua edição. Não é otimização de desempenho.",
      "evidence": "Política documentada pela Microsoft. O nível 'Segurança' só existe no Enterprise/Education; em Home/Pro o mínimo efetivo é 'Obrigatório'. Efeito de privacidade documentado; efeito de desempenho não demonstrado.",
      "references": [
        "https://learn.microsoft.com/en-us/windows/privacy/manage-connections-from-windows-operating-system-components-to-microsoft-services",
        "https://stigaview.com/products/win11/v2r7/WN11-CC-000205"
      ],
      "grade": "A",
      "confidence": "High",
      "risk": "Low",
      "impact": "Negligible",
      "sideEffects": "Recursos que dependem de dados opcionais (algumas recomendações, Windows Insider, parte do diagnóstico de problemas) ficam indisponíveis; a página de Configurações mostra 'algumas configurações são gerenciadas pela organização'.",
      "restart": "None",
      "dependsOn": [],
      "conflictsWith": [],
      "compatibility": { "minBuild": 10240, "notes": "Windows 11 não usa mais o nível 'Avançado' (2)." },
      "options": [
        {
          "key": "default",
          "label": "Não configurado (escolha do usuário)",
          "targets": [ { "type": "registry", "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "kind": "DWord", "value": null } ]
        },
        {
          "key": "required",
          "label": "Obrigatório / Básico (1)",
          "targets": [ { "type": "registry", "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "kind": "DWord", "value": "1" } ]
        },
        {
          "key": "security",
          "label": "Segurança (0) — somente Enterprise/Education",
          "notes": "Em Home/Pro o Windows trata 0 como 1.",
          "targets": [ { "type": "registry", "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "kind": "DWord", "value": "0" } ]
        }
      ],
      "defaultOption": "default",
      "recommendedOption": "required",
      "experimental": false,
      "privacy": true,
      "tags": ["privacy", "telemetry", "policy"],
      "benchmarkProcedure": "Verificar em Configurações > Privacidade > Diagnóstico e comentários e com o Visualizador de Dados de Diagnóstico.",
      "origin": "Política de grupo oficial."
    },
